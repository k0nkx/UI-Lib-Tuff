    local function boxSolve(hrp)
        if not hrp then
            return nil
        end
        local cam = Workspace.CurrentCamera
        local up, pos = hrp.CFrame.UpVector, hrp.Position
        local topWorld = pos + (up * 1.8) + cam.CFrame.UpVector
        local bottomWorld = pos - (up * 2.5) - cam.CFrame.UpVector
        local distance = (pos - cam.CFrame.Position).Magnitude
        local shownDistance = math.floor(distance)
        local top, topOnScreen = cam:WorldToViewportPoint(topWorld)
        local bottom, bottomOnScreen = cam:WorldToViewportPoint(bottomWorld)
        if not topOnScreen and not bottomOnScreen then
            return nil
        end
        local topV, bottomV = Vector2.new(top.X, top.Y), Vector2.new(bottom.X, bottom.Y)
        local width = math.max(math.floor(math.abs(topV.X - bottomV.X)), 9)
        local height = math.max(math.floor(math.max(math.abs(bottomV.Y - topV.Y), width / 2)), 12)
        local boxSize = Vector2.new(math.floor(math.max(height / 1.5, width)), height)
        local boxPos = Vector2.new(
            math.floor(topV.X * 0.5 + bottomV.X * 0.5 - boxSize.X * 0.5),
            math.floor(math.min(topV.Y, bottomV.Y))
        )
        return boxSize, boxPos, shownDistance
    end

