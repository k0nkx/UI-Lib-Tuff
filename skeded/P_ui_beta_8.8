    local defaultEspFont = Font.fromEnum(Enum.Font.Code)

    pcall(function()
        if Preview and Preview.Items and Preview.Items.Name and Preview.Items.Name.Instance then
            defaultEspFont = Preview.Items.Name.Instance.FontFace
        end
    end)
    if defaultEspFont == Font.fromEnum(Enum.Font.Code) then
        pcall(function()
            local base = Library.Directory or "Atlanta"
            local dir = base .. "/Fonts"
            if not isfolder(base) then makefolder(base) end
            if not isfolder(dir) then makefolder(dir) end
            local id = "ProggyClean"
            if not isfile(dir .. "/" .. id) then
                writefile(dir .. "/" .. id, game:HttpGet("https://github.com/i77lhm/storage/raw/refs/heads/main/fonts/ProggyClean.ttf"))
            end
            local fontJson = {
