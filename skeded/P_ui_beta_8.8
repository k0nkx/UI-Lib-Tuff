local SkillCheckState = nil
local SkillCheckSettings = { enabled = false, mode = "perfect", legit = false }

local function normalizeAngle(angle)
    angle = angle % 360
    if angle < 0 then
        angle += 360
    end
    return angle
end

local function pressSpace()
    local mode = SkillCheckSettings.mode
    if mode == "both" then
        mode = (math.random(1, 2) == 1) and "perfect" or "normal"
    end
    if SkillCheckSettings.legit then
        if mode == "normal" then
            task.wait(math.random(12, 20) / 100)
        elseif mode == "perfect" then
            task.wait(math.random(0, 24) / 1000)
        end
    elseif mode == "normal" then
        task.wait(0.045)
    end
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
end

local function stopSkillCheck()
    if SkillCheckState then
        SkillCheckState.running = false
        SkillCheckState = nil
    end
end

local function initializeSkillCheck()
    stopSkillCheck()
    task.wait(0.05)
    local state = { running = true }
    SkillCheckState = state
    task.spawn(function()
        local lastCheckId = nil
        while state.running do
            if not SkillCheckSettings.enabled then
                task.wait(0.15)
                continue
            end
            local prompt = PlayerGui:FindFirstChild("SkillCheckPromptGui")
            if not prompt then
                lastCheckId = nil
                task.wait(0.05)
                continue
            end
            local check = prompt:FindFirstChild("Check")
            local line = check and check:FindFirstChild("Line")
            if not line then
                task.wait()
                continue
            end
            if lastCheckId ~= prompt then
                lastCheckId = prompt
            end
            local rotation = normalizeAngle(line.Rotation)
            for _, goal in ipairs(check:GetChildren()) do
                if goal.Name == "Goal" or string.sub(goal.Name, 1, 4) == "Goal" then
                    local goalRotation = normalizeAngle(goal.Rotation)
                    local targetAngle = normalizeAngle(goalRotation + 109)
                    local angleDiff = (rotation - targetAngle + 180) % 360 - 180
                    if math.abs(angleDiff) <= 5 and lastCheckId == prompt then
                        lastCheckId = nil
                        task.spawn(pressSpace)
                        break
                    end
                end
            end
            task.wait()
        end
    end)
    return state
end

local function toggleSkillCheck(value)
    SkillCheckSettings.enabled = value
    if value then
        if not SkillCheckState then
            initializeSkillCheck()
        end
        Library:Notify({ Text = "Auto Skill Solver enabled", Lifetime = 3 })
    else
        stopSkillCheck()
        Library:Notify({ Text = "Auto Skill Solver disabled", Lifetime = 3 })
    end
end

