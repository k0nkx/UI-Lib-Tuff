    end
    if not parryReadyBar or not parryReadyBar.Parent then
        local pg = plr:FindFirstChild("PlayerGui")
        parryReadyBar = pg and pg:FindFirstChild("UIGradient", true) or nil
    end
    return parryReadyBar and parryReadyBar.Offset and parryReadyBar.Offset.Y == 0.25
end

local function isDoingGen()
    local char = plr.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        return false
    end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        local anim = track.Animation
        if anim and GenAnimIds[anim.AnimationId] then
            return true
        end
    end
    return false
end

local generatorPoints, generatorPointSet = {}, {}
local function cacheGeneratorPoint(obj)
    if obj:IsA("BasePart") and string.sub(obj.Name, 1, 14) == "GeneratorPoint" and not generatorPointSet[obj] then
        generatorPointSet[obj] = true
        table.insert(generatorPoints, obj)
    end
end
local function uncacheGeneratorPoint(obj)
    if not generatorPointSet[obj] then
        return
    end
    generatorPointSet[obj] = nil
    for i = #generatorPoints, 1, -1 do
        if generatorPoints[i] == obj then
            table.remove(generatorPoints, i)
            break
        end
    end
end
local function refreshGeneratorPointCache()
    table.clear(generatorPoints)
    table.clear(generatorPointSet)
    local map = Workspace:FindFirstChild("Map")
    if not map then
        return
    end
    for _, obj in ipairs(map:GetDescendants()) do
        cacheGeneratorPoint(obj)
    end
end
refreshGeneratorPointCache()
TrackConnection(Workspace.DescendantAdded:Connect(cacheGeneratorPoint))
TrackConnection(Workspace.DescendantRemoving:Connect(uncacheGeneratorPoint))

local function stopGen()
    local myHRP = getHRP(plr.Character)
    if not myHRP then
        return
    end
    local closest, closestDist = nil, math.huge
    for i = #generatorPoints, 1, -1 do
        local obj = generatorPoints[i]
        if not obj or not obj.Parent then
            uncacheGeneratorPoint(obj)
        else
            local dist = (obj.Position - myHRP.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = obj
            end
        end
    end
    if closest then
        DebugNotify("Stopping gen: " .. closest.Name)
        RepairEvent:FireServer(closest, false)
    end
end

local function Parry()
    if not ParrySettings.enabled or (plr.Team and plr.Team.Name == "Killer") or isOnCooldown then
        return false
    end
    if isDoingGen() then
        stopGen()
        task.wait(0.05)
    end
    if not ParrySettings.ignoreParryReady and not isParryReady() then
        DebugNotify("Parry not ready")
        return false
    end
    isOnCooldown = true
    task.delay(2, function()
        isOnCooldown = false
    end)
    if ParrySettings.method == "Method 1" then
        if ParryRemote then
            ParryRemote:FireServer()
        end
        VirtualInputManager:SendMouseButtonEvent(0, 0, 1, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 1, false, game, 0)
    else
        VirtualInputManager:SendMouseButtonEvent(0, 0, 1, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 1, false, game, 0)
        local daggerRemote = DaggerParryRemote
        if not daggerRemote then
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local items = remotes and remotes:FindFirstChild("Items")
            local dagger = items and items:FindFirstChild("Parrying Dagger")
            daggerRemote = dagger and dagger:FindFirstChild("parry")
        end
        if daggerRemote then
            daggerRemote:FireServer()
        else
            DebugNotify("Method 2 Remote Not Found!")
        end
    end
    Library:Notify({ Text = "PARRY FIRED! (" .. ParrySettings.method .. ")", Lifetime = 1.5 })
    return true
end

local function cleanupPlayer(player)
    local conns = _G.ParryPlayerConnections[player]
    if not conns then
        return
    end
    for _, conn in ipairs(conns.char) do
        untrackConnection(conn)
    end
    untrackConnection(conns.charAdded)
    _G.ParryPlayerConnections[player] = nil
end

local function onKillerAnimPlayed(targetPlayer, track)
    if not ParrySettings.enabled or isOnCooldown then
        return
    end
    local anim = track.Animation
    if not anim then
        return
    end
    local data = AnimMap[anim.AnimationId]
    if not (data and data.Parry) then
        return
    end
    local refPos = getReferencePos()
    local targetHRP = getHRP(targetPlayer.Character)
    if refPos and targetHRP and (targetHRP.Position - refPos).Magnitude <= ParrySettings.radius then
        DebugNotify("Parry: " .. data.Name)
        Parry()
    end
end

local function listenToKiller(player)
    cleanupPlayer(player)
    local conns = { char = {}, charAdded = nil }
    local function setupChar(char)
        for _, conn in ipairs(conns.char) do
            untrackConnection(conn)
        end
        conns.char = {}
        if not char then
            return
        end
        local humanoid = char:WaitForChild("Humanoid", 5)
        local animator = humanoid and humanoid:WaitForChild("Animator", 5)
        if animator then
            local conn = animator.AnimationPlayed:Connect(function(track)
                onKillerAnimPlayed(player, track)
            end)
            table.insert(conns.char, conn)
            table.insert(_G.ParryConnections, conn)
        end
    end
    if player.Character then
        setupChar(player.Character)
    end
    conns.charAdded = player.CharacterAdded:Connect(setupChar)
    table.insert(_G.ParryConnections, conns.charAdded)
    _G.ParryPlayerConnections[player] = conns
end

for _, p in ipairs(Players:GetPlayers()) do
