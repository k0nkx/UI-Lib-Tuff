local function collectAttributeNames()
    local attrs = {}
    local function addFrom(inst)
        if not inst then return end
        local ok, map = pcall(function() return inst:GetAttributes() end)
        if ok and type(map) == "table" then
            for name in pairs(map) do
                if type(name) == "string" and name ~= "" then
                    attrs[name] = true
                end
            end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        addFrom(p)
        if p.Character then
            addFrom(p.Character)
        end
    end
    local function findPlayerMode()
        for _, name in ipairs({ "PlayerMode", "Playermode", "playerMode", "PlayerModes", "Player Mode" }) do
            local obj = Workspace:FindFirstChild(name)
            if obj then return obj end
        end
        return Workspace:FindFirstChild("PlayerMode", true)
    end
    local pm = findPlayerMode()
    if pm then
        addFrom(pm)
        for _, desc in ipairs(pm:GetDescendants()) do
            if desc:IsA("Model") or desc:IsA("BasePart") or desc:IsA("Folder") or desc:IsA("Configuration") then
                addFrom(desc)
            end
        end
    end
    local list = {}
    for name in pairs(attrs) do
        table.insert(list, name)
    end
    table.sort(list)
    if #list == 0 then
        table.insert(list, "(none found)")
    end
    return list
end
