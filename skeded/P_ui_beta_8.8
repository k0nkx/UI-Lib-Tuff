    -- Cached flag attribute values (updated via GetAttributeChangedSignal)
    -- Supports multi-select: attrNames is a sorted list of attribute names
    local flagAttrCache = {} -- [player] = { key, attrNames, value, conns = {}, character }

    local function clearFlagAttrCache(player)
        local cache = flagAttrCache[player]
        if not cache then
            return
        end
        if cache.conns then
            for _, conn in ipairs(cache.conns) do
                pcall(function()
                    if conn.Connected then
                        conn:Disconnect()
                    end
                end)
            end
        end
        flagAttrCache[player] = nil
    end

    local function normalizeAttrSelection(raw)
        local list = {}
        if type(raw) == "table" then
            if raw[1] ~= nil then
                for _, v in ipairs(raw) do
                    if type(v) == "string" and v ~= "" and not string.find(v, "none found", 1, true) then
                        table.insert(list, v)
                    end
                end
            else
                for k, v in pairs(raw) do
                    if v and type(k) == "string" and k ~= "" and not string.find(k, "none found", 1, true) then
                        table.insert(list, k)
                    end
                end
                table.sort(list)
            end
        elseif type(raw) == "string" and raw ~= "" and not string.find(raw, "none found", 1, true) then
            table.insert(list, raw)
        end
        return list
    end

    local function readAttributeValue(player, character, attrName)
        local value = player:GetAttribute(attrName)
        if value == nil and character then
            value = character:GetAttribute(attrName)
        end
        if value == nil then
            local pm = Workspace:FindFirstChild("PlayerMode")
                or Workspace:FindFirstChild("Playermode")
                or Workspace:FindFirstChild("playerMode")
            if pm then
                value = pm:GetAttribute(attrName)
                if value == nil then
                    for _, desc in ipairs(pm:GetDescendants()) do
                        value = desc:GetAttribute(attrName)
                        if value ~= nil then
                            break
                        end
                    end
                end
            end
        end
        return value ~= nil and tostring(value) or ""
    end

    local function formatAttrList(player, character, attrNames)
        local lines = {}
        for _, attrName in ipairs(attrNames) do
            local value = readAttributeValue(player, character, attrName)
            if value ~= "" then
                table.insert(lines, value)
            end
        end
        return table.concat(lines, "\n")
    end

    local function ensureFlagAttrCache(player, character, attrNames)
        local key = table.concat(attrNames, "\0")
        local cache = flagAttrCache[player]
        if cache and cache.key == key and cache.character == character then
            return cache.value
        end
        clearFlagAttrCache(player)

        local value = formatAttrList(player, character, attrNames)
        local conns = {}
        local function refresh()
            local c = flagAttrCache[player]
            if c and c.key == key then
                c.value = formatAttrList(player, player.Character, attrNames)
            end
        end

        for _, attrName in ipairs(attrNames) do
            table.insert(conns, player:GetAttributeChangedSignal(attrName):Connect(refresh))
            if character then
                table.insert(conns, character:GetAttributeChangedSignal(attrName):Connect(refresh))
            end
        end
        table.insert(conns, player.CharacterAdded:Connect(function(newChar)
            local c = flagAttrCache[player]
            if not c or c.key ~= key then
                return
            end
            for _, attrName in ipairs(attrNames) do
                table.insert(c.conns, newChar:GetAttributeChangedSignal(attrName):Connect(refresh))
            end
            c.character = newChar
            c.value = formatAttrList(player, newChar, attrNames)
        end))

        flagAttrCache[player] = {
            key = key,
            attrNames = attrNames,
            value = value,
            conns = conns,
            character = character,
        }
        return value
    end

    local function normalizeFlagTypes(raw)
        local list = {}
        local seen = {}
        local function add(name)
            if type(name) == "string" and name ~= "" and not seen[name] then
                seen[name] = true
                table.insert(list, name)
            end
        end
        if type(raw) == "table" then
            if raw[1] ~= nil then
                for _, v in ipairs(raw) do
                    add(v)
                end
            else
                -- multi dropdown may store { Team = true, Velocity = true }
                for k, v in pairs(raw) do
                    if v then
                        add(k)
                    end
                end
            end
        elseif type(raw) == "string" then
            add(raw)
        end
        if #list == 0 then
            table.insert(list, "Team")
        end
        return list
    end

    local function getFlags(player, character)
        local types = normalizeFlagTypes(Library.Flags and Library.Flags["Flag Type"])
        local lines = {}

        for _, flagType in ipairs(types) do
            if flagType == "Team" then
                local teamName = player.Team and player.Team.Name or ""
                if teamName ~= "" then
                    table.insert(lines, teamName)
                end
            elseif flagType == "Velocity" then
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local vel = hrp.AssemblyLinearVelocity or hrp.Velocity
                    table.insert(lines, string.format("%.1f", vel.Magnitude))
                else
                    table.insert(lines, "0")
                end
            elseif flagType == "Attribute" then
                local attrNames = normalizeAttrSelection(Library.Flags and Library.Flags["Flag Attribute"])
                if #attrNames > 0 then
                    local attrText = ensureFlagAttrCache(player, character, attrNames)
                    if attrText and attrText ~= "" then
                        for line in string.gmatch(attrText, "[^\n]+") do
                            table.insert(lines, line)
                        end
                    end
                end
            end
        end

        return table.concat(lines, "\n")
    end

    local function destroyHighlight(data)
        if data and data.Highlight then
            pcall(function()
                data.Highlight:Destroy()
            end)
            data.Highlight = nil
        end
    end

    local function updateHighlight(player, data, character)
        if not FlagOn("Esp Enabled") or not FlagOn("Highlight") or not character then
            if data.Highlight then
                data.Highlight.Enabled = false
            end
            return
        end

        local hl = data.Highlight
        if not hl or not hl.Parent then
            hl = Instance.new("Highlight")
            hl.Name = "PeronaESP_Highlight"
            hl.Parent = holder
            data.Highlight = hl
        end

        hl.Adornee = character
        hl.Enabled = true

        local depth = Library.Flags and Library.Flags["Highlight Depth Mode"] or "AlwaysOnTop"
        if depth == "Occluded" then
            hl.DepthMode = Enum.HighlightDepthMode.Occluded
        else
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        end

        local fill = ColorFlag("Highlight Fill", Color3.fromRGB(255, 255, 255))
        local outline = ColorFlag("Highlight Outline", Color3.fromRGB(255, 255, 255))
        local fillT = Library.Flags and Library.Flags["Highlight Fill Transparency"]
        local outlineT = Library.Flags and Library.Flags["Highlight Outline Transparency"]
        if type(fillT) ~= "number" then fillT = 0.7 end
        if type(outlineT) ~= "number" then outlineT = 0 end

        hl.FillColor = fill.Color
        if FlagOn("Highlight Team Color") and player and player.Team and player.TeamColor then
            hl.OutlineColor = player.TeamColor.Color
        else
            hl.OutlineColor = outline.Color
        end
        hl.FillTransparency = math.clamp(fillT, 0, 1)
        hl.OutlineTransparency = math.clamp(outlineT, 0, 1)
    end

    local function removeESP(player)
        clearFlagAttrCache(player)
        local data = playerESP[player]
        if data then
            destroyHighlight(data)
            if data.Draw and data.Draw.Main then
                data.Draw.Main:Destroy()
            end
            playerESP[player] = nil
        end
    end

    local function addESP(player)
        if player == plr or playerESP[player] then
            return
        end
        local draw = createESPDrawing()
        applyEspFontsToDraw(draw)
        playerESP[player] = { Draw = draw, Player = player, Highlight = nil }
    end

    local function updatePlayer(player, data)
        local draw = data.Draw
        local character = player.Character
        if not character then
            draw.Main.Visible = false
            if data.Highlight then
                data.Highlight.Enabled = false
            end
            return
        end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not hrp or not humanoid or humanoid.Health <= 0 then
            draw.Main.Visible = false
            if data.Highlight then
                data.Highlight.Enabled = false
            end
            return
        end
        local size, pos, distance = boxSolve(hrp)
        if not size then
            draw.Main.Visible = false
            if data.Highlight then
                data.Highlight.Enabled = false
            end
            return
        end
        applyStyle(draw, player)
        applyVisibility(draw)
        applyEspFontsToDraw(draw)
        updateHighlight(player, data, character)
        draw.Main.Visible = true
        draw.Main.Position = UDim2.fromOffset(pos.X + size.X * 0.5, pos.Y)
        draw.Main.Size = UDim2.fromOffset(size.X, size.Y)
        draw.Name.Text = player.Name
        draw.Distance.Text = tostring(distance) .. "m"
        draw.Weapon.Text = getWeapon(character)
        draw.Flags.Text = getFlags(player, character)

        local maxHealth = math.max(humanoid.MaxHealth, 1)
        local ratio = math.clamp(humanoid.Health / maxHealth, 0, 1)
        local barRatio = math.max(ratio, 0.01)
        draw.HealthbarFade.Size = UDim2.new(1, -2, 1 - barRatio, 0)
        local textBoundsY = draw.HealthText.TextBounds.Y
        if textBoundsY < 1 then
            textBoundsY = draw.HealthText.TextSize
        end
        draw.HealthText.Size = UDim2.new(0, 0, 1 - ratio, textBoundsY - 3)
        draw.HealthText.Text = tostring(math.floor(humanoid.Health + 0.5))
        local highH = ColorFlag("High Health", Color3.fromRGB(0, 255, 0))
        local midH = ColorFlag("Mid Health", Color3.fromRGB(255, 165, 0))
        local lowH = ColorFlag("Low Health", Color3.fromRGB(255, 0, 0))
        draw.HealthText.TextColor3 = lowH.Color:Lerp(midH.Color, ratio):Lerp(highH.Color, ratio)
    end

    local function rebuildPlayerCharSet()
        table.clear(playerCharSet)
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                playerCharSet[p.Character] = true
            end
        end
    end

    local function belongsToPlayer(model)
        if not model then
            return false
        end
        -- Direct player character
        local ok, player = pcall(function()
            return Players:GetPlayerFromCharacter(model)
        end)
        if ok and player then
            return true
        end
        if playerCharSet[model] then
            return true
        end
        -- Nested under a player character (accessories, fake humanoids, etc.)
        local current = model.Parent
        while current and current ~= Workspace and current ~= game do
            if current:IsA("Model") then
                if playerCharSet[current] then
                    return true
                end
                local ok2, plr = pcall(function()
                    return Players:GetPlayerFromCharacter(current)
                end)
                if ok2 and plr then
                    return true
                end
            end
            current = current.Parent
        end
        return false
    end

    local function isNpcModel(model)
        if not model or not model:IsA("Model") or not model.Parent then
            return false
        end
        if belongsToPlayer(model) then
            return false
        end
        -- Only top-level-ish character models: must have Humanoid as direct child
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Parent ~= model then
            return false
        end
        if humanoid.Health <= 0 then
            return false
        end
        local hrp = model:FindFirstChild("HumanoidRootPart")
            or model:FindFirstChild("Torso")
            or model.PrimaryPart
        if not hrp or hrp.Parent ~= model then
            return false
        end
        return true
    end

    local function removeNPCESP(model)
        local data = npcESP[model]
        if data then
            destroyHighlight(data)
            if data.Draw and data.Draw.Main then
                data.Draw.Main:Destroy()
            end
            npcESP[model] = nil
        end
    end

    local function addNPCESP(model)
        if not model or npcESP[model] then
            return
        end
        if not isNpcModel(model) then
            return
        end
        local draw = createESPDrawing()
        applyEspFontsToDraw(draw)
        npcESP[model] = { Draw = draw, Model = model, Highlight = nil, IsNPC = true }
    end

    local function updateNPC(model, data)
        local draw = data.Draw
        if not FlagOn("Esp NPC") then
            draw.Main.Visible = false
            if data.Highlight then
                data.Highlight.Enabled = false
            end
            return
        end
        if not model or not model.Parent or belongsToPlayer(model) or not isNpcModel(model) then
            if model and belongsToPlayer(model) then
                -- was a false positive; drop it
                removeNPCESP(model)
                return
            end
            draw.Main.Visible = false
            if data.Highlight then
                data.Highlight.Enabled = false
            end
            return
        end
        local hrp = model:FindFirstChild("HumanoidRootPart")
            or model:FindFirstChild("Torso")
            or model.PrimaryPart
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if not hrp or not humanoid or humanoid.Health <= 0 then
            draw.Main.Visible = false
            if data.Highlight then
                data.Highlight.Enabled = false
            end
            return
        end
        local size, pos, distance = boxSolve(hrp)
        if not size then
            draw.Main.Visible = false
            if data.Highlight then
                data.Highlight.Enabled = false
            end
            return
        end
        applyNPCStyle(draw)
        applyVisibility(draw)
        applyEspFontsToDraw(draw)
        updateHighlight(nil, data, model)
        -- NPC highlight uses NPC box color (never team color)
        if data.Highlight and FlagOn("Highlight") then
            local boxCol = ColorFlag("NPC Box Color", Color3.fromRGB(255, 170, 0))
            data.Highlight.FillColor = boxCol.Color
            data.Highlight.OutlineColor = boxCol.Color
        end
        draw.Main.Visible = true
        draw.Main.Position = UDim2.fromOffset(pos.X + size.X * 0.5, pos.Y)
        draw.Main.Size = UDim2.fromOffset(size.X, size.Y)
        draw.Name.Text = model.Name
        draw.Distance.Text = tostring(distance) .. "m"
        draw.Weapon.Text = getWeapon(model)
        draw.Flags.Text = "NPC"

        local maxHealth = math.max(humanoid.MaxHealth, 1)
        local ratio = math.clamp(humanoid.Health / maxHealth, 0, 1)
        local barRatio = math.max(ratio, 0.01)
        draw.HealthbarFade.Size = UDim2.new(1, -2, 1 - barRatio, 0)
        local textBoundsY = draw.HealthText.TextBounds.Y
        if textBoundsY < 1 then
            textBoundsY = draw.HealthText.TextSize
        end
        draw.HealthText.Size = UDim2.new(0, 0, 1 - ratio, textBoundsY - 3)
        draw.HealthText.Text = tostring(math.floor(humanoid.Health + 0.5))
        local highH = ColorFlag("High Health", Color3.fromRGB(0, 255, 0))
        local midH = ColorFlag("Mid Health", Color3.fromRGB(255, 165, 0))
        local lowH = ColorFlag("Low Health", Color3.fromRGB(255, 0, 0))
        draw.HealthText.TextColor3 = lowH.Color:Lerp(midH.Color, ratio):Lerp(highH.Color, ratio)
    end

    local function scanNPCs()
        rebuildPlayerCharSet()
        local seen = {}
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and isNpcModel(obj) then
                seen[obj] = true
                if not npcESP[obj] then
                    addNPCESP(obj)
                end
            end
        end
        for model in pairs(npcESP) do
            if not seen[model] or not model.Parent then
                removeNPCESP(model)
            end
        end
    end

    local lastNpcScan = 0
    task.spawn(function()
        task.wait(0.5)
        if running then
            scanNPCs()
        end
    end)
    TrackConnection(Workspace.DescendantAdded:Connect(function(obj)
        if not running or not FlagOn("Esp Enabled") or not FlagOn("Esp NPC") then
            return
        end
        if obj:IsA("Model") then
            task.defer(function()
                rebuildPlayerCharSet()
                addNPCESP(obj)
            end)
        elseif obj:IsA("Humanoid") or obj.Name == "HumanoidRootPart" then
            local model = obj.Parent
            if model and model:IsA("Model") then
                task.defer(function()
                    rebuildPlayerCharSet()
                    addNPCESP(model)
                end)
            end
        end
    end))
    TrackConnection(Workspace.DescendantRemoving:Connect(function(obj)
        if npcESP[obj] then
            removeNPCESP(obj)
        end
    end))

    for _, player in ipairs(Players:GetPlayers()) do
        addESP(player)
    end
    TrackConnection(Players.PlayerAdded:Connect(addESP))
    TrackConnection(Players.PlayerRemoving:Connect(removeESP))

    local conn = RunService.RenderStepped:Connect(function()
        if not running then
            return
        end
        if not FlagOn("Esp Enabled") then
            for _, data in pairs(playerESP) do
                data.Draw.Main.Visible = false
                if data.Highlight then
                    data.Highlight.Enabled = false
                end
            end
            for _, data in pairs(npcESP) do
                data.Draw.Main.Visible = false
                if data.Highlight then
                    data.Highlight.Enabled = false
                end
            end
            return
        end
        for player, data in pairs(playerESP) do
            updatePlayer(player, data)
        end
        -- periodic NPC rescan (~1s)
        local now = os.clock()
        if FlagOn("Esp NPC") then
            if now - lastNpcScan > 1 then
                lastNpcScan = now
                scanNPCs()
            end
            for model, data in pairs(npcESP) do
                updateNPC(model, data)
            end
        else
            for _, data in pairs(npcESP) do
                data.Draw.Main.Visible = false
                if data.Highlight then
                    data.Highlight.Enabled = false
                end
            end
        end
    end)
    TrackConnection(conn)

    getgenv().CleanupPlayerESP = function()
        running = false
        if conn then
            conn:Disconnect()
        end
        for player in pairs(playerESP) do
            removeESP(player)
        end
        for model in pairs(npcESP) do
            removeNPCESP(model)
        end
        if holder then
            holder:Destroy()
        end
    end
end

do
    local IDENTIFIER = "GenZESP_V1"
    local GenEspSettings = {
        Enabled = false,
        CornerColor = Color3.fromRGB(255, 255, 255),
        StrokeColor = Color3.fromRGB(0, 0, 0),
        StrokeThickness = 0.6,
        CornerLengthScale = 5,
        ProgressBarHeight = 2,
        ProgressBarOffset = 3,
        PercentTextOffset = -3,
        PercentTextSize = 10,
        PercentFont = Enum.Font.Arcade,
        FinishedColor = Color3.fromRGB(255, 105, 180),
        AutoColor = false,
    }
    local activeESPs = {}
    local isRunning = true
    local renderConnection, workspaceConnection, workspaceRemovingConnection
    local existingESP = CoreGui:FindFirstChild(IDENTIFIER)
    if existingESP then
        existingESP:Destroy()
    end
    local holder = Instance.new("ScreenGui")
    holder.Name = IDENTIFIER
    holder.ResetOnSpawn = false
    holder.Parent = CoreGui
    local CornerOffsets = {
        Vector3.new(-1, -1, -1), Vector3.new(-1, -1, 1),
        Vector3.new(-1, 1, -1), Vector3.new(-1, 1, 1),
        Vector3.new(1, -1, -1), Vector3.new(1, -1, 1),
        Vector3.new(1, 1, -1), Vector3.new(1, 1, 1),
    }

    local function findProgressSource(generator)
        for _, attr in ipairs({ "RepairProgress", "Progress", "repairprogress", "progress" }) do
            if generator:GetAttribute(attr) ~= nil then
                return { Type = "Attribute", Name = attr }
            end
        end
        for _, v in ipairs(generator:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                local n = string.lower(v.Name)
                if string.find(n, "repair", 1, true) or string.find(n, "progress", 1, true) then
                    return { Type = "ValueObject", Object = v }
                end
            end
        end
        return nil
    end

    local function getGeneratorProgress(model, cachedSource)
        if cachedSource then
            if cachedSource.Type == "Attribute" then
                return model:GetAttribute(cachedSource.Name) or 0
            elseif cachedSource.Type == "ValueObject" and cachedSource.Object.Parent then
                return cachedSource.Object.Value or 0
            end
        end
        return model:GetAttribute("RepairProgress") or model:GetAttribute("Progress") or 0
    end

    local function getProgressColor(progress)
        if progress >= 1 then
            return GenEspSettings.FinishedColor
        end
        if GenEspSettings.AutoColor then
            return Color3.fromRGB(math.floor((1 - progress) * 255), math.floor(progress * 255), 0)
        end
        return GenEspSettings.CornerColor
    end

    local function cleanupSingleESP(model)
        local data = activeESPs[model]
        if data then
            if data.folder then
                data.folder:Destroy()
            end
            activeESPs[model] = nil
        end
    end

    local function cleanupAll()
        isRunning = false
        if renderConnection then
            renderConnection:Disconnect()
            renderConnection = nil
        end
        if workspaceConnection then
            workspaceConnection:Disconnect()
            workspaceConnection = nil
        end
        if workspaceRemovingConnection then
            workspaceRemovingConnection:Disconnect()
            workspaceRemovingConnection = nil
        end
        for model in pairs(activeESPs) do
            cleanupSingleESP(model)
        end
        if holder and holder.Parent then
            holder:Destroy()
        end
    end
    getgenv().CleanupESP = cleanupAll

    local function createCornerESP(model, body)
        if activeESPs[model] or not body then
            return
        end
        local folder = Instance.new("Folder")
        folder.Name = "ESP_" .. model.Name
        folder.Parent = holder
        local corners = table.create(8)
        for i = 1, 8 do
            local frame = Instance.new("Frame")
            frame.BorderSizePixel = 0
            frame.Visible = false
            frame.Parent = folder
            local stroke = Instance.new("UIStroke")
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.LineJoinMode = Enum.LineJoinMode.Miter
            stroke.Parent = frame
            corners[i] = frame
        end
        local progressBar = Instance.new("Frame")
        progressBar.BorderSizePixel = 0
        progressBar.Visible = false
        progressBar.Parent = folder
        local pbStroke = Instance.new("UIStroke")
        pbStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        pbStroke.LineJoinMode = Enum.LineJoinMode.Miter
        pbStroke.Parent = progressBar
        local percentLabel = Instance.new("TextLabel")
        percentLabel.BackgroundTransparency = 1
        percentLabel.Text = "0%"
        percentLabel.Size = UDim2.new(0, 60, 0, 14)
        percentLabel.AnchorPoint = Vector2.new(0.5, 0)
        percentLabel.TextStrokeTransparency = 0
        percentLabel.Visible = false
        percentLabel.Parent = folder
        activeESPs[model] = {
            folder = folder, body = body, corners = corners,
            progressBar = progressBar, pbStroke = pbStroke, percentLabel = percentLabel,
            progressSource = findProgressSource(model),
        }
    end

    local function setESPVisibility(data, visible)
        for i = 1, 8 do
            data.corners[i].Visible = visible
        end
        data.progressBar.Visible = visible
        data.percentLabel.Visible = visible
    end

    local function updateGeneratorESP(model, data)
        if not isRunning or not model.Parent or not data.body or not data.body.Parent then
            cleanupSingleESP(model)
            return
        end
        if not GenEspSettings.Enabled then
            setESPVisibility(data, false)
            return
        end
        local cam = Workspace.CurrentCamera
        local cf, hs = data.body.CFrame, data.body.Size * 0.5
        local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
        local visibleCount = 0
        for i = 1, 8 do
            local worldPos = cf.Position + cf:VectorToWorldSpace(CornerOffsets[i] * hs)
            local screenPos, visible = cam:WorldToScreenPoint(worldPos)
            if visible then
                visibleCount += 1
                minX = math.min(minX, screenPos.X)
                minY = math.min(minY, screenPos.Y)
                maxX = math.max(maxX, screenPos.X)
                maxY = math.max(maxY, screenPos.Y)
            end
        end
        if visibleCount == 0 then
            setESPVisibility(data, false)
            return
        end
        local width, height = maxX - minX, maxY - minY
        local cornerW = width / GenEspSettings.CornerLengthScale
        local cornerH = height / GenEspSettings.CornerLengthScale
        local corners = data.corners
        local color, strokeColor, strokeThickness =
            GenEspSettings.CornerColor, GenEspSettings.StrokeColor, GenEspSettings.StrokeThickness
        corners[1].Position = UDim2.fromOffset(minX, minY)
        corners[1].Size = UDim2.fromOffset(cornerW, 1)
        corners[2].Position = UDim2.fromOffset(minX, minY)
        corners[2].Size = UDim2.fromOffset(1, cornerH)
        corners[3].Position = UDim2.fromOffset(maxX - cornerW, minY)
        corners[3].Size = UDim2.fromOffset(cornerW, 1)
        corners[4].Position = UDim2.fromOffset(maxX - 1, minY)
        corners[4].Size = UDim2.fromOffset(1, cornerH)
        corners[5].Position = UDim2.fromOffset(minX, maxY - 1)
        corners[5].Size = UDim2.fromOffset(cornerW, 1)
        corners[6].Position = UDim2.fromOffset(minX, maxY - cornerH)
        corners[6].Size = UDim2.fromOffset(1, cornerH)
        corners[7].Position = UDim2.fromOffset(maxX - cornerW, maxY - 1)
        corners[7].Size = UDim2.fromOffset(cornerW, 1)
        corners[8].Position = UDim2.fromOffset(maxX - 1, maxY - cornerH)
        corners[8].Size = UDim2.fromOffset(1, cornerH)
        for i = 1, 8 do
            local frame = corners[i]
            frame.BackgroundColor3 = color
            local stroke = frame:FindFirstChildOfClass("UIStroke")
            if stroke then
                stroke.Color = strokeColor
                stroke.Thickness = strokeThickness
            end
            frame.Visible = true
        end
        local rawProgress = getGeneratorProgress(model, data.progressSource)
        local progress = math.clamp(rawProgress > 1 and rawProgress / 100 or rawProgress, 0, 1)
        data.progressBar.Position = UDim2.fromOffset(minX, maxY + GenEspSettings.ProgressBarOffset)
        data.progressBar.Size = UDim2.fromOffset(width * progress, GenEspSettings.ProgressBarHeight)
        data.progressBar.BackgroundColor3 = getProgressColor(progress)
        data.pbStroke.Color = strokeColor
        data.pbStroke.Thickness = strokeThickness
        data.progressBar.Visible = true
        data.percentLabel.Text = math.floor(progress * 100) .. "%"
        data.percentLabel.TextColor3 = color
        data.percentLabel.TextSize = GenEspSettings.PercentTextSize
        data.percentLabel.Font = GenEspSettings.PercentFont
        data.percentLabel.TextStrokeColor3 = strokeColor
        data.percentLabel.Position = UDim2.fromOffset(
            minX + width * 0.5,
            maxY + GenEspSettings.ProgressBarOffset + GenEspSettings.ProgressBarHeight + GenEspSettings.PercentTextOffset
        )
        data.percentLabel.Visible = true
    end

    renderConnection = RunService.RenderStepped:Connect(function()
        if not GenEspSettings.Enabled then
            for _, data in pairs(activeESPs) do
                setESPVisibility(data, false)
            end
            return
        end
        for model, data in pairs(activeESPs) do
            updateGeneratorESP(model, data)
        end
    end)
    TrackConnection(renderConnection)

    local function registerGenerator(obj)
        if obj:IsA("Model") and obj.Name == "Generator" then
            task.spawn(function()
                local body = obj:FindFirstChild("GeneratorBody") or obj:WaitForChild("GeneratorBody", 5)
                if body and isRunning then
                    createCornerESP(obj, body)
                end
            end)
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        registerGenerator(obj)
    end
    workspaceConnection = Workspace.DescendantAdded:Connect(registerGenerator)
    workspaceRemovingConnection = Workspace.DescendantRemoving:Connect(function(obj)
        if activeESPs[obj] then
            cleanupSingleESP(obj)
        end
    end)
    TrackConnection(workspaceConnection)
    TrackConnection(workspaceRemovingConnection)

    local ESPSection = RenderTab:AddSection({ Title = "Generator ESP", Side = 2 })
    ESPSection:AddToggle({
        Text = "Generator ESP", Default = false, Flag = "ESP_Enabled",
        Callback = function(v) GenEspSettings.Enabled = v end,
    })
    ESPSection:AddColorPicker({
        Text = "Corner Color", Default = GenEspSettings.CornerColor, Flag = "ESP_CornerColor",
        Callback = function(c) GenEspSettings.CornerColor = c end,
    })
    ESPSection:AddColorPicker({
        Text = "Stroke Color", Default = GenEspSettings.StrokeColor, Flag = "ESP_StrokeColor",
        Callback = function(c) GenEspSettings.StrokeColor = c end,
    })
    ESPSection:AddColorPicker({
        Text = "Finished Color", Default = GenEspSettings.FinishedColor, Flag = "ESP_FinishedColor",
        Callback = function(c) GenEspSettings.FinishedColor = c end,
    })
