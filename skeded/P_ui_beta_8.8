do
    local ServerPosSettings = {
        VisualizerColor = Color3.fromRGB(255, 255, 255),
        Transparency = 0.5,
        MaxPing = 300,
        HistoryDuration = 2,
        HighPingThreshold = 160,
        HighPingReduction = 0.9,
        Material = Enum.Material.ForceField,
        Enabled = false,
        VisualizeHead = false,
        VisualizeHRP = false,
        DecalHead = false,
        ToggleKey = Enum.KeyCode.End,
    }
    local R6Parts = {
        "Head", "Torso", "HumanoidRootPart",
        "Left Arm", "Right Arm", "Left Leg", "Right Leg",
    }
    for _, v in ipairs(Workspace.CurrentCamera:GetChildren()) do
        if string.sub(v.Name, 1, 11) == "Visualizer_" then
            v:Destroy()
        end
    end
    local character = plr.Character
    local VisualizerParts = {}
    local positionHistory = {}
    local ServerPosToggle

    local function hardenPart(part)
        if not part then
            return
        end
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.Anchored = true
        part.CastShadow = false
        part.Massless = true
    end

    local function getPing()
        if not ServerPosSettings.Enabled then
            return 0
        end
        local networkPing = plr:GetNetworkPing() * 1000
        local dataPing = 0
        local item = Stats.Network.ServerStatsItem:FindFirstChild("Data Ping")
        if item then
            local ok, v = pcall(function()
                return item:GetValueString()
            end)
            if ok and v then
                dataPing = tonumber(string.match(v, "%d+")) or 0
            end
        end
        local totalPing = networkPing + dataPing
        if totalPing > ServerPosSettings.HighPingThreshold then
            networkPing *= ServerPosSettings.HighPingReduction
            totalPing = networkPing + dataPing
        end
        return math.min(totalPing, ServerPosSettings.MaxPing)
    end

    local function cloneBodyParts()
        if not ServerPosSettings.Enabled or not character then
            return
        end
        for _, part in pairs(VisualizerParts) do
            if part and part.Parent then
                part:Destroy()
            end
        end
        table.clear(VisualizerParts)
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") and table.find(R6Parts, part.Name) then
                if part.Name == "Head" and not ServerPosSettings.VisualizeHead then
                    continue
                end
                if part.Name == "HumanoidRootPart" and not ServerPosSettings.VisualizeHRP then
                    continue
                end
                local existing = Workspace.CurrentCamera:FindFirstChild("Visualizer_" .. part.Name)
                if existing then
                    existing:Destroy()
                end
                local clone = part:Clone()
                clone.Name = "Visualizer_" .. part.Name
                clone.Parent = Workspace.CurrentCamera
                clone.Material = ServerPosSettings.Material
                clone.Color = ServerPosSettings.VisualizerColor
                clone.Transparency = ServerPosSettings.Transparency
                hardenPart(clone)
                for _, child in ipairs(clone:GetChildren()) do
                    child:Destroy()
                end
                if part.Name == "Head" and ServerPosSettings.DecalHead then
                    for _, child in ipairs(part:GetChildren()) do
                        if child:IsA("Decal") or child:IsA("Texture") or child:IsA("SpecialMesh") then
                            child:Clone().Parent = clone
                        end
                    end
                end
                VisualizerParts[part.Name] = clone
            end
        end
    end

    local function destroyVisualizerParts()
        for _, part in pairs(VisualizerParts) do
            if part and part.Parent then
                part:Destroy()
            end
        end
        table.clear(VisualizerParts)
    end

    local function updateVisualizer()
        if not ServerPosSettings.Enabled or not character then
            return
        end
        local ping = getPing()
        local currentTime = tick()
        local snapshot = {}
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") and table.find(R6Parts, part.Name) then
                if part.Name == "Head" and not ServerPosSettings.VisualizeHead then
                    continue
                end
                if part.Name == "HumanoidRootPart" and not ServerPosSettings.VisualizeHRP then
                    continue
                end
                snapshot[part.Name] = { CFrame = part.CFrame }
            end
        end
        positionHistory[currentTime] = snapshot
        for time in pairs(positionHistory) do
            if currentTime - time > ServerPosSettings.HistoryDuration then
                positionHistory[time] = nil
            end
        end
        local backtrackTime = currentTime - (ping / 1000)
        local targetPositions, closestDiff = {}, math.huge
        for time, positions in pairs(positionHistory) do
            local diff = math.abs(time - backtrackTime)
            if diff < closestDiff then
                closestDiff = diff
                targetPositions = positions
            end
        end
        for partName, visualPart in pairs(VisualizerParts) do
            local targetData = targetPositions[partName]
            if visualPart and visualPart.Parent and targetData then
                visualPart.CFrame = targetData.CFrame
                hardenPart(visualPart)
            end
        end
    end

    local function toggleVisualizer(state)
        ServerPosSettings.Enabled = state
        if not state then
            destroyVisualizerParts()
        else
            cloneBodyParts()
        end
    end

    local function refreshVisualizer()
        if ServerPosSettings.Enabled then
            toggleVisualizer(false)
            task.wait(0.1)
            toggleVisualizer(true)
        end
    end

    local ServerPosSection = RenderTab:AddSection({ Title = "Server Position Visualizer", Side = 2 })
    ServerPosToggle = ServerPosSection:AddToggleKeyPicker({
        Text = "Enabled",
        Default = false,
        Flag = "ServerPos_Enabled",
        Key = Enum.KeyCode.End,
        Mode = "Toggle",
        Callback = function(Value) toggleVisualizer(Value) end,
    })
    ServerPosSection:AddColorPicker({
        Text = "Visualizer Color", Default = Color3.fromRGB(255, 255, 255), Flag = "ServerPos_Color",
        Callback = function(Value)
            ServerPosSettings.VisualizerColor = Value
            for _, part in pairs(VisualizerParts) do
                if part and part.Parent then
                    part.Color = Value
                end
            end
        end,
    })
    ServerPosSection:AddSlider({
        Text = "Transparency", Min = 0, Max = 1, Default = 0.5, Rounding = 0.01, Flag = "ServerPos_Transparency",
        Callback = function(Value)
            ServerPosSettings.Transparency = Value
            for _, part in pairs(VisualizerParts) do
                if part and part.Parent then
                    part.Transparency = Value
                end
            end
        end,
    })
    ServerPosSection:AddDropdown({
        Text = "Material",
        Values = {
            "Plastic", "Wood", "Slate", "Concrete", "CorrodedMetal", "DiamondPlate", "Foil", "Grass",
            "Ice", "Marble", "Granite", "Brick", "Pebble", "Sand", "Fabric", "SmoothPlastic", "Metal",
            "ForceField", "Neon", "Glass",
        },
        Default = "ForceField", Flag = "ServerPos_Material",
        Callback = function(Value)
            ServerPosSettings.Material = Enum.Material[Value]
            for _, part in pairs(VisualizerParts) do
                if part and part.Parent then
                    part.Material = ServerPosSettings.Material
                end
            end
        end,
    })
    ServerPosSection:AddToggle({
        Text = "Show Head", Default = false, Flag = "ServerPos_ShowHead",
        Callback = function(Value)
            ServerPosSettings.VisualizeHead = Value
            if ServerPosSettings.Enabled then
                refreshVisualizer()
            end
        end,
    })
    ServerPosSection:AddToggle({
        Text = "Show HRP", Default = false, Flag = "ServerPos_ShowHRP",
        Callback = function(Value)
            ServerPosSettings.VisualizeHRP = Value
            if ServerPosSettings.Enabled then
                refreshVisualizer()
            end
        end,
    })
    ServerPosSection:AddToggle({
        Text = "Head Decals", Default = false, Flag = "ServerPos_DecalHead",
        Callback = function(Value)
            ServerPosSettings.DecalHead = Value
            if ServerPosSettings.Enabled then
                refreshVisualizer()
            end
        end,
    })
    ServerPosSection:AddSlider({
        Text = "Max Ping", Min = 50, Max = 1000, Default = 300, Rounding = 1, Suffix = "ms", Flag = "ServerPos_MaxPing",
        Callback = function(Value) ServerPosSettings.MaxPing = Value end,
    })
    ServerPosSection:AddSlider({
        Text = "History Duration", Min = 0.5, Max = 5, Default = 2, Rounding = 0.01, Suffix = "s", Flag = "ServerPos_HistoryDuration",
        Callback = function(Value) ServerPosSettings.HistoryDuration = Value end,
    })
    ServerPosSection:AddSlider({
        Text = "High Ping Threshold", Min = 50, Max = 500, Default = 160, Rounding = 0.01, Suffix = "ms", Flag = "ServerPos_HighPingThreshold",
        Callback = function(Value) ServerPosSettings.HighPingThreshold = Value end,
    })
    ServerPosSection:AddSlider({
        Text = "High Ping Reduction", Min = 0.1, Max = 1, Default = 0.9, Rounding = 0.01, Suffix = "x", Flag = "ServerPos_HighPingReduction",
        Callback = function(Value) ServerPosSettings.HighPingReduction = Value end,
    })
    getgenv().ServerPosCharConnection = plr.CharacterAdded:Connect(function(newCharacter)
        character = newCharacter
        task.wait(1)
        if ServerPosSettings.Enabled then
            cloneBodyParts()
        end
        table.clear(positionHistory)
    end)
    TrackConnection(getgenv().ServerPosCharConnection)
    getgenv().ServerPosVisualizer = RunService.Heartbeat:Connect(updateVisualizer)
    TrackConnection(getgenv().ServerPosVisualizer)
    getgenv().ServerPosCharRemovingConnection = plr.CharacterRemoving:Connect(function()
        destroyVisualizerParts()
    end)
    TrackConnection(getgenv().ServerPosCharRemovingConnection)
end

do
    local FOLDER_NAME = "FootTrailFolder"
    local existingFolder = Workspace:FindFirstChild(FOLDER_NAME)
    if existingFolder then
        existingFolder:Destroy()
    end
    local TrailFolder = Instance.new("Folder")
    TrailFolder.Name = FOLDER_NAME
    TrailFolder.Parent = Workspace
    local TrailData = {
        enabled = false,
        trailSize = Vector3.new(1, 0.1, 1),
        fadeTime = 2,
        visibleTime = 0.5,
        leftOffset = -0.5,
        rightOffset = 0.5,
        spawnInterval = 0.18,
        maxActiveTrails = 40,
        color = Color3.fromRGB(191, 168, 255),
    }
    local CharacterData = { character = nil, hrp = nil, humanoid = nil }
    local TrailState = {
        lastSpawn = 0, lastPos = nil, toggleSide = true, ActiveTrails = {}, Pool = {},
    }
    local TrailConnections = { trail = nil, charRemoved = nil }

    local function removeActiveTrail(trailEntry)
        local trails = TrailState.ActiveTrails
        for i = #trails, 1, -1 do
            if trails[i] == trailEntry then
                table.remove(trails, i)
                break
            end
        end
    end

    local function cancelTrailTweens(trailEntry)
        if trailEntry.imageTween then
            trailEntry.imageTween:Cancel()
            trailEntry.imageTween = nil
        end
        if trailEntry.partTween then
            trailEntry.partTween:Cancel()
            trailEntry.partTween = nil
        end
    end

    local function releaseTrail(trailEntry)
        if not trailEntry or not trailEntry.part then
            return
        end
        removeActiveTrail(trailEntry)
        cancelTrailTweens(trailEntry)
        trailEntry.inUse = false
        trailEntry.part.Parent = nil
        trailEntry.part.Size = TrailData.trailSize
        trailEntry.part.Transparency = 1
        trailEntry.image.Size = UDim2.fromScale(1, 1)
        trailEntry.image.ImageTransparency = 0
        table.insert(TrailState.Pool, trailEntry)
    end

    local function destroyTrail(trailEntry)
        if trailEntry and trailEntry.part then
            trailEntry.part:Destroy()
        end
    end

    local function cleanupTrails()
        for _, trailEntry in ipairs(TrailState.ActiveTrails) do
            trailEntry.inUse = false
            cancelTrailTweens(trailEntry)
            destroyTrail(trailEntry)
        end
        for _, trailEntry in ipairs(TrailState.Pool) do
            trailEntry.inUse = false
            cancelTrailTweens(trailEntry)
            destroyTrail(trailEntry)
        end
        table.clear(TrailState.ActiveTrails)
        table.clear(TrailState.Pool)
    end

    local function cleanupCharacterEvents()
        if TrailConnections.trail then
            TrailConnections.trail:Disconnect()
            TrailConnections.trail = nil
        end
        if TrailConnections.charRemoved then
            TrailConnections.charRemoved:Disconnect()
            TrailConnections.charRemoved = nil
        end
    end
    getgenv().cleanupTrails = cleanupTrails
    getgenv().cleanupCharacterEvents = cleanupCharacterEvents

    local function createTrail(offset)
        local hrp = CharacterData.hrp
        if not hrp or not hrp.Parent then
            return
        end
        if #TrailState.ActiveTrails >= TrailData.maxActiveTrails then
            local oldest = table.remove(TrailState.ActiveTrails, 1)
            if oldest then
                cancelTrailTweens(oldest)
                oldest.inUse = false
                oldest.part.Parent = nil
                table.insert(TrailState.Pool, oldest)
            end
        end
        local trailEntry = table.remove(TrailState.Pool)
        if not trailEntry or not trailEntry.part then
            local trailPart = Instance.new("Part")
            trailPart.Anchored = true
            trailPart.CanCollide = false
            trailPart.Transparency = 1
            local surfaceGui = Instance.new("SurfaceGui")
            surfaceGui.Face = Enum.NormalId.Top
            surfaceGui.AlwaysOnTop = true
            surfaceGui.Parent = trailPart
            local image = Instance.new("ImageLabel")
            image.Size = UDim2.fromScale(1, 1)
            image.BackgroundTransparency = 1
            image.Image = "rbxassetid://123538800062216"
            image.Parent = surfaceGui
            trailEntry = { part = trailPart, image = image, inUse = false }
        end
        local footPos = hrp.Position - Vector3.new(0, hrp.Size.Y * 0.5 + 2, 0)
        local trailPart, image = trailEntry.part, trailEntry.image
        trailEntry.generation = (trailEntry.generation or 0) + 1
        local generation = trailEntry.generation
        trailEntry.inUse = true
        trailPart.Size = TrailData.trailSize
        trailPart.CFrame = CFrame.new(footPos, footPos + hrp.CFrame.LookVector) * CFrame.new(offset, 0, 0)
        trailPart.Parent = TrailFolder
        image.Size = UDim2.fromScale(1, 1)
        image.ImageTransparency = 0
        image.ImageColor3 = TrailData.color
        table.insert(TrailState.ActiveTrails, trailEntry)
        task.delay(TrailData.visibleTime, function()
            if not trailEntry.inUse or not trailPart.Parent then
                return
            end
            local tweenInfo = TweenInfo.new(TrailData.fadeTime)
            local imageTween = TweenService:Create(image, tweenInfo, {
                ImageTransparency = 1, Size = UDim2.fromOffset(0, 0),
            })
            local partTween = TweenService:Create(trailPart, tweenInfo, { Size = Vector3.zero })
            trailEntry.imageTween = imageTween
            trailEntry.partTween = partTween
            imageTween:Play()
            partTween:Play()
            imageTween.Completed:Once(function()
                if trailEntry.inUse and trailEntry.generation == generation then
                    releaseTrail(trailEntry)
                end
            end)
        end)
    end

    local function setupTrailConnection()
        cleanupCharacterEvents()
        TrailConnections.trail = RunService.RenderStepped:Connect(function(dt)
            if not TrailData.enabled then
                return
            end
            if not CharacterData.hrp or not CharacterData.hrp.Parent or not CharacterData.humanoid then
                return
            end
            TrailState.lastSpawn += dt
            local hrpPos = CharacterData.hrp.Position
            local moved = TrailState.lastPos and (hrpPos - TrailState.lastPos).Magnitude > 0.01
            TrailState.lastPos = hrpPos
            local state = CharacterData.humanoid:GetState()
            local onGround = state == Enum.HumanoidStateType.Running or state == Enum.HumanoidStateType.Landed
            if TrailState.lastSpawn >= TrailData.spawnInterval and moved and onGround then
                TrailState.lastSpawn = 0
                local offset = TrailState.toggleSide and TrailData.leftOffset or TrailData.rightOffset
                createTrail(offset)
                TrailState.toggleSide = not TrailState.toggleSide
            end
        end)
        TrackConnection(TrailConnections.trail)
    end

    local function setupCharacter()
        cleanupCharacterEvents()
        cleanupTrails()
        TrailState.lastSpawn = 0
        TrailState.lastPos = nil
        TrailState.toggleSide = true
        local character = plr.Character
        if not character then
            return
        end
        CharacterData.character = character
        CharacterData.hrp = character:WaitForChild("HumanoidRootPart")
        CharacterData.humanoid = character:WaitForChild("Humanoid")
        TrailState.lastPos = CharacterData.hrp.Position
        if TrailData.enabled then
            setupTrailConnection()
        end
        TrailConnections.charRemoved = character:GetPropertyChangedSignal("Parent"):Connect(function()
            if not character.Parent then
                cleanupCharacterEvents()
                cleanupTrails()
            end
        end)
        TrackConnection(TrailConnections.charRemoved)
    end

    local function onCharacterAdded()
        if TrailData.enabled then
            task.wait(0.1)
            setupCharacter()
        end
    end

    getgenv().CharacterAddedConn = plr.CharacterAdded:Connect(onCharacterAdded)
    TrackConnection(getgenv().CharacterAddedConn)

    local FootTrailSection = RenderTab:AddSection({ Title = "FEETT trailz", Side = 2 })
    FootTrailSection:AddToggle({
        Text = "Enabled", Default = false, Flag = "FootTrailEnabled",
        Callback = function(state)
            TrailData.enabled = state
            if state then
                if not CharacterData.character and plr.Character then
                    onCharacterAdded()
                elseif CharacterData.character and not TrailConnections.trail then
                    setupTrailConnection()
                end
            else
                cleanupCharacterEvents()
                cleanupTrails()
            end
        end,
    })
    FootTrailSection:AddColorPicker({
        Text = "Trail Color", Default = TrailData.color, Flag = "FootTrailColor",
        Callback = function(color)
            TrailData.color = color
            for _, v in ipairs(TrailState.ActiveTrails) do
                if v.image then
                    v.image.ImageColor3 = color
                end
            end
        end,
    })
    FootTrailSection:AddSlider({
        Text = "Trail Size", Min = 0.1, Max = 3, Default = 1, Rounding = 0.01, Flag = "FootTrailSize",
        Callback = function(value)
            TrailData.trailSize = Vector3.new(value, TrailData.trailSize.Y, value)
            for _, v in ipairs(TrailState.ActiveTrails) do
                if v.part then
                    v.part.Size = Vector3.new(value, v.part.Size.Y, value)
                end
            end
        end,
    })
    FootTrailSection:AddSlider({
        Text = "Fade Time", Min = 0.1, Max = 5, Default = 2, Rounding = 0.01, Suffix = "s", Flag = "FootTrailFade",
        Callback = function(value) TrailData.fadeTime = value end,
    })
    FootTrailSection:AddSlider({
        Text = "Visible Time", Min = 0.01, Max = 2, Default = 0.5, Rounding = 0.01, Suffix = "s", Flag = "FootTrailVisible",
        Callback = function(value) TrailData.visibleTime = value end,
    })
    FootTrailSection:AddSlider({
        Text = "Left Offset", Min = -3, Max = -0.01, Default = -0.5, Rounding = 0.01, Flag = "FootTrailLeftOffset",
        Callback = function(value) TrailData.leftOffset = value end,
    })
    FootTrailSection:AddSlider({
        Text = "Right Offset", Min = 0.01, Max = 3, Default = 0.5, Rounding = 0.01, Flag = "FootTrailRightOffset",
        Callback = function(value) TrailData.rightOffset = value end,
    })
    FootTrailSection:AddSlider({
        Text = "Spawn Interval", Min = 0.01, Max = 1, Default = 0.18, Rounding = 0.01, Suffix = "s", Flag = "FootTrailSpawn",
        Callback = function(value) TrailData.spawnInterval = value end,
    })
end

local TpWalking, TpWalkEnabled, TpWalkSpeed = false, false, 0.2

local function MoveDirX(deltaTime)
    local char = plr.Character
    if not char then
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then
        return
    end
    if hum.MoveDirection.Magnitude > 0 then
        char:TranslateBy(hum.MoveDirection * TpWalkSpeed * deltaTime * 10)
    end
end

local function EnableTpWalk()
    if _G.TpWalkConnection then
        _G.TpWalkConnection:Disconnect()
        _G.TpWalkConnection = nil
    end
    _G.TpWalkConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not TpWalkEnabled then
            TpWalking = false
            return
        end
        TpWalking = true
        local ok = pcall(MoveDirX, deltaTime)
        if not ok then
            TpWalking = false
        end
    end)
    TrackConnection(_G.TpWalkConnection)
end

local function DisableTpWalk()
    TpWalking = false
    if _G.TpWalkConnection then
        _G.TpWalkConnection:Disconnect()
        _G.TpWalkConnection = nil
    end
end

local TpWalkSection = PlayerTab:AddSection({ Title = "TP Walk", Side = 1 })
TpWalkSection:AddToggleKeyPicker({
    Text = "TP Walk",
    Default = false,
    Flag = "TPWalk_Enabled",
    Key = Enum.KeyCode.V,
    Mode = "Hold",
    Callback = function(Value)
        TpWalkEnabled = Value
        if Value then
            EnableTpWalk()
        else
            DisableTpWalk()
        end
    end,
})
TpWalkSection:AddSlider({
    Text = "TP Walk Speed", Flag = "TPWalk_Speed", Min = 0.05, Max = 3, Default = 0.2, Rounding = 0.01,
    Callback = function(Value) TpWalkSpeed = Value end,
})
_G.TpWalkCharAddedConn = plr.CharacterAdded:Connect(function()
    if TpWalkEnabled then
        DisableTpWalk()
        task.wait(0.5)
        if TpWalkEnabled then
            EnableTpWalk()
        end
    end
end)
TrackConnection(_G.TpWalkCharAddedConn)
_G.TpWalkCharRemovingConn = plr.CharacterRemoving:Connect(function()
    DisableTpWalk()
end)
TrackConnection(_G.TpWalkCharRemovingConn)

-- // Heal Self
do
    if _G.InHeal then
        pcall(_G.InHeal)
    end

    local HealSelf = {
        enabled = false, -- holding key / feature on
        blockUntil = 0, -- keep blocking anim briefly after release
        blockTime = 0.2,
        blockAnim = "rbxassetid://95836365038528",
        skillCheck = nil,
        healEvent = nil,
        connections = {},
        animationConnections = {},
    }

    local function resolveRemotes()
        local healing = ReplicatedStorage:FindFirstChild("Remotes")
            and ReplicatedStorage.Remotes:FindFirstChild("Healing")
        HealSelf.skillCheck = healing and healing:FindFirstChild("SkillCheckResultEvent")
        HealSelf.healEvent = healing and healing:FindFirstChild("HealEvent")
    end
    resolveRemotes()

    local function clearList(list)
        for _, connection in pairs(list) do
            if connection then
                pcall(function()
                    if connection.Connected then
                        connection:Disconnect()
                    end
                end)
            end
        end
        table.clear(list)
    end

    local function disconnectAll()
        HealSelf.enabled = false
        HealSelf.blockUntil = 0
        clearList(HealSelf.connections)
        clearList(HealSelf.animationConnections)
    end
    _G.InHeal = disconnectAll

    local function isBlocking()
        return HealSelf.enabled or os.clock() < HealSelf.blockUntil
    end

    local function isBlockAnimation(track)
        if not track or not track.Animation then
            return false
        end
        local id = track.Animation.AnimationId
        local anim = HealSelf.blockAnim
        if id == anim then
            return true
        end
        local stripped = type(anim) == "string" and anim:gsub("rbxassetid://", "") or ""
        return stripped ~= "" and id == stripped
    end

    local function stopBlockAnimation(track)
        if not isBlocking() then
            return
        end
        if isBlockAnimation(track) then
            pcall(function()
                track:Stop(0)
                track:AdjustWeight(0, 0)
            end)
        end
    end

    local function setupCharacter(char)
        clearList(HealSelf.animationConnections)
        if not char then
            return
        end
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
        if not hum then
            return
        end
        HealSelf.animationConnections[#HealSelf.animationConnections + 1] =
            hum.AnimationPlayed:Connect(function(track)
                stopBlockAnimation(track)
            end)
        HealSelf.animationConnections[#HealSelf.animationConnections + 1] =
            RunService.Heartbeat:Connect(function()
                if not isBlocking() then
                    return
                end
                if not hum.Parent then
                    return
                end
                for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                    stopBlockAnimation(track)
                end
            end)
        for _, conn in ipairs(HealSelf.animationConnections) do
            TrackConnection(conn)
        end
    end

    local function setHealEnabled(value)
        value = value == true
        if value then
            HealSelf.enabled = true
            HealSelf.blockUntil = 0
            if not HealSelf.skillCheck or not HealSelf.healEvent then
                resolveRemotes()
            end
        else
            HealSelf.enabled = false
            HealSelf.blockUntil = os.clock() + (HealSelf.blockTime or 0.2)
        end
    end

    -- Continuous heal while enabled
    local healHeartbeat = RunService.Heartbeat:Connect(function()
        if not HealSelf.enabled then
            return
        end
        local char = plr.Character
        if not char then
            return
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health >= hum.MaxHealth then
            return
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if HealSelf.skillCheck then
            pcall(function()
                HealSelf.skillCheck:FireServer("success", 1, char)
            end)
        end
        if HealSelf.healEvent and root then
            pcall(function()
                HealSelf.healEvent:FireServer(root, true)
            end)
        end
    end)
    HealSelf.connections[#HealSelf.connections + 1] = healHeartbeat
    TrackConnection(healHeartbeat)

    local charAdded = plr.CharacterAdded:Connect(setupCharacter)
    HealSelf.connections[#HealSelf.connections + 1] = charAdded
    TrackConnection(charAdded)
    if plr.Character then
        task.spawn(setupCharacter, plr.Character)
    end

    local HealSection = PlayerTab:AddSection({ Title = "Heal Self", Side = 1 })
    HealSection:AddToggleKeyPicker({
        Text = "Heal Self",
        Default = false,
        Flag = "HealSelf_Enabled",
        Key = Enum.KeyCode.M,
        Mode = "Hold",
        Callback = function(v)
            setHealEnabled(v)
        end,
    })
    HealSection:AddSlider({
        Text = "Block After Release",
        Flag = "HealSelf_BlockTime",
        Min = 0,
        Max = 1,
        Default = 0.2,
        Rounding = 0.01,
        Suffix = "s",
        Callback = function(v)
            HealSelf.blockTime = v
        end,
    })
    HealSection:AddInput({
        Text = "Block Anim ID",
        Flag = "HealSelf_BlockAnim",
        Default = "rbxassetid://95836365038528",
        Placeholder = "rbxassetid://...",
        Callback = function(text)
            if type(text) == "string" and text ~= "" then
                if not string.find(text, "rbxassetid://") and tonumber(text) then
                    text = "rbxassetid://" .. text
                end
                HealSelf.blockAnim = text
            end
        end,
    })
    HealSection:AddButton({
        Text = "Refresh Heal Remotes",
        Callback = function()
            resolveRemotes()
            local ok = (HealSelf.skillCheck ~= nil) and (HealSelf.healEvent ~= nil)
            Library:Notify({
                Text = ok and "Heal remotes found" or "Heal remotes missing",
                Lifetime = 2,
            })
        end,
    })
end

