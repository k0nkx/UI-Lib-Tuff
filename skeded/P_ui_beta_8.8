do
    if PreviewSection and PreviewSection.AddCurve then
        local SpinCurve = PreviewSection:AddCurve({
            Text = "Spin Curve",
            Flag = "PreviewSpinCurve",
            Default = {
                { -1, 0.2 },
                { -0.4, 0.8 },
                { 0.2, 0.15 },
                { 1, 1 },
            },
            MinX = -1,
            MaxX = 1,
            MinY = -1,
            MaxY = 1,
            Height = 140,
            Interpolation = "Cubic",
        })

        PreviewSection:AddSlider({
            Text = "Spin Speed Scale",
            Flag = "PreviewSpinScale",
            Min = 0,
            Max = 0.05,
            Default = 0.012,
            Decimal = 0.001,
            Suffix = "",
        })
        PreviewSection:AddToggle({
            Text = "Curve Controls Spin",
            Flag = "PreviewSpinFromCurve",
            Default = true,
        })

        TrackConnection(RunService.RenderStepped:Connect(function()
            if not Preview then
                return
            end
            if Library.Flags and Library.Flags["PreviewSpinFromCurve"] == false then
                return
            end
            Preview.AutoRotate = true

            local scale = 0.012
            if Library.Flags and type(Library.Flags["PreviewSpinScale"]) == "number" then
                scale = Library.Flags["PreviewSpinScale"]
            end

            -- Use the same playhead value shown on the graph (0 at bottom, 1 at top of MinY..MaxY)
            local intensity = 0.5
            if SpinCurve then
                if SpinCurve.GetPlayheadNormalized then
                    intensity = SpinCurve.GetPlayheadNormalized()
                elseif SpinCurve.GetPlayheadValue then
                    local v = SpinCurve.GetPlayheadValue()
                    intensity = math.clamp((v - (SpinCurve.MinY or -1)) / math.max((SpinCurve.MaxY or 1) - (SpinCurve.MinY or -1), 1e-6), 0, 1)
                end
            end

            -- RotationSpeed matches graph: bottom of curve = 0 spin, top = full Spin Speed Scale
            Preview.RotationSpeed = math.max(0, intensity) * scale
        end))
    else
        if Preview then
            Preview.AutoRotate = true
            Preview.RotationSpeed = 0.005
        end
    end
end

