    [40] = 1.8, [45] = 1.85, [50] = 2, [55] = 2.18, [60] = 2.24, [65] = 2.26, [70] = 2.3,
    [75] = 2.5, [80] = 2.52, [85] = 2.55, [90] = 2.6, [95] = 2.65, [100] = 2.7, [105] = 2.85,
    [110] = 2.85, [115] = 2.87, [120] = 2.9, [125] = 3, [130] = 3.05, [135] = 3.11, [140] = 3.1475,
