    local function applyTimerStyle()
        local label = Block.timerLabel
        if not label then
            return
        end
        label.TextColor3 = Block.timerColor
        label.TextSize = Block.timerSize
        pcall(function()
            label.FontFace = getBlockFont(Block.timerFontName)
        end)
        if Block.timerStrokeInst then
            Block.timerStrokeInst.Enabled = Block.timerStroke == true
            Block.timerStrokeInst.Color = Block.timerStrokeColor
            Block.timerStrokeInst.Thickness = Block.timerStrokeThickness
        end
    end

    local function createLines(color)
        clearLines()
        if not Block.showVisualizer then
            return
        end
        for i = 1, Block.segments do
            local line = Drawing.new("Line")
            line.Thickness = Block.thickness
            line.Transparency = Block.transparency
            line.Color = color
            line.Visible = false
            Block.lines[i] = line
        end
    end

    -- Returns best candidate: { kind, dist, target, visualPart }
    local function findClosestBlock()
        local character = plr.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local map = Workspace:FindFirstChild("Map")
        if not root or not map then
            return nil
        end
        local rootPos = root.Position
        local best
        for _, obj in ipairs(map:GetDescendants()) do
            if obj:IsA("BasePart") then
                if obj.Name == "VaultTrigger" then
                    local window = obj:FindFirstAncestor("Window")
                    if window then
                        local bottom = window:FindFirstChild("Bottom", true)
                        if bottom and bottom:IsA("BasePart") then
                            local dist = (obj.Position - rootPos).Magnitude
                            if not best or dist < best.dist then
                                best = {
                                    kind = "vault",
                                    dist = dist,
                                    target = obj,
                                    visualPart = bottom,
                                }
                            end
                        end
                    end
                elseif obj.Name == "PalletPointSlide" then
                    local dist = (obj.Position - rootPos).Magnitude
                    if not best or dist < best.dist then
                        best = {
                            kind = "pallet",
                            dist = dist,
                            target = obj,
                            visualPart = obj,
                        }
                    end
                end
            end
        end
        return best
    end

    local function stopVisualizer()
        if Block.connection then
            untrackConnection(Block.connection)
            Block.connection = nil
        end
        for _, line in ipairs(Block.lines) do
            if line then
                line.Visible = false
            end
        end
        if Block.timerLabel then
            Block.timerLabel.Visible = false
        end
    end

    local function formatRemaining(remaining)
        local decimals = math.clamp(math.floor(Block.timerDecimals or 1), 0, 2)
        if decimals <= 0 then
            return string.format("%ds", math.max(0, math.ceil(remaining)))
        end
        local fmt = "%." .. decimals .. "fs"
        return string.format(fmt, math.max(0, remaining))
    end

    local function startVisualizer(color)
        stopVisualizer()
        if not Block.showVisualizer and not Block.showTimer then
            return
        end
        if Block.showVisualizer then
            createLines(color)
        end
        local fullCircle = math.pi * 2
        local gen = Block.generation
        if Block.showTimer then
            ensureTimer()
            applyTimerStyle()
        end
        Block.connection = RunService.RenderStepped:Connect(function()
            if Block.generation ~= gen
                or not Block.inProgress
                or not Block.visualPart
                or not Block.visualPart.Parent
            then
                stopVisualizer()
                return
            end
            local cam = Workspace.CurrentCamera
            if not cam then
                return
            end
            local center = Block.visualPart.Position
            local screenCenter, onScreen = cam:WorldToViewportPoint(center)

            if Block.showVisualizer then
                for i = 1, Block.segments do
                    local angle1 = ((i - 1) / Block.segments) * fullCircle
                    local angle2 = (i / Block.segments) * fullCircle
                    local p1 = center + Vector3.new(
                        math.cos(angle1) * Block.radius,
                        0.05,
                        math.sin(angle1) * Block.radius
                    )
                    local p2 = center + Vector3.new(
                        math.cos(angle2) * Block.radius,
                        0.05,
                        math.sin(angle2) * Block.radius
                    )
                    local s1, v1 = cam:WorldToViewportPoint(p1)
                    local s2, v2 = cam:WorldToViewportPoint(p2)
                    local line = Block.lines[i]
                    if line then
                        line.From = Vector2.new(s1.X, s1.Y)
                        line.To = Vector2.new(s2.X, s2.Y)
                        line.Color = color
                        line.Thickness = Block.thickness
                        line.Transparency = Block.transparency
                        line.Visible = v1 or v2
                    end
                end
            end

            if Block.showTimer then
                local label = ensureTimer()
                applyTimerStyle()
                local remaining = (Block.endTime or 0) - os.clock()
                label.Text = formatRemaining(remaining)
                label.Position = UDim2.fromOffset(math.floor(screenCenter.X + 0.5), math.floor(screenCenter.Y + 0.5))
                label.Visible = onScreen and screenCenter.Z > 0
            elseif Block.timerLabel then
                Block.timerLabel.Visible = false
            end
        end)
        TrackConnection(Block.connection)
    end

    local function cleanup()
        Block.generation += 1
        Block.enabled = false
        Block.inProgress = false
        Block.kind = nil
        stopVisualizer()
        clearLines()
        destroyTimer()
        Block.target = nil
        Block.visualPart = nil
        Block.endTime = 0
        Block.startTime = 0
    end
    getgenv().BlockVaultCleanup = cleanup

    local function finishBlock(gen)
        if gen ~= nil and Block.generation ~= gen then
            return
        end
        if not Block.inProgress then
            return
        end
        local target = Block.target
        local kind = Block.kind
        if target and target.Parent then
            if kind == "vault" and Block.vaultCompleteEvent then
                pcall(function()
                    Block.vaultCompleteEvent:FireServer(target, false)
                end)
                Library:Notify({ Text = "Vault completed", Lifetime = 2 })
            elseif kind == "pallet" and Block.palletCompleteEvent then
                pcall(function()
                    Block.palletCompleteEvent:FireServer(target)
                end)
                Library:Notify({ Text = "Pallet slide completed", Lifetime = 2 })
            end
        end
        stopVisualizer()
        if Block.timerLabel then
            Block.timerLabel.Visible = false
        end
        Block.inProgress = false
        Block.enabled = false
        Block.kind = nil
        Block.target = nil
        Block.visualPart = nil
        Block.endTime = 0
        Block.startTime = 0
    end

    local function performBlock(force, useAutoComplete)
        if Block.inProgress and not force then
            Library:Notify({ Text = "Already in progress — wait for it to finish", Lifetime = 2 })
            return false
        end
        if force and Block.inProgress then
            Block.generation += 1
            stopVisualizer()
            Block.inProgress = false
        end
        resolveRemotes()
        local candidate = findClosestBlock()
        if not candidate then
            Library:Notify({ Text = "No vault or pallet found nearby", Lifetime = 3 })
            return false
        end
        if candidate.kind == "vault" and not Block.vaultEvent then
            Library:Notify({ Text = "VaultEvent not found", Lifetime = 3 })
            return false
        end
        if candidate.kind == "pallet" and not Block.palletEvent then
            Library:Notify({ Text = "PalletSlideEvent not found", Lifetime = 3 })
            return false
        end
        Block.kind = candidate.kind
        Block.target = candidate.target
        Block.visualPart = candidate.visualPart
        Block.inProgress = true
        Block.enabled = true
        Block.generation += 1
        local gen = Block.generation
        Block.startTime = os.clock()
        Block.endTime = Block.startTime + (Block.completeDelay or 15)
        local color = candidate.kind == "vault" and Block.vaultColor or Block.palletColor
        if candidate.kind == "vault" then
            pcall(function()
                Block.vaultEvent:FireServer(candidate.target, false)
            end)
            Library:Notify({ Text = "Vault started (closest)", Lifetime = 2 })
        else
            pcall(function()
                Block.palletEvent:FireServer(candidate.target, false)
            end)
            Library:Notify({ Text = "Pallet slide started (closest)", Lifetime = 2 })
        end
        if Block.showVisualizer or Block.showTimer then
            startVisualizer(color)
        end
        local shouldAuto = useAutoComplete
        if shouldAuto == nil then
            shouldAuto = Block.autoComplete
        end
        if shouldAuto then
            task.delay(Block.completeDelay, function()
                finishBlock(gen)
            end)
        end
        return true
    end

    local function setEnabled(value)
        if value then
            local isHold = Block.bindMode == "Hold"
            local ok = performBlock(false, isHold and Block.autoComplete or false)
            if not ok then
                Block.enabled = false
            end
        else
            if Block.bindMode == "Toggle" and Block.inProgress then
                finishBlock(nil)
            elseif Block.bindMode ~= "Hold" then
                cleanup()
            end
        end
    end

    local BlockSection = PlayerTab:AddSection({ Title = "Block Vault / Pallet", Side = 1 })
    local BlockKeyPicker = BlockSection:AddToggleKeyPicker({
        Text = "Block Keybind",
        Default = false,
        Flag = "BlockVault_Enabled",
        Key = Enum.KeyCode.B,
        Mode = "Hold",
        Callback = function(v)
            setEnabled(v)
        end,
    })
    BlockSection:AddDropdown({
        Text = "Bind Mode",
        Values = { "Hold", "Toggle" },
        Default = "Hold",
        Flag = "BlockVault_BindMode",
        Callback = function(v)
            Block.bindMode = v
            if BlockKeyPicker then
                pcall(function()
                    if BlockKeyPicker.SetMode then
                        BlockKeyPicker:SetMode(v)
                    elseif BlockKeyPicker.Mode ~= nil then
                        BlockKeyPicker.Mode = v
                    end
                end)
            end
            if Library.Flags and type(Library.Flags["BlockVault_Enabled"]) == "table" then
                pcall(function()
                    Library.Flags["BlockVault_Enabled"].Mode = v
                end)
            end
        end,
    })
    BlockSection:AddToggle({
        Text = "Show Visualizer",
        Default = true,
        Flag = "BlockVault_Visualizer",
        Callback = function(v)
            Block.showVisualizer = v
            if not v then
                for _, line in ipairs(Block.lines) do
                    if line then
                        line.Visible = false
                    end
                end
            elseif Block.inProgress and Block.visualPart then
                local color = Block.kind == "pallet" and Block.palletColor or Block.vaultColor
                startVisualizer(color)
            end
        end,
    })
    BlockSection:AddToggle({
        Text = "Show Timer",
        Default = true,
        Flag = "BlockVault_ShowTimer",
        Callback = function(v)
            Block.showTimer = v
            if not v and Block.timerLabel then
                Block.timerLabel.Visible = false
            elseif v and Block.inProgress and Block.visualPart then
                local color = Block.kind == "pallet" and Block.palletColor or Block.vaultColor
                startVisualizer(color)
            end
        end,
    })
    BlockSection:AddToggle({
        Text = "Auto Complete",
        Default = true,
        Flag = "BlockVault_AutoComplete",
        Callback = function(v)
            Block.autoComplete = v
        end,
    })
    BlockSection:AddSlider({
        Text = "Circle Radius",
        Min = 0.5,
        Max = 12,
        Default = 3,
        Rounding = 0.1,
        Suffix = " studs",
        Flag = "BlockVault_Radius",
        Callback = function(v)
            Block.radius = v
