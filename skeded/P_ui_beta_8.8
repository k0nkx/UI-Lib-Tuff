        draw.BoxFillGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, highFill.Color),
            ColorSequenceKeypoint.new(1, lowFill.Color),
        })
        draw.BoxFillGradient.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1 - (highFill.Transparency or 0)),
            NumberSequenceKeypoint.new(1, 1 - (lowFill.Transparency or 0)),
        })
        draw.BoxFillGradient.Rotation = Library.Flags["Box Fill Rotation"] or 90

        if FlagOn("Team Color") then
            local teamCol = Color3.fromRGB(100, 180, 255)
            if player and player.Team and player.TeamColor then
                teamCol = player.TeamColor.Color
            end
            draw.BoxGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, teamCol),
                ColorSequenceKeypoint.new(1, teamCol),
            })
            draw.BoxAccent.Color = teamCol
        else
            local highBox = ColorFlag("High Contrast Box")
            local lowBox = ColorFlag("Low Contrast Box")
            draw.BoxGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, highBox.Color),
                ColorSequenceKeypoint.new(1, lowBox.Color),
            })
            draw.BoxAccent.Color = highBox.Color
        end

        local highGlow = ColorFlag("High Contrast Glow")
        local lowGlow = ColorFlag("Low Contrast Glow")
        if Library.Flags["Box Glow Gradient"] then
            draw.GlowGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, highGlow.Color),
                ColorSequenceKeypoint.new(1, lowGlow.Color),
