}

local function getClosestFactor(dist)
    local closestKey, closestDiff
    for k in pairs(DropTable) do
        local diff = math.abs(dist - k)
        if not closestDiff or diff < closestDiff then
            closestDiff, closestKey = diff, k
        end
    end
    return DropTable[closestKey], closestKey
end

local function getAutoAimOffset(targetPos, originPos)
    local v, g = AimbotSettings.ProjectileSpeed, AimbotSettings.Gravity
    if v <= 0 or g <= 0 then
        return 0
    end
    local dx, dz = targetPos.X - originPos.X, targetPos.Z - originPos.Z
    local h = targetPos.Y - originPos.Y
    local range = math.sqrt(dx * dx + dz * dz)
    if range < 0.01 then
        return 0
    end
    local a = (g * range * range) / (2 * v * v)
    local disc = range * range - 4 * a * (a + h)
    if disc < 0 then
        return 0
    end
    local sqrtD = math.sqrt(disc)
    local k = (range - sqrtD) / (2 * a)
    if k ~= k or k < -10 or k > 10 then
        k = (range + sqrtD) / (2 * a)
    end
    if k ~= k or k < -10 or k > 10 then
        return 0
    end
    return range * k - h
end

local function getClosestToMouse()
    local closestPlayer, shortestDist = nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local Camera = Workspace.CurrentCamera
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= plr and p.Character then
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local shouldAim = true
                if AimbotSettings.TeamCheck and p.Team and plr.Team and p.Team == plr.Team then
                    shouldAim = false
                end
                if shouldAim then
                    local torso = p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("HumanoidRootPart")
                    if torso then
                        local pos, vis = Camera:WorldToViewportPoint(torso.Position)
                        if vis then
                            local mag = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                            if mag < shortestDist then
                                shortestDist, closestPlayer = mag, p
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function getTargetPart(char)
    if not char then
        return nil
    end
    local partName = AimbotSettings.TargetPart
    if partName == "HRP" then
        partName = "HumanoidRootPart"
    end
    return char:FindFirstChild(partName) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
end

local function resolveTarget(target, targetPart)
    local pos = targetPart.Position
    local rawVel = targetPart.AssemblyLinearVelocity or targetPart.Velocity or Vector3.zero
    local resolver = AimbotSettings.Resolver
    if not resolver or not resolver.Enabled then
        return pos, rawVel
    end

    local method = resolver.Method or "DeltaTime"

    if method == "MoveDir" then
        local hum = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            local walkSpeed = hum.WalkSpeed or 16
            local moveVel = hum.MoveDirection * walkSpeed
            return pos, moveVel
        end
        return pos, rawVel
    end

    local now = os.clock()
    local hist = ResolverHistory[target]
    if not hist then
        ResolverHistory[target] = {
            lastPos = pos,
            lastTime = now,
            smoothVel = Vector3.zero,
        }
        return pos, Vector3.zero
    end

    local dt = now - hist.lastTime
    if dt > 0.001 and dt < 0.5 then
        local rawDeltaVel = (pos - hist.lastPos) / dt
        local alpha = math.clamp(1 - (resolver.DeltaSmoothness or 0.5), 0.05, 1)
        hist.smoothVel = hist.smoothVel:Lerp(rawDeltaVel, alpha)
        hist.lastPos = pos
        hist.lastTime = now
    elseif dt >= 0.5 then
        hist.lastPos = pos
        hist.lastTime = now
        hist.smoothVel = Vector3.zero
    end

    return pos, hist.smoothVel
end

-- Distance-aware prediction using projectile speed (time-of-flight).
-- Iterates so lead scales with the predicted intercept distance, not a fixed one-shot.
local function predictTargetPosition(origin, targetPos, vel)
    if not vel or vel.Magnitude < 0.05 then
        return targetPos
    end
    local speed = math.max(AimbotSettings.ProjectileSpeed or 160, 1)
    local factor = AimbotSettings.Prediction or 1

    -- Closed-form intercept when possible: |rel + vel*t| = speed * t
    local rel = targetPos - origin
    local a = vel:Dot(vel) - speed * speed
    local b = 2 * rel:Dot(vel)
    local c = rel:Dot(rel)
    local t = nil

    if math.abs(a) < 1e-6 then
        if math.abs(b) > 1e-6 then
            t = -c / b
        end
    else
        local disc = b * b - 4 * a * c
        if disc >= 0 then
            local sqrtDisc = math.sqrt(disc)
            local t1 = (-b - sqrtDisc) / (2 * a)
            local t2 = (-b + sqrtDisc) / (2 * a)
            if t1 > 0 and t2 > 0 then
                t = math.min(t1, t2)
            elseif t1 > 0 then
                t = t1
            elseif t2 > 0 then
                t = t2
            end
        end
    end

    if t and t > 0 and t <= 5 then
        return targetPos + vel * (t * factor)
    end

    -- Fallback: iterative distance-based lead (recalculates flight time as target moves)
    local predicted = targetPos
    for _ = 1, 4 do
        local dist = (predicted - origin).Magnitude
        local flightTime = dist / speed
        predicted = targetPos + vel * (flightTime * factor)
    end
    return predicted
end

local function aimAt(target)
    if not target or not target.Character or not plr.Character then
        return
    end
    local Camera = Workspace.CurrentCamera
    local targetPart = getTargetPart(target.Character)
    if not targetPart then
        return
    end
    local targetPos, vel = resolveTarget(target, targetPart)
    if AimbotSettings.EnablePrediction and vel then
        local originPos = plr.Character:FindFirstChild("HumanoidRootPart")
        local origin = (originPos and originPos.Position) or Camera.CFrame.Position
        targetPos = predictTargetPosition(origin, targetPos, vel)
    end
    if AimbotSettings.HeightComp then
        local myHRP = plr.Character:FindFirstChild("HumanoidRootPart")
        if myHRP then
            local yDiff = targetPos.Y - myHRP.Position.Y
            if math.abs(yDiff) > 4 then
                targetPos = targetPos + Vector3.new(0, -yDiff * AimbotSettings.HeightCompFactor, 0)
            end
        end
    end
    local distance = (Camera.CFrame.Position - targetPos).Magnitude
    if AimbotSettings.EnableDropComp then
        if AimbotSettings.DropMethod == "Automatic" then
            local myHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            if myHRP then
                targetPos = targetPos + Vector3.new(0, getAutoAimOffset(targetPos, myHRP.Position), 0)
            end
        else
            local predictedDrop = getClosestFactor(distance)
            local t = distance * AimbotSettings.TimePerStud
            targetPos = targetPos + Vector3.new(0, 0.5 * AimbotSettings.Gravity * (t ^ 2) * predictedDrop, 0)
        end
    end
    local screenPos, vis = Camera:WorldToViewportPoint(targetPos)
    if not vis then
        return
    end
    local delta = Vector2.new(screenPos.X, screenPos.Y) - UserInputService:GetMouseLocation()
    if AimbotSettings.Method == "Mouse" then
        if mousemoverel then
            mousemoverel(delta.X * AimbotSettings.Smoothness, delta.Y * AimbotSettings.Smoothness)
        end
    else
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), AimbotSettings.Smoothness)
    end
end

local V2State = { SmoothStartTime = 0 }
local function getV2SmoothSpeed()
    local progress = math.clamp((os.clock() - V2State.SmoothStartTime) / AimbotSettings.V2.RampUpTime, 0, 1)
    return AimbotSettings.V2.MinSmoothSpeed
        + (AimbotSettings.V2.MaxSmoothSpeed - AimbotSettings.V2.MinSmoothSpeed) * progress
end

local function aimAtV2(target)
    if not target or not target.Character or not plr.Character then
        return
    end
    local Camera = Workspace.CurrentCamera
    local aimPart = getTargetPart(target.Character)
    if not aimPart then
        return
    end
    local targetPos, vel = resolveTarget(target, aimPart)
    if AimbotSettings.EnablePrediction and vel then
        local originPos = plr.Character:FindFirstChild("HumanoidRootPart")
        local origin = (originPos and originPos.Position) or Camera.CFrame.Position
        targetPos = predictTargetPosition(origin, targetPos, vel)
    end
    if AimbotSettings.EnableDropComp then
        local myHRP = plr.Character:FindFirstChild("HumanoidRootPart")
        if myHRP then
            targetPos = targetPos + Vector3.new(0, getAutoAimOffset(targetPos, myHRP.Position), 0)
        end
    end
    local screenPos, vis = Camera:WorldToViewportPoint(targetPos)
    if not vis then
        return
    end
    local smoothDelta = (Vector2.new(screenPos.X, screenPos.Y) - UserInputService:GetMouseLocation()) * getV2SmoothSpeed()
    if smoothDelta.Magnitude > AimbotSettings.V2.MinDelta and mousemoverel then
        mousemoverel(smoothDelta.X, smoothDelta.Y)
    end
end

