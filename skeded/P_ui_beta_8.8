                "getnamecallmethod: " .. (details.getnamecallmethod and "YES" or "NO"),
                "Twist Fire remote: " .. (remoteOk and "FOUND" or "NOT FOUND"),
            }
            local recommend
            if ok and remoteOk then
                recommend = "Recommended: Method 1 (hook)"
            elseif remoteOk then
                recommend = "Recommended: Method 2 (no hook) — executor missing hook APIs"
            else
                recommend = "Remote missing — silent aim may not work until Twist of Fate is available"
            end
            Library:Notify({ Text = table.concat(lines, " | "), Lifetime = 6 })
            Library:Notify({ Text = recommend, Lifetime = 5 })
        end,
    })
end

