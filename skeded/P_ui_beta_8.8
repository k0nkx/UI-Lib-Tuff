    local blockLoadedFonts = {}
    local defaultBlockFont = Font.fromEnum(Enum.Font.Code)
    pcall(function()
        local base = Library.Directory or "Atlanta"
        local dir = base .. "/Fonts"
        if isfolder and isfolder(dir) and isfile and isfile(dir .. "/ProggyClean.font") and getcustomasset then
            defaultBlockFont = Font.new(getcustomasset(dir .. "/ProggyClean.font"))
        end
    end)
    blockLoadedFonts["Default"] = defaultBlockFont

    local function getBlockFont(name)
        if not name or name == "" then
            name = "Default"
        end
        if blockLoadedFonts[name] then
            return blockLoadedFonts[name]
        end
        local entry = BlockCustomFonts[name]
        if not entry or not entry.url then
            blockLoadedFonts[name] = defaultBlockFont
            return defaultBlockFont
        end
        local ok, font = pcall(function()
            local base = Library.Directory or "Atlanta"
            local dir = base .. "/Fonts"
            if not isfolder(base) then makefolder(base) end
            if not isfolder(dir) then makefolder(dir) end
            local rawPath = dir .. "/" .. name
            local fontPath = dir .. "/" .. name .. ".font"
            if not isfile(rawPath) then
                writefile(rawPath, game:HttpGet(entry.url))
            end
            local fontJson = {
                name = name,
                faces = {{
                    name = name, weight = 400, style = "Regular",
                    assetId = getcustomasset(rawPath),
                }},
            }
            writefile(fontPath, HttpService:JSONEncode(fontJson))
            return Font.new(getcustomasset(fontPath))
        end)
        if ok and font then
            blockLoadedFonts[name] = font
            return font
        end
        blockLoadedFonts[name] = defaultBlockFont
        return defaultBlockFont
    end

    local function resolveRemotes()
        local okW, windowRemotes = pcall(function()
            return ReplicatedStorage:WaitForChild("Remotes", 5):WaitForChild("Window", 5)
        end)
        if okW and windowRemotes then
            Block.vaultEvent = windowRemotes:FindFirstChild("VaultEvent")
                or windowRemotes:WaitForChild("VaultEvent", 3)
            Block.vaultCompleteEvent = windowRemotes:FindFirstChild("VaultCompleteEvent")
                or windowRemotes:WaitForChild("VaultCompleteEvent", 3)
        end
        local okP, palletRemotes = pcall(function()
            return ReplicatedStorage:WaitForChild("Remotes", 5):WaitForChild("Pallet", 5)
        end)
        if okP and palletRemotes then
            Block.palletEvent = palletRemotes:FindFirstChild("PalletSlideEvent")
                or palletRemotes:WaitForChild("PalletSlideEvent", 3)
            Block.palletCompleteEvent = palletRemotes:FindFirstChild("PalletSlideCompleteEvent")
                or palletRemotes:WaitForChild("PalletSlideCompleteEvent", 3)
        end
    end
    resolveRemotes()

    local function clearLines()
        for _, line in ipairs(Block.lines) do
            pcall(function()
                if line and line.Remove then
                    line:Remove()
                end
            end)
