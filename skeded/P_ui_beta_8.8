            draw.GlowGradient.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1 - (highGlow.Transparency or 0)),
                NumberSequenceKeypoint.new(1, 1 - (lowGlow.Transparency or 0)),
            })
        else
            local c, t = highGlow.Color, 1 - (highGlow.Transparency or 0)
            draw.GlowGradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, c),
                ColorSequenceKeypoint.new(1, c),
