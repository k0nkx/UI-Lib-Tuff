                local isValid = true
                if player.Team and plr.Team and player.Team == plr.Team then
                    isValid = false
                end
                if isValid then
                    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                    local part = getAimPart(player.Character)
                    if humanoid and humanoid.Health > 0 and part then
                        local dist = (part.Position - camPos).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closest = player
                        end
                    end
                end
            end
        end
        return closest
    end

    local function getSilentDirection(target)
        local part = getAimPart(target.Character)
        if not part then return nil end
        local camPos = Workspace.CurrentCamera.CFrame.Position
        local aimPos = part.Position
        local r = SilentAim.randomize or 0
        if r > 0 then
            aimPos = aimPos + Vector3.new(
                (math.random() * 2 - 1) * r,
                (math.random() * 2 - 1) * r,
                (math.random() * 2 - 1) * r
            )
        end
        local dir = aimPos - camPos
        if dir.Magnitude < 0.001 then return nil end
        return dir.Unit
    end

    local function shouldSilent()
        if not SilentAim.enabled then return false end
        local chance = SilentAim.hitChance or 100
        if chance >= 100 then return true end
        if chance <= 0 then return false end
        return math.random(1, 100) <= chance
    end

    local function supportsHooking()
        local hasHook = typeof(hookmetamethod) == "function"
        local hasNewcc = typeof(newcclosure) == "function"
        local hasGetName = typeof(getnamecallmethod) == "function"
        return hasHook and hasNewcc and hasGetName, {
            hookmetamethod = hasHook,
            newcclosure = hasNewcc,
            getnamecallmethod = hasGetName,
        }
    end

    local function setupHook()
        if SilentAim.hooked then return true end
        local okSupport = supportsHooking()
        if not okSupport then return false end
        if not getRemote() then return false end

        local ok = pcall(function()
            SilentAim.originalNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                local method = getnamecallmethod()
                if method == "FireServer"
                    and SilentAim.remote
                    and self == SilentAim.remote
                    and SilentAim.enabled
                    and SilentAim.method == "Method 1"
                    and not SilentAim.isFiring
                then
                    local gunPart, direction = ...
                    if gunPart and typeof(gunPart) == "Instance" and direction and typeof(direction) == "Vector3" then
                        if shouldSilent() then
                            local target = getClosestTarget()
                            if target and target.Character then
                                local newDirection = getSilentDirection(target)
                                if newDirection then
                                    SilentAim.isFiring = true
                                    SilentAim.remote:FireServer(gunPart, newDirection)
                                    SilentAim.isFiring = false
                                    return nil
                                end
                            end
                        end
                    end
                end
                return SilentAim.originalNamecall(self, ...)
            end))
        end)

        if ok then
            SilentAim.hooked = true
            return true
        end
        return false
    end

    local function fireMethod2()
        if not SilentAim.enabled or SilentAim.method ~= "Method 2" then return end
        if not shouldSilent() then return end
        local remote = getRemote()
        if not remote then return end
        local target = getClosestTarget()
        if not target then return end
        local newDirection = getSilentDirection(target)
        if not newDirection then return end

        -- try to find a gun part on the character (tool handle / barrel-like)
        local gunPart = nil
        local char = plr.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                gunPart = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
            end
            if not gunPart then
                gunPart = char:FindFirstChild("HumanoidRootPart")
            end
        end
        if not gunPart then return end

        pcall(function()
            remote:FireServer(gunPart, newDirection)
        end)
    end

    local function enableMethod2()
        if SilentAim.method2Conn then return end
        SilentAim.method2Conn = UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if not SilentAim.enabled or SilentAim.method ~= "Method 2" then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                fireMethod2()
            end
        end)
        TrackConnection(SilentAim.method2Conn)
    end

    local function disableMethod2()
        if SilentAim.method2Conn then
            untrackConnection(SilentAim.method2Conn)
            SilentAim.method2Conn = nil
        end
    end

    local function setSilentEnabled(value)
        SilentAim.enabled = value == true
        if SilentAim.enabled then
            if SilentAim.method == "Method 1" then
                disableMethod2()
                if not setupHook() then
                    task.spawn(function()
                        for _ = 1, 5 do
                            task.wait(1)
                            if not SilentAim.enabled or SilentAim.method ~= "Method 1" then break end
                            if setupHook() then break end
                        end
                    end)
                end
            else
                enableMethod2()
            end
        else
            disableMethod2()
            -- leave hook installed but gated by enabled flag (safe)
        end
    end

