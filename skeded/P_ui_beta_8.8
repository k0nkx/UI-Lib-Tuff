local FakeSwingSettings = {
    enabled = false, debug = false, distance = 18, cooldown = 2, duration = 0,
    animId = "rbxassetid://117042998468241",
    speed = 1,
}
local fakeSwingRunning = false
local teamConnection = nil
local currentFakeSwingTrack = nil

local function FakeSwingDebugNotify(msg)
    if FakeSwingSettings.debug then
        Library:Notify({ Text = "[FakeSwing] " .. tostring(msg), Lifetime = 2 })
    end
end

local function isKiller()
    return plr.Team and plr.Team.Name == "Killer"
end

local function isSurvivorInRange()
    if not plr.Character or not isKiller() then
        return false
    end
    local myHRP = getHRP(plr.Character)
    if not myHRP then
        return false
    end
    local nearestDist, found = math.huge, false
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= plr and p.Team and p.Team.Name == "Survivors" then
            local hrp = getHRP(p.Character)
            if hrp then
                found = true
                local dist = (hrp.Position - myHRP.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                end
            end
        end
    end
    return found and nearestDist <= FakeSwingSettings.distance
end

local function stopCurrentFakeSwingTrack()
    if currentFakeSwingTrack then
        pcall(function()
            if currentFakeSwingTrack.IsPlaying then
                currentFakeSwingTrack:Stop(0)
            end
        end)
        currentFakeSwingTrack = nil
    end
end

local function performFakeSwing(force)
    local char = plr.Character
    if not char then
        FakeSwingDebugNotify("No character")
        return false
    end
    if not force and not isKiller() then
        FakeSwingDebugNotify("Not Killer")
        return false
    end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        FakeSwingDebugNotify("No Humanoid")
        return false
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        -- create Animator if missing (some rigs)
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    local animId = FakeSwingSettings.animId
    if type(animId) ~= "string" or animId == "" then
        FakeSwingDebugNotify("Invalid animId")
        return false
    end

    stopCurrentFakeSwingTrack()

    local animation = Instance.new("Animation")
    animation.AnimationId = animId

    local ok, trackOrErr = pcall(function()
        local track = animator:LoadAnimation(animation)
        track.Priority = Enum.AnimationPriority.Action4
        track.Looped = false
        track:AdjustSpeed(FakeSwingSettings.speed or 1)
        track:Play(0.05)
        currentFakeSwingTrack = track

        if FakeSwingSettings.duration and FakeSwingSettings.duration > 0 then
            task.delay(FakeSwingSettings.duration, function()
                if track and track.IsPlaying then
                    track:Stop(0.05)
                end
                if animation then
                    animation:Destroy()
                end
                if currentFakeSwingTrack == track then
                    currentFakeSwingTrack = nil
                end
            end)
        else
            track.Stopped:Once(function()
                if animation then
                    animation:Destroy()
                end
                if currentFakeSwingTrack == track then
                    currentFakeSwingTrack = nil
                end
            end)
        end
        return track
    end)

    if not ok then
        FakeSwingDebugNotify("Play failed: " .. tostring(trackOrErr))
        animation:Destroy()
        return false
    end

    FakeSwingDebugNotify("Played " .. tostring(animId))
    return true
end

local function stopFakeSwingLoop()
    fakeSwingRunning = false
    stopCurrentFakeSwingTrack()
    if teamConnection then
        pcall(function()
            if teamConnection.Connected then
                teamConnection:Disconnect()
            end
        end)
        teamConnection = nil
    end
end

local function startFakeSwingLoop()
    if fakeSwingRunning then
        return
    end
    fakeSwingRunning = true
    if not teamConnection then
        teamConnection = plr:GetPropertyChangedSignal("Team"):Connect(function() end)
        TrackConnection(teamConnection)
    end
    task.spawn(function()
        while fakeSwingRunning do
            if not FakeSwingSettings.enabled then
                task.wait(0.5)
                continue
            end
            if isKiller() then
                if isSurvivorInRange() then
                    performFakeSwing(false)
                    task.wait(math.max(FakeSwingSettings.cooldown or 0.1, 0.05))
                else
                    task.wait(0.15)
                end
            else
                task.wait(0.5)
            end
        end
    end)
end

