local function TrackConnection(conn)
    table.insert(_G.ParryConnections, conn)
    return conn
end

local function untrackConnection(conn)
    if typeof(conn) ~= "RBXScriptConnection" then
        return
    end
    if conn.Connected then
        conn:Disconnect()
    end
    for i = #_G.ParryConnections, 1, -1 do
        if _G.ParryConnections[i] == conn then
            table.remove(_G.ParryConnections, i)
        end
    end
end

