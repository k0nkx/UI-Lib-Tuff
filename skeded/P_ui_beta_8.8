do
    local Items = Preview.Items
    local oldUpdate = Preview.Update
    Preview.Update = function()
        oldUpdate()
        local Flags = Library.Flags
        if not (Items and Items.GlowGradient and Items.GlowGradient.Instance) then
            return
        end
        local high, low = Flags["High Contrast Glow"], Flags["Low Contrast Glow"]
        if not (high and low) then
            return
        end
        local grad = Items.GlowGradient.Instance
        if Flags["Box Glow Gradient"] then
            grad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, high.Color),
                ColorSequenceKeypoint.new(1, low.Color),
            })
            grad.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1 - (high.Transparency or 0)),
                NumberSequenceKeypoint.new(1, 1 - (low.Transparency or 0)),
            })
        else
            local c, t = high.Color, 1 - (high.Transparency or 0)
            grad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, c),
                ColorSequenceKeypoint.new(1, c),
            })
            grad.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, t),
                NumberSequenceKeypoint.new(1, t),
            })
        end
    end
    Preview.ChangeHealth = function()
        if not Library.Window.Open then
            return
        end
        local Value = math.abs(math.sin(tick()))
        local NewValue = Value
        if typeof(EasingStyles) == "table"
            and EasingStyles[Enum.EasingStyle.Exponential]
            and EasingStyles[Enum.EasingStyle.Exponential][Enum.EasingDirection.InOut] then
            NewValue = EasingStyles[Enum.EasingStyle.Exponential][Enum.EasingDirection.InOut](Value)
        end
        local BarValue = math.max(NewValue, 0.01)
        Items.HealthbarFade.Instance.Size = UDim2.new(1, -2, 1 - BarValue, 0)
        Items.HealthText.Instance.Size = UDim2.new(0, 0, 1 - NewValue, Items.HealthText.Instance.TextBounds.Y - 3)
        local Flags = Library.Flags
        local low, mid, high = Flags["Low Health"], Flags["Mid Health"], Flags["High Health"]
        if low and mid and high then
            Items.HealthText.Instance.TextColor3 = low.Color:Lerp(mid.Color, NewValue):Lerp(high.Color, NewValue)
        end
        Items.HealthText.Instance.Text = Library:Round(NewValue * 100, 1)
    end
end
