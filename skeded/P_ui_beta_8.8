                faces = {{
                    name = "ProggyClean", weight = 400, style = "Regular",
                    assetId = getcustomasset(dir .. "/" .. id),
                }},
            }
            writefile(dir .. "/ProggyClean.font", HttpService:JSONEncode(fontJson))
            defaultEspFont = Font.new(getcustomasset(dir .. "/ProggyClean.font"))
        end)
    end
    loadedFonts["Default"] = defaultEspFont

    local function getEspFont(name)
        if not name or name == "" then
            name = "Default"
        end
        if loadedFonts[name] then
            return loadedFonts[name]
        end
        local entry = CustomFonts[name]
        if not entry or not entry.url then
            loadedFonts[name] = defaultEspFont
            return defaultEspFont
        end
        local ok, font = pcall(function()
            local base = Library.Directory or "Atlanta"
            local dir = base .. "/Fonts"
            if not isfolder(base) then makefolder(base) end
            if not isfolder(dir) then makefolder(dir) end
            local fileName = name
            local rawPath = dir .. "/" .. fileName
            local fontPath = dir .. "/" .. fileName .. ".font"
            if not isfile(rawPath) then
                writefile(rawPath, game:HttpGet(entry.url))
            end
            local fontJson = {
                name = name,
                faces = {{
                    name = name, weight = 400, style = "Regular",
                    assetId = getcustomasset(rawPath),
                }},
            }
            writefile(fontPath, HttpService:JSONEncode(fontJson))
            return Font.new(getcustomasset(fontPath))
        end)
        if ok and font then
            loadedFonts[name] = font
            return font
        end
        loadedFonts[name] = defaultEspFont
        return defaultEspFont
    end

    local function resolveFontFlag(flagName)
        local v = Library.Flags and Library.Flags[flagName]
        if type(v) == "string" and v ~= "" then
            return getEspFont(v)
        end
        return defaultEspFont
    end

    local function resolveSizeFlag(flagName, fallback)
        local v = Library.Flags and Library.Flags[flagName]
        if type(v) == "number" then
            return v
        end
        return fallback or 12
    end

    local function applyEspFontsToDraw(draw)
        if not draw then return end
        pcall(function()
            draw.Name.FontFace = resolveFontFlag("Esp Name Font")
            draw.Name.TextSize = resolveSizeFlag("Esp Name Size", 12)
            draw.Distance.FontFace = resolveFontFlag("Esp Distance Font")
            draw.Distance.TextSize = resolveSizeFlag("Esp Distance Size", 12)
            draw.Weapon.FontFace = resolveFontFlag("Esp Weapon Font")
            draw.Weapon.TextSize = resolveSizeFlag("Esp Weapon Size", 12)
            draw.Flags.FontFace = resolveFontFlag("Esp Flags Font")
            draw.Flags.TextSize = resolveSizeFlag("Esp Flags Size", 12)
            draw.HealthText.FontFace = resolveFontFlag("Esp Health Font")
            draw.HealthText.TextSize = resolveSizeFlag("Esp Health Size", 12)
        end)
    end

    local function applyEspFontsToPreview()
        if not (Preview and Preview.Items) then return end
        local Items = Preview.Items
        local map = {
            Name = { font = "Esp Name Font", size = "Esp Name Size" },
            Distance = { font = "Esp Distance Font", size = "Esp Distance Size" },
            Weapon = { font = "Esp Weapon Font", size = "Esp Weapon Size" },
            Flags = { font = "Esp Flags Font", size = "Esp Flags Size" },
            HealthText = { font = "Esp Health Font", size = "Esp Health Size" },
        }
        for itemName, flags in pairs(map) do
            local item = Items[itemName]
            if item and item.Instance then
                pcall(function()
                    item.Instance.FontFace = resolveFontFlag(flags.font)
                    item.Instance.TextSize = resolveSizeFlag(flags.size, 12)
                end)
            end
        end
    end

    -- Hook preview update so font changes apply immediately
    do
        local prevUpdate = Preview and Preview.Update
        if Preview and prevUpdate then
            Preview.Update = function()
                prevUpdate()
                applyEspFontsToPreview()
            end
        end
    end

