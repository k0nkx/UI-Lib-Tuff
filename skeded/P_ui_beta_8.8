local function resolveKeyEnum(key)
    if key == nil or key == "None" or key == "" then
        return nil
    end
    if typeof(key) == "EnumItem" then
        return key
    end
    if type(key) == "string" then
        local cleaned = key:gsub("^Enum%.", ""):gsub("^KeyCode%.", ""):gsub("^UserInputType%.", ""):gsub("%s+", "")
        local ok, enumKey = pcall(function()
            return Enum.KeyCode[cleaned]
        end)
        if ok and enumKey then
            return enumKey
        end
        ok, enumKey = pcall(function()
            return Enum.UserInputType[cleaned]
        end)
        if ok and enumKey then
            return enumKey
        end
        cleaned = key:gsub(" ", "")
        ok, enumKey = pcall(function()
            return Enum.KeyCode[cleaned]
        end)
        if ok and enumKey then
            return enumKey
        end
    end
    return nil
end

local function syncAimbotKeyFromFlag()
    local keyFlag = Library.Flags and Library.Flags["Aimbot_Keybind"]
    if type(keyFlag) ~= "table" then
        return
    end
    if keyFlag.Key == nil or keyFlag.Key == "None" then
        AimbotSettings.Key = nil
    else
        AimbotSettings.Key = keyFlag.Key
    end
end

local function isAimKeyDown()
    syncAimbotKeyFromFlag()
    local key = resolveKeyEnum(AimbotSettings.Key)
    if not key then
        return false
    end
    if key.EnumType == Enum.KeyCode then
        return UserInputService:IsKeyDown(key)
    end
    if key.EnumType == Enum.UserInputType then
        local ok, pressed = pcall(function()
            return UserInputService:IsMouseButtonPressed(key)
        end)
        return ok and pressed or false
    end
    return false
end

local function UpdateAimbot()
    local Camera = Workspace.CurrentCamera
    if not plr or not plr.Character then
        LockedTarget, WasKeyDown = nil, false
        if dot then
            dot.Visible = false
        end
        return
    end
    syncAimbotKeyFromFlag()
    if dot then
        if AimbotSettings.Dot.Enabled then
            local mousePos = UserInputService:GetMouseLocation()
            dot.Visible = true
            dot.Position = mousePos
            dot.Color = AimbotSettings.Dot.Color
            dot.Radius = AimbotSettings.Dot.Radius
            dot.Filled = AimbotSettings.Dot.Filled
            dot.Transparency = AimbotSettings.Dot.Transparency
            dot.Thickness = AimbotSettings.Dot.Thickness
        else
            dot.Visible = false
        end
    end
    if not AimbotActive then
        LockedTarget, WasKeyDown, AimbotToggled = nil, false, false
        return
    end
    if not AimbotSettings.DebugMode then
        if not plr.Team or plr.Team.Name ~= "Killer" then
            LockedTarget, WasKeyDown, AimbotToggled = nil, false, false
            return
        end
    end
    local aimActive = true
    if not LockedTarget then
        local target = getClosestToMouse()
        if target and target.Character then
            local aimPart = target.Character:FindFirstChild("Torso") or target.Character:FindFirstChild("HumanoidRootPart")
            if AimbotSettings.Method == "MouseV2" then
                aimPart = target.Character:FindFirstChild("Head") or aimPart
            end
            if aimPart and (Camera.CFrame.Position - aimPart.Position).Magnitude <= AimbotSettings.MaxDistance then
                LockedTarget = target
                if AimbotSettings.Method == "MouseV2" then
                    V2State.SmoothStartTime = os.clock()
                end
            end
        end
    end
    if not aimActive then
        return
    end
    if AimbotSettings.Method == "MouseV2" then
        local targetValid = false
        if LockedTarget and LockedTarget.Character then
            local aimPart = getTargetPart(LockedTarget.Character)
            if aimPart then
                targetValid = (Camera.CFrame.Position - aimPart.Position).Magnitude <= AimbotSettings.MaxDistance
            end
        end
        if not targetValid then
            LockedTarget = nil
            local newTarget = getClosestToMouse()
            if newTarget and newTarget.Character then
                local head = newTarget.Character:FindFirstChild("Head")
                if head and (Camera.CFrame.Position - head.Position).Magnitude <= AimbotSettings.MaxDistance then
                    LockedTarget = newTarget
                    V2State.SmoothStartTime = os.clock()
                end
            end
        end
        if LockedTarget then
            aimAtV2(LockedTarget)
        end
    elseif LockedTarget then
        if LockedTarget.Character then
            local torso = LockedTarget.Character:FindFirstChild("Torso") or LockedTarget.Character:FindFirstChild("HumanoidRootPart")
            if torso and (Camera.CFrame.Position - torso.Position).Magnitude <= AimbotSettings.MaxDistance then
                aimAt(LockedTarget)
            else
                LockedTarget = nil
            end
        else
            LockedTarget = nil
        end
    end
end

