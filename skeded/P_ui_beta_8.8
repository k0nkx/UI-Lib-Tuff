local STAFF_MIN_RANK = 2
local staffWatchEnabled = false

local function getStaffInfo(player)
    if not player or player == plr then
        return false, ""
    end
    local roles, seen = {}, {}
    if game.CreatorType == Enum.CreatorType.Group then
        local ok, rank = pcall(function()
            return player:GetRankInGroup(game.CreatorId)
        end)
        if ok and type(rank) == "number" and rank >= STAFF_MIN_RANK then
            local roleOk, roleName = pcall(function()
                return player:GetRoleInGroup(game.CreatorId)
            end)
            roles[#roles + 1] = (roleOk and roleName or ("Rank " .. rank)) .. " [Game Group]"
            seen[game.CreatorId] = true
        end
    end
    local ok, groups = pcall(function()
        return player:GetGroupsAsync()
    end)
    if ok and type(groups) == "table" then
        for _, g in ipairs(groups) do
            if type(g.Rank) == "number" and g.Rank >= STAFF_MIN_RANK and not seen[g.Id] then
                seen[g.Id] = true
                roles[#roles + 1] = (g.Role or ("Rank " .. g.Rank)) .. " in " .. (g.Name or tostring(g.Id))
            end
        end
    end
    if #roles > 0 then
        return true, table.concat(roles, ", ")
    end
    return false, ""
end

local function notifyStaff(player, roleText)
    Library:Notify({ Text = "Staffwatch: " .. player.Name .. " is " .. roleText, Lifetime = 5 })
end

local function scanExistingStaff()
    local found = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= plr then
            local isStaff, roleText = getStaffInfo(player)
            if isStaff then
                found[#found + 1] = player.Name .. " (" .. roleText .. ")"
            end
        end
    end
    return found
end

-- // Desync / Anti Aim
do
    local GLOBAL_NAME = "AntiAim"
    if _G[GLOBAL_NAME] then
        local old = _G[GLOBAL_NAME]
        if old.heartbeatConnection and old.heartbeatConnection.Connected then
            old.heartbeatConnection:Disconnect()
        end
        if old.inputConnection and old.inputConnection.Connected then
            old.inputConnection:Disconnect()
        end
        _G[GLOBAL_NAME] = nil
    end

    local AntiAim = {
        enabled = false,
        mode = "Zero",
        multiplier = 5,
        randomValue = 30,
        maxVel = Vector3.new(63536, 63536, 63536),
        skyVel = Vector3.new(0, 10000, 0),
        undergroundVel = Vector3.new(0, -100, 0),
        customVel = Vector3.new(0, 0, 0),
        keybind = Enum.KeyCode.N,
        heartbeatConnection = nil,
        generation = 0, -- bumped on disable so in-flight frames abort
    }
    _G[GLOBAL_NAME] = AntiAim

    local function restoreVelocity(hrp, velocity)
        if hrp and hrp.Parent then
            pcall(function()
                hrp.AssemblyLinearVelocity = velocity
            end)
        end
    end

    local function applyDesync()
        if not AntiAim.enabled then
            return
        end
        local gen = AntiAim.generation
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            return
        end

        local oldVelocity = hrp.AssemblyLinearVelocity or hrp.Velocity
        local mode = AntiAim.mode
        local newVelocity

        if mode == "Zero" then
            newVelocity = Vector3.zero
        elseif mode == "Max" then
            newVelocity = AntiAim.maxVel
        elseif mode == "Sky" then
            newVelocity = AntiAim.skyVel
        elseif mode == "Underground" then
            newVelocity = AntiAim.undergroundVel
        elseif mode == "Custom" then
            newVelocity = AntiAim.customVel
        elseif mode == "Multiplier" then
            newVelocity = oldVelocity * AntiAim.multiplier
        elseif mode == "Random" then
            local r = AntiAim.randomValue * 5.5
            newVelocity = Vector3.new(
                math.random(-r, r),
                math.random(-r, r),
                math.random(-r, r)
            )
        else
            return
        end

        if not AntiAim.enabled or AntiAim.generation ~= gen then
            return
        end

        hrp.AssemblyLinearVelocity = newVelocity
        RunService.RenderStepped:Wait()

        -- only restore if still same enable-generation (disable bumps generation)
        if AntiAim.generation == gen and hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = oldVelocity
        end
    end

    local function stopAntiAim()
        AntiAim.enabled = false
        AntiAim.generation += 1
        if AntiAim.heartbeatConnection then
            pcall(function()
                if AntiAim.heartbeatConnection.Connected then
                    AntiAim.heartbeatConnection:Disconnect()
                end
            end)
            for i = #_G.ParryConnections, 1, -1 do
                if _G.ParryConnections[i] == AntiAim.heartbeatConnection then
                    table.remove(_G.ParryConnections, i)
                end
            end
            AntiAim.heartbeatConnection = nil
        end
        local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            restoreVelocity(hrp, hrp.AssemblyLinearVelocity)
        end
    end

    local function startAntiAim()
        -- always fully stop first so re-enable is clean
        stopAntiAim()
        AntiAim.enabled = true
        AntiAim.generation += 1
        local gen = AntiAim.generation
        AntiAim.heartbeatConnection = RunService.Heartbeat:Connect(function()
            if not AntiAim.enabled or AntiAim.generation ~= gen then
                return
            end
            applyDesync()
        end)
        TrackConnection(AntiAim.heartbeatConnection)
    end

    local function setAntiAimEnabled(value)
        value = value == true
        if value then
            startAntiAim()
        else
            stopAntiAim()
        end
        if Library.Flags then
            Library.Flags["AntiAim_Enabled"] = value
        end
    end

    local DesyncSection = PlayerTab:AddSection({ Title = "Desync / Anti Aim", Side = 2 })
    local DesyncToggle = DesyncSection:AddToggleKeyPicker({
        Text = "Enabled",
        Default = false,
        Flag = "AntiAim_Enabled",
        Key = Enum.KeyCode.N,
        Mode = "Toggle",
        Callback = function(v)
            setAntiAimEnabled(v)
            Library:Notify({
                Text = v and "Desync enabled" or "Desync disabled",
                Lifetime = 2,
            })
        end,
    })
    DesyncSection:AddDropdown({
        Text = "Mode",
        Values = { "Zero", "Max", "Sky", "Underground", "Custom", "Multiplier", "Random" },
        Default = "Zero",
        Flag = "AntiAim_Mode",
        Callback = function(v)
            AntiAim.mode = v
        end,
    })
    DesyncSection:AddSlider({
        Text = "Multiplier", Min = 0.1, Max = 50, Default = 5, Rounding = 0.1,
        Flag = "AntiAim_Multiplier",
        Callback = function(v) AntiAim.multiplier = v end,
    })
    DesyncSection:AddSlider({
        Text = "Random Intensity", Min = 1, Max = 200, Default = 30, Rounding = 1,
        Flag = "AntiAim_Random",
        Callback = function(v) AntiAim.randomValue = v end,
    })
    -- Max mode velocity vector
    DesyncSection:AddSlider({
        Text = "Max Vel X", Min = -100000, Max = 100000, Default = 63536, Rounding = 1,
        Flag = "AntiAim_MaxX",
        Callback = function(v)
            AntiAim.maxVel = Vector3.new(v, AntiAim.maxVel.Y, AntiAim.maxVel.Z)
        end,
    })
    DesyncSection:AddSlider({
        Text = "Max Vel Y", Min = -100000, Max = 100000, Default = 63536, Rounding = 1,
        Flag = "AntiAim_MaxY",
        Callback = function(v)
            AntiAim.maxVel = Vector3.new(AntiAim.maxVel.X, v, AntiAim.maxVel.Z)
        end,
    })
    DesyncSection:AddSlider({
        Text = "Max Vel Z", Min = -100000, Max = 100000, Default = 63536, Rounding = 1,
        Flag = "AntiAim_MaxZ",
        Callback = function(v)
            AntiAim.maxVel = Vector3.new(AntiAim.maxVel.X, AntiAim.maxVel.Y, v)
        end,
    })
    -- Sky / Underground vertical
    DesyncSection:AddSlider({
        Text = "Sky Vel Y", Min = 0, Max = 50000, Default = 10000, Rounding = 1,
        Flag = "AntiAim_SkyY",
        Callback = function(v)
            AntiAim.skyVel = Vector3.new(0, v, 0)
        end,
    })
    DesyncSection:AddSlider({
        Text = "Underground Vel Y", Min = -50000, Max = 0, Default = -100, Rounding = 1,
        Flag = "AntiAim_UnderY",
        Callback = function(v)
            AntiAim.undergroundVel = Vector3.new(0, v, 0)
        end,
    })
    -- Custom mode XYZ
    DesyncSection:AddSlider({
        Text = "Custom Vel X", Min = -100000, Max = 100000, Default = 0, Rounding = 1,
        Flag = "AntiAim_CustomX",
        Callback = function(v)
            AntiAim.customVel = Vector3.new(v, AntiAim.customVel.Y, AntiAim.customVel.Z)
        end,
    })
    DesyncSection:AddSlider({
        Text = "Custom Vel Y", Min = -100000, Max = 100000, Default = 0, Rounding = 1,
        Flag = "AntiAim_CustomY",
        Callback = function(v)
            AntiAim.customVel = Vector3.new(AntiAim.customVel.X, v, AntiAim.customVel.Z)
        end,
    })
    DesyncSection:AddSlider({
        Text = "Custom Vel Z", Min = -100000, Max = 100000, Default = 0, Rounding = 1,
        Flag = "AntiAim_CustomZ",
        Callback = function(v)
            AntiAim.customVel = Vector3.new(AntiAim.customVel.X, AntiAim.customVel.Y, v)
        end,
    })
end

local StaffSection = PlayerTab:AddSection({ Title = "Staff Watch", Side = 2 })
StaffSection:AddToggle({
    Text = "Staff Watch", Default = false, Flag = "StaffWatchToggle",
    Callback = function(state)
        staffWatchEnabled = state
        if _G.StaffWatchJoin then
            _G.StaffWatchJoin:Disconnect()
            _G.StaffWatchJoin = nil
        end
        if not state then
            Library:Notify({ Text = "Staffwatch disabled", Lifetime = 3 })
            return
        end
        _G.StaffWatchJoin = Players.PlayerAdded:Connect(function(player)
            if not staffWatchEnabled then
                return
            end
            task.spawn(function()
                local isStaff, roleText = getStaffInfo(player)
                if isStaff then
                    notifyStaff(player, roleText)
                end
            end)
        end)
        TrackConnection(_G.StaffWatchJoin)
        task.spawn(function()
            local found = scanExistingStaff()
            if #found > 0 then
                Library:Notify({ Text = "Staffwatch: " .. table.concat(found, " | "), Lifetime = 6 })
            else
                Library:Notify({ Text = "Staffwatch enabled — no staff found", Lifetime = 3 })
            end
        end)
    end,
})

