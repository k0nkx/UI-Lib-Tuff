                        Callback = function()
                            local path = Library.PreviewModel.Path
                                or select(1, Library:ResolveCachedModelPath(Library.PreviewModel.AssetId or Library.PreviewModel.Name))
                            local meta = path and Library:ReadPreviewModelMeta(path) or Library:DefaultPreviewMeta()
                            Library:SetPreviewOrigins(meta.OriginX, meta.OriginY, meta.OriginZ, true)
                            Library:SetPreviewDisplaySize(meta.DisplaySize, true)
                            if OriginXSlider and OriginXSlider.Set then OriginXSlider.Set(meta.OriginX) end
                            if OriginYSlider and OriginYSlider.Set then OriginYSlider.Set(meta.OriginY) end
                            if OriginZSlider and OriginZSlider.Set then OriginZSlider.Set(meta.OriginZ) end
                            if DisplaySizeSlider and DisplaySizeSlider.Set then DisplaySizeSlider.Set(meta.DisplaySize) end
                        end
                    })

                    self:AddButton({
                        Text = "Refresh Model List",
                        Callback = function()
                            Library._PreviewModelsSynced = false
                            pcall(function()
                                Library:SyncPreviewModelsFromGitHub(true)
                            end)
                            local list = Library:GetPreviewModelList()
                            if ModelDropdown and ModelDropdown.RefreshDropdown then
                                ModelDropdown:RefreshDropdown(list)
                            end
                            local stats = Library._PreviewModelsLastSync
                            local msg = "Models (" .. #list .. ")"
                            if stats then
                                msg = string.format(
                                    "Models %d | dl %d skip %d fail %d",
                                    stats.Total or #list,
                                    stats.Downloaded or 0,
                                    stats.Skipped or 0,
                                    stats.Failed or 0
                                )
                                if (stats.TexturesTotal or 0) > 0 or (stats.TexturesDownloaded or 0) > 0 then
                                    msg = msg .. string.format(
                                        " | Tex %d dl %d skip %d fail %d",
                                        stats.TexturesTotal or 0,
                                        stats.TexturesDownloaded or 0,
                                        stats.TexturesSkipped or 0,
                                        stats.TexturesFailed or 0
                                    )
                                end
                            end
                            Library:Notify({ Text = msg, Lifetime = 5 })
                        end
                    })

                    Cfg.OriginXSlider = OriginXSlider
                    Cfg.OriginYSlider = OriginYSlider
                    Cfg.OriginZSlider = OriginZSlider
                    Cfg.DisplaySizeSlider = DisplaySizeSlider
                end
            end
            
            return setmetatable(Cfg, Library)
        end

