                            char:WaitForChild("Humanoid", 15)
                        end)
                        task.wait(0.35)
                        if char and char.Parent then
                            pcall(function()
                                Cfg.ViewModel(char)
                            end)
                        end
                    end
                    -- If custom failed and character later spawns, still try local player once
                    if lp then
                        Library:Connect(lp.CharacterAdded, function(newChar)
                            if Cfg._CustomPreviewApplied then
                                return
                            end
                            task.delay(0.5, function()
                                if newChar and newChar.Parent and not Cfg._CustomPreviewApplied then
                                    pcall(function()
