--[[
================================================================================
  PERONAHAX  ·  Roblox UI Library
  Workspace folder: Atlanta/
  Default accent:   RGB(222, 162, 193)
================================================================================

--------------------------------------------------------------------------------
  1. QUICK START
--------------------------------------------------------------------------------
  local Library = loadstring(game:HttpGet("URL_TO_THIS_FILE"))()

  local Window = Library:CreateWindow({
      Title       = "My Script",
      Size        = UDim2.new(0, 560, 0, 670),
      Position    = UDim2.fromScale(0.5, 0.5),   -- optional
      AnchorPoint = Vector2.new(0.5, 0.5),       -- optional
      Prefix      = "my",                        -- watermark left side
      Suffix      = "script",                    -- watermark right side
  })

  local Tab     = Window:AddTab({ Title = "Main", Columns = 2 })
  local Section = Tab:AddSection({ Title = "Features", Side = 1 })

  Section:AddToggle({
      Text     = "Example",
      Default  = false,
      Flag     = "Example",
      Callback = print,
  })

  -- REQUIRED: builds the Settings tab (configs / themes / HUD / menu key / keybind list)
  Window:InitPanels()

  Library:AutoLoad()   -- optional — loads last saved config if Autoload.txt is set

--------------------------------------------------------------------------------
  2. STRUCTURE
--------------------------------------------------------------------------------
  Window
   └─ Tab (Columns = 1 or 2)
       └─ Section (Side = 1 or 2)
           └─ Elements (Toggle, Slider, Dropdown, …)

  Multi-section on one side of a tab:
      local S1, S2, S3 = Tab:AddMultiSection({ Names = {"Combat", "Visuals", "Misc"}, Side = 2 })

  Flags:
      Every element with a Flag stores its value in Library.Flags[FlagName].
      Flags are what configs save / load.

  Unload previous instance (safe re-execute):
      if getgenv().Library and getgenv().Library.Unload then
          getgenv().Library:Unload()
      end

--------------------------------------------------------------------------------
  3. ELEMENTS
  All constructors take a single table. Flag is used for config save/load.
--------------------------------------------------------------------------------

  -- Toggle
  Section:AddToggle({
      Text     = "Name",
      Default  = false,
      Flag     = "MyToggle",
      Callback = function(Value) end,   -- boolean
  })

  -- Toggle + keybind on one row (preferred for on/off features)
  Section:AddToggleKeyPicker({
      Text     = "Name",
      Default  = false,
      Flag     = "MyToggle",
      Key      = Enum.KeyCode.P,
      Mode     = "Toggle",              -- "Toggle" | "Hold" | "Always"
      Callback = function(Value) end,
  })
  -- Equivalent via AddToggle options:
  Section:AddToggle({
      Text     = "Name",
      Default  = false,
      Flag     = "MyToggle",
      Keybind  = true,
      Key      = Enum.KeyCode.P,
      Mode     = "Toggle",
      Callback = function(Value) end,
  })
  -- Unbound key (None) → only the toggle button changes state.

  -- Slider
  Section:AddSlider({
      Text     = "Name",
      Min      = 0,
      Max      = 100,
      Default  = 50,
      Suffix   = "%",
      Rounding = 1,                     -- also accepts Decimal
      Flag     = "MySlider",
      Callback = function(Value) end,   -- number
  })

  -- Range slider (min + max handles)
  Section:AddRangeSlider({
      Text     = "Name",
      Min      = 0,
      Max      = 100,
      Default  = {0, 100},
      Suffix   = "",
      Rounding = 1,
      Flag     = "MyRange",
      Callback = function(Value) end,   -- {min, max}
  })

  -- Dropdown
  Section:AddDropdown({
      Text     = "Name",
      Values   = {"A", "B"},            -- also accepts Options
      Default  = "A",
      Multi    = false,
      Search   = false,
      Flag     = "MyDrop",
      Callback = function(Value) end,   -- string, or table if Multi
  })

  -- Text input
  Section:AddInput({
      Text            = "Name",
      Placeholder     = "...",
      Default         = "",
      FocusLost       = true,           -- fire callback only on focus lost
      ClearTextOnFocus = false,
      Flag            = "MyInput",
      Callback        = function(Text) end,
  })

  -- Button
  Section:AddButton({
      Text         = "Name",
      Confirmation = false,             -- requires a second click to confirm
      Callback     = function() end,
  })
  -- Chain multiple buttons on the same row:
  Section:AddButton({Text = "A", Callback = fn}):AddButton({Text = "B", Callback = fn})

  -- Standalone keybind (activation only — NOT for toggling a feature on/off)
  -- Prefer AddToggleKeyPicker when the key should turn something on/off.
  Section:AddKeyPicker({
      Text            = "Name",
      Key             = Enum.KeyCode.E,
      Mode            = "Hold",         -- "Toggle" | "Hold" | "Always"
      Active          = false,
      ShowInList      = true,           -- appear in the HUD keybind list
      AlwaysShow      = false,          -- always show in list even when inactive
      HighlightActive = true,
      Flag            = "MyKey",
      Callback        = function(Active) end,  -- boolean
  })
  -- Click the key label to rebind.
  -- Press Escape or the same key again to unbind (sets to None).
  -- Right-click the key label for: Show in list / Always Show / Highlight When On / Mode
  -- Settings → Menu → "Menu Key" (default Right Shift) toggles the entire UI open/closed.

  -- Color picker
  Section:AddColorPicker({
      Text     = "Name",
      Default  = Color3.fromRGB(255, 0, 0),
      Alpha    = 0,                     -- also accepts Transparency (0 = opaque)
      Flag     = "MyColor",
      Callback = function(Color, Alpha) end,
  })
  -- Chain after a toggle:  Toggle:AddColorPicker({ ... })

  -- Label
  Section:AddLabel({ Text = "Static text" })

  -- List
  Section:AddList({
      Options  = {"A", "B"},
      Multi    = false,
      Flag     = "MyList",
      Callback = function(Value) end,
  })

  -- Curve editor
  Section:AddCurve({
      Text          = "Wave Curve",
      Flag          = "MyWave",
      Default       = { {-1, -1}, {1, 1} },
      MinX          = -1, MaxX = 1,
      MinY          = -1, MaxY = 1,
      Height        = 160,
      Interpolation = "Linear",         -- "Linear" | "Cubic"
      Callback      = function(points) end,  -- {{x,y}, ...}
  })

  -- Model preview viewport
  Section:AddPreview({ Height = 300 })
  -- Section:AddPreview({ Height = 300, ShowControls = false })  -- dropdown only, no origin/size sliders

  -- Player list
  Section:Playerlist({ Size = 239 })

  -- Tooltip (attach to any returned element)
  Element:Tooltip({ Name = "Help text", MultiLine = false })

--------------------------------------------------------------------------------
  4. MODEL PREVIEW & LOCAL TEXTURES
--------------------------------------------------------------------------------
  Models are auto-synced from github.com/k0nkx/Custom-Models → Atlanta/CachedModels
  (skips download if the file already exists). Local .rbxmx dropped into that folder
  are picked up automatically.

  Per-model PRESETS (read-only) can live inside the .rbxmx or a .previewmeta sidecar:
      -- origin_x:0
      -- origin_y:2.85
      -- origin_z:0
      -- display_size:9.3
  Loaded when selecting a model. Live sliders only affect the preview — they never
  write back to the file.

  LOCAL TEXTURES (preferred over Roblox asset hosting):
      Auto-synced from github.com/k0nkx/Custom-Models/textures/<ModelName>/
      into Atlanta/CachedModels/texture_ids/<ModelName>/

      Example filename:  CoolHatTexture -- 123456789.webp

      Folder name = rbxmx base name (e.g. "Akeno" for Akeno.rbxmx).
      Format: <any name> -- <TextureId>.webp  (.png / .jpg also work)

      The numeric ID is matched against MeshPart.TextureID, SpecialMesh.TextureId,
      Decal/Texture.Texture, SurfaceAppearance maps, Shirt/Pants, etc.
      Matching local image is loaded via getcustomasset and replaces the Roblox asset.
      You can also drop files into texture_ids/ manually; sync skips existing files.

--------------------------------------------------------------------------------
  5. LOADING UI
  Shown automatically while the library boots (same visual style as the main UI).
  Holds 2s on "Ready", fades out 1s, then reveals the main window.
--------------------------------------------------------------------------------
  Library:SetLoadingStatus("Syncing models...")   -- status text
  Library:SetLoadingProgress(0.65)                -- 0..1  (updates bar + percent)
  Library:HideLoading()                           -- start hold → fade → reveal
  Library:HideLoading(true)                       -- instant destroy + reveal

  InitPanels() automatically sets status to "Ready", progress to 1, and calls
  HideLoading(). A 12s safety timer does the same if InitPanels was never called.

--------------------------------------------------------------------------------
  6. NOTIFICATIONS
--------------------------------------------------------------------------------
  Library:Notify({ Text = "Hello", Lifetime = 5 })

--------------------------------------------------------------------------------
  7. THEMES
--------------------------------------------------------------------------------
  Library:Refresh("Accent", Color3.fromRGB(222, 162, 193))
  Library:SaveTheme("MyTheme")
  Library:DeleteTheme("MyTheme")

  Page background (Settings → Theming):
      Drop .png / .jpg / .gif / .webp into Atlanta/Assets
      Toggle "Custom Page Background", pick the asset, adjust transparency

--------------------------------------------------------------------------------
  8. CONFIGS
  Also available in the Settings tab after InitPanels().
--------------------------------------------------------------------------------
  Library:SaveConfig("Name")
  Library:LoadConfig(readfile(Library.Directory .. "/Configs/Name.cfg"))  -- or raw string
  Library:DeleteConfig("Name")
  Library:AutoLoad()          -- loads whatever name is stored in Atlanta/Autoload.txt

  Flags live in Library.Flags[FlagName] after elements are created.

--------------------------------------------------------------------------------
  9. FOLDER LAYOUT (created automatically)
--------------------------------------------------------------------------------
  Atlanta/
   ├─ Fonts/
   ├─ Configs/
   ├─ Themes/
   ├─ Assets/              ← page background images
   ├─ CachedModels/        ← .rbxmx models + texture_ids/
   └─ Autoload.txt

================================================================================
]]

