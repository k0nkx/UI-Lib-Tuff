        Library.AddKeyPicker = function(self, Data)
            Data = Data or {}

            -- If called on a Toggle (chained), link so the key toggles that toggle
            local LinkedToggle = nil
            if self and (self.Type == "Toggle" or (self.Enabled ~= nil and self.Set and self.Items and self.Items.ComponentsHolder)) then
                LinkedToggle = self
            end

            local Cfg = {
                Text = Data.Text or Data.Name or Data.Title or (LinkedToggle and LinkedToggle.Text) or "Keybind",
                Flag = Data.Flag or Library:NextFlag(),
                Callback = Data.Callback or function() end,

                Key = Data.Key or Data.Default or nil,
                Mode = Data.Mode or "Toggle",
                Active = Data.Active or (LinkedToggle and LinkedToggle.Enabled) or false,
                ShowInList = (Data.ShowInList == nil) and true or Data.ShowInList,
                AlwaysShow = Data.AlwaysShow or false,
                HighlightActive = (Data.HighlightActive == nil) and true or Data.HighlightActive,

                Open = false,
                Tweening = false,
                Binding,
                LinkedToggle = LinkedToggle,

                Items = {},
                Type = "KeybindPicker",

                Names = self.Names,
                Elements = self.Elements,
                DataElements = self.DataElements,
                SeperatedElements = self.SeperatedElements,

                Old;
            }

            Flags[Cfg.Flag] = {
                Mode = Cfg.Mode,
                Key = Cfg.Key,
                Active = Cfg.Active
            }

            local Keypicker = setmetatable(Cfg, Library)
            if LinkedToggle then
                LinkedToggle.KeybindPicker = Keypicker
            end
            local KeybindListElement = Library:AddHotKey({ Text = Cfg.Text })
            KeybindListElement:SetAlwaysShow(Cfg.AlwaysShow)
            KeybindListElement:SetHighlightActive(Cfg.HighlightActive)

            -- Refresh list visibility from current toggles + active state + global Settings
            local function RefreshListVisibility()
                local ShowInList = Flags[Cfg.Flag .. "_SHOW_IN_LIST"]
                if ShowInList == nil then
                    ShowInList = Cfg.ShowInList
                end

                local AlwaysShow = Flags[Cfg.Flag .. "_ALWAYS_SHOW"]
                if AlwaysShow == nil then
                    AlwaysShow = Cfg.AlwaysShow
                end
                -- Global Settings toggle applies to every listed keybind
                if Flags["Keybind Always Show"] then
                    AlwaysShow = true
                end

                local Highlight = Flags[Cfg.Flag .. "_HIGHLIGHT_ACTIVE"]
                if Highlight == nil then
                    Highlight = Cfg.HighlightActive
                end
                if Flags["Keybind Highlight When On"] ~= nil then
                    Highlight = Flags["Keybind Highlight When On"]
                end

                KeybindListElement:SetAlwaysShow(AlwaysShow)
                KeybindListElement:SetHighlightActive(Highlight)
                KeybindListElement:SetActive(Cfg.Active)

                if not ShowInList then
                    KeybindListElement:SetEnabled(false)
                elseif AlwaysShow then
                    KeybindListElement:SetEnabled(true)
                else
                    KeybindListElement:SetEnabled(Cfg.Active)
                end
            end

            KeybindListElement.RefreshListVisibility = RefreshListVisibility

            local Items = Cfg.Items; do
                -- // Menu Element
                Items.ComponentsHolder = self.Items.ComponentsHolder
                if not Items.ComponentsHolder then 
                    Items.ComponentsHolder = self:AddLabel({Name = Cfg.Text}).Items.ComponentsHolder
                end 
                
