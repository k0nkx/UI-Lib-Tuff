            })

            -- Line buttons up with dropdown field (title is 16px above outline)
            if AddButton.Items and AddButton.Items.Object then
                AddButton.Items.Object.Instance.Size = UDim2.new(1, 0, 0, 36)
                Library:Create("UIPadding", {
                    PaddingTop = UDim.new(0, 16),
                    Parent = AddButton.Items.Object.Instance,
                })
            end

            Items.AddBtn = AddButton
            Items.RemoveBtn = RemoveButton
            Cfg._redraw = nil

            -- ========== Drawing ==========
            local function toScreen(x, y, size)
                local nx = (x - Cfg.MinX) / (Cfg.MaxX - Cfg.MinX)
                local ny = 1 - ((y - Cfg.MinY) / (Cfg.MaxY - Cfg.MinY))
                return nx * size.X, ny * size.Y
            end

            local function fromScreen(px, py, size)
                local nx = math.clamp(px / size.X, 0, 1)
                local ny = math.clamp(py / size.Y, 0, 1)
                local x = Cfg.MinX + nx * (Cfg.MaxX - Cfg.MinX)
                local y = Cfg.MinY + (1 - ny) * (Cfg.MaxY - Cfg.MinY)
                return x, y
            end

            local function clearPath()
                for _, c in ipairs(Items.Path.Instance:GetChildren()) do
                    c:Destroy()
                end
            end

            local function drawSegment(x1, y1, x2, y2, thick)
                local dx, dy = x2 - x1, y2 - y1
                local len = math.sqrt(dx * dx + dy * dy)
                if len < 0.35 then return end
                local ang = math.deg(math.atan2(dy, dx))
                local mx, my = (x1 + x2) * 0.5, (y1 + y2) * 0.5
                -- slight overlap reduces visible gaps on curves
                local drawLen = math.max(len + 0.75, 1)
                local t = thick or 1

                Library:Create("Frame", {
                    Parent = Items.Path.Instance,
                    BackgroundColor3 = Themes.Preset.Accent,
                    BorderSizePixel = 0,
                    Size = UDim2.new(0, drawLen, 0, t),
                    Position = UDim2.new(0, mx - drawLen * 0.5, 0, my - t * 0.5),
                    Rotation = ang,
                    ZIndex = 2,
                }):Themify("Accent", "BackgroundColor3")
            end

            local function cubic(p0, p1, p2, p3, t)
                local t2 = t * t
                local t3 = t2 * t
                local x = 0.5 * ((2 * p1[1]) + (-p0[1] + p2[1]) * t + (2 * p0[1] - 5 * p1[1] + 4 * p2[1] - p3[1]) * t2 + (-p0[1] + 3 * p1[1] - 3 * p2[1] + p3[1]) * t3)
                local y = 0.5 * ((2 * p1[2]) + (-p0[2] + p2[2]) * t + (2 * p0[2] - 5 * p1[2] + 4 * p2[2] - p3[2]) * t2 + (-p0[2] + 3 * p1[2] - 3 * p2[2] + p3[2]) * t3)
                return x, y
            end


            local function Ease(style, t)
                t = math.clamp(t, 0, 1)
                style = string.lower(style or "linear")
                if style == "linear" then
                    return t
                elseif style == "sine" then
                    return 0.5 * math.sin((t - 0.5) * math.pi) + 0.5
                elseif style == "quad" then
                    if t < 0.5 then return 2 * t * t end
                    return 1 - 2 * (1 - t) * (1 - t)
                elseif style == "quart" then
                    if t < 0.5 then return 8 * t * t * t * t end
                    local u = 1 - t
                    return 1 - 8 * u * u * u * u
                elseif style == "quint" then
                    if t < 0.5 then return 16 * t * t * t * t * t end
                    local u = 1 - t
                    return 1 - 16 * u * u * u * u * u
                elseif style == "exponential" or style == "expo" then
                    if t == 0 then return 0 end
                    if t == 1 then return 1 end
                    if t < 0.5 then return 0.5 * (2 ^ (20 * t - 10)) end
                    return 1 - 0.5 * (2 ^ (-20 * t + 10))
                elseif style == "back" then
                    local s = 1.70158 * 1.525
                    if t < 0.5 then
                        return 0.5 * ((2 * t) * (2 * t) * ((s + 1) * 2 * t - s))
                    end
                    local u = 2 * t - 2
                    return 0.5 * (u * u * ((s + 1) * u + s) + 2)
                elseif style == "bounce" then
                    local function bout(x)
                        if x < 1 / 2.75 then return 7.5625 * x * x
                        elseif x < 2 / 2.75 then
                            x = x - 1.5 / 2.75
                            return 7.5625 * x * x + 0.75
                        elseif x < 2.5 / 2.75 then
                            x = x - 2.25 / 2.75
                            return 7.5625 * x * x + 0.9375
                        else
                            x = x - 2.625 / 2.75
                            return 7.5625 * x * x + 0.984375
                        end
                    end
                    if t < 0.5 then return 0.5 * (1 - bout(1 - 2 * t)) end
                    return 0.5 * bout(2 * t - 1) + 0.5
                elseif style == "elastic" then
                    if t == 0 or t == 1 then return t end
                    if t < 0.5 then
                        return -0.5 * (2 ^ (20 * t - 10)) * math.sin((20 * t - 11.125) * (2 * math.pi) / 4.5)
                    end
                    return (2 ^ (-20 * t + 10)) * math.sin((20 * t - 11.125) * (2 * math.pi) / 4.5) * 0.5 + 1
                elseif style == "circular" or style == "circ" then
                    if t < 0.5 then return 0.5 * (1 - math.sqrt(1 - (2 * t) * (2 * t))) end
                    return 0.5 * (math.sqrt(1 - (-2 * t + 2) * (-2 * t + 2)) + 1)
                elseif style == "cubic" then
                    if t < 0.5 then return 4 * t * t * t end
                    return 1 - (-2 * t + 2) * (-2 * t + 2) * (-2 * t + 2) / 2
                end
                return t
            end

            -- Playhead state (0..1 normalized X) — auto sweeps left -> right
            Cfg.PlayheadX = 0
            Cfg.DraggingPlayhead = false
            Cfg.PlayheadPaused = false

            local function evaluateY(normX)
                -- normX is 0..1 across the canvas
                local size = Items.Canvas.Instance.AbsoluteSize
                if size.X < 4 then return 0.5 end

                local pts = {}
                for _, p in ipairs(Cfg.Points) do
                    local sx, sy = toScreen(p.X, p.Y, size)
                    table.insert(pts, {sx, sy, p.X, p.Y})
                end
                if #pts < 2 then return 0.5 end

                local targetX = normX * size.X

                local style = Cfg.Interpolation or "Linear"
                if style == "Linear" then
                    for i = 1, #pts - 1 do
                        local a, b = pts[i], pts[i+1]
                        if targetX >= a[1] and targetX <= b[1] then
                            local t = (targetX - a[1]) / math.max(b[1] - a[1], 0.001)
                            return a[2] + (b[2] - a[2]) * t
                        end
                    end
                    if targetX <= pts[1][1] then return pts[1][2] end
                    return pts[#pts][2]
                elseif style == "Cubic" then
                    for i = 1, #pts - 1 do
                        local p0 = pts[math.max(i - 1, 1)]
                        local p1 = pts[i]
                        local p2 = pts[i + 1]
                        local p3 = pts[math.min(i + 2, #pts)]
                        if targetX >= p1[1] and targetX <= p2[1] then
                            local t = (targetX - p1[1]) / math.max(p2[1] - p1[1], 0.001)
                            local _, y = cubic(p0, p1, p2, p3, t)
                            return y
                        end
                    end
                    if targetX <= pts[1][1] then return pts[1][2] end
                    return pts[#pts][2]
                else
                    -- Eased: X still progresses linearly along segment, Y is eased
                    for i = 1, #pts - 1 do
                        local a, b = pts[i], pts[i+1]
                        if targetX >= a[1] and targetX <= b[1] then
                            local tLin = (targetX - a[1]) / math.max(b[1] - a[1], 0.001)
                            local t = Ease(style, tLin)
                            return a[2] + (b[2] - a[2]) * t
                        end
                    end
                    if targetX <= pts[1][1] then return pts[1][2] end
                    return pts[#pts][2]
                end
            end

            local function updatePlayhead()
                local size = Items.Canvas.Instance.AbsoluteSize
                if size.X < 4 then return end

                local px = Cfg.PlayheadX * size.X
                local py = evaluateY(Cfg.PlayheadX)

                Items.Playhead.Instance.Position = UDim2.new(0, px, 0, 0)
                Items.PlayheadDot.Instance.Position = UDim2.new(0, px - 3, 0, py - 3)

                -- Convert screen Y back to value for display
                local _, val = fromScreen(px, py, size)
                Items.PlayheadValue.Instance.Text = string.format("%.5f", val)
                -- Center the label roughly above the line
                Items.PlayheadValue.Instance.Position = UDim2.new(0, math.clamp(px + 10, 0, size.X - 60) , 0, 1)
            end

            local function redraw()
                clearPath()
                local size = Items.Canvas.Instance.AbsoluteSize
                if size.X < 4 or size.Y < 4 then return end

                local pts = {}
                for _, p in ipairs(Cfg.Points) do
                    local sx, sy = toScreen(p.X, p.Y, size)
                    table.insert(pts, {sx, sy})
                end
                if #pts < 2 then return end

                local style = Cfg.Interpolation or "Linear"
                if style == "Linear" then
                    for i = 1, #pts - 1 do
                        drawSegment(pts[i][1], pts[i][2], pts[i+1][1], pts[i+1][2], 1)
                    end
                elseif style == "Cubic" then
                    local steps = 56
                    for i = 1, #pts - 1 do
                        local p0 = pts[math.max(i - 1, 1)]
                        local p1 = pts[i]
                        local p2 = pts[i + 1]
                        local p3 = pts[math.min(i + 2, #pts)]
                        local px, py = p1[1], p1[2]
                        for s = 1, steps do
                            local t = s / steps
                            local x, y = cubic(p0, p1, p2, p3, t)
                            drawSegment(px, py, x, y, 1)
                            px, py = x, y
                        end
                    end
                else
                    -- Eased Y, linear X between consecutive points
                    local steps = 48
                    for i = 1, #pts - 1 do
                        local a, b = pts[i], pts[i + 1]
                        local px, py = a[1], a[2]
                        for s = 1, steps do
                            local tLin = s / steps
                            local t = Ease(style, tLin)
                            local x = a[1] + (b[1] - a[1]) * tLin
                            local y = a[2] + (b[2] - a[2]) * t
                            drawSegment(px, py, x, y, 1)
                            px, py = x, y
                        end
                    end
                end
                updatePlayhead()
            end
            Cfg._redraw = redraw

            local function makePoint(x, y)
                local size = Items.Canvas.Instance.AbsoluteSize
                local sx, sy = toScreen(x, y, size)

                -- Outer outline (white border) so stroke is always visible
                local outline = Library:Create("Frame", {
                    Parent = Items.PointHolder.Instance,
                    BackgroundColor3 = Color3.fromRGB(0, 0, 0),
                    Size = UDim2.new(0, 8, 0, 8),
                    Position = UDim2.new(0, sx - 4, 0, sy - 4),
                    BorderSizePixel = 0,
                    ZIndex = 6,
                })

                -- Inner fill (accent)
                local fill = Library:Create("Frame", {
                    Parent = outline.Instance,
                    BackgroundColor3 = Themes.Preset.Accent,
                    Size = UDim2.new(1, -2, 1, -2),
                    Position = UDim2.new(0, 1, 0, 1),
                    BorderSizePixel = 0,
                    ZIndex = 7,
                }):Themify("Accent", "BackgroundColor3")

                -- Clickable hit area
                local btn = Library:Create("TextButton", {
                    Parent = outline.Instance,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 1, 0),
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 8,
                })

                local data = { X = x, Y = y, Instance = outline.Instance }

                btn.Instance.MouseButton1Down:Connect(function()
                    Cfg.Selected = data
                    Cfg.Dragging = true
                    Items.Coord.Instance.Visible = true
                    Items.Coord.Instance.Text = string.format("%.2f, %.2f", x, y)
                end)

                table.insert(Cfg.Points, data)
                return data
            end

            local function rebuild(tbl)
                for _, p in ipairs(Cfg.Points) do
                    if p.Instance then p.Instance:Destroy() end
                end
                Cfg.Points = {}
                for _, pt in ipairs(tbl) do
                    makePoint(pt[1], pt[2])
                end
                task.defer(redraw)
            end

            local function push()
                local out = {}
                for _, p in ipairs(Cfg.Points) do
                    table.insert(out, {p.X, p.Y})
                end
                Flags[Cfg.Flag] = out
                Cfg.Callback(out)
            end

            -- ========== Input ==========
            Library:Connect(Services.UserInputService.InputChanged, function(input)
                if not Cfg.Dragging or not Cfg.Selected then return end
                if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end

                local abs = Items.Canvas.Instance.AbsolutePosition
                local size = Items.Canvas.Instance.AbsoluteSize
                if size.X < 4 then return end

                local mx = math.clamp(input.Position.X - abs.X, 0, size.X)
                local my = math.clamp(input.Position.Y - abs.Y, 0, size.Y)

                local x, y = fromScreen(mx, my, size)
                Cfg.Selected.X = x
                Cfg.Selected.Y = y
                Cfg.Selected.Instance.Position = UDim2.new(0, mx - 4, 0, my - 4)
                Items.Coord.Instance.Text = string.format("%.2f, %.2f", x, y)
                redraw()
            end)

            Library:Connect(Services.UserInputService.InputEnded, function(input)
                if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and Cfg.Dragging then
                    Cfg.Dragging = false
                    Items.Coord.Instance.Visible = false
                    push()
                end
            end)

            Items.AddBtn.Callback = function()
                local last = Cfg.Points[#Cfg.Points]
                local nx = last and math.min(last.X + (Cfg.MaxX - Cfg.MinX) * 0.18, Cfg.MaxX) or 0
                local ny = last and last.Y or 0
                makePoint(nx, ny)
                redraw()
                push()
            end

            Items.RemoveBtn.Callback = function()
                if #Cfg.Points <= 2 then return end
                local target = Cfg.Selected or Cfg.Points[#Cfg.Points]
                if target and target.Instance then
                    target.Instance:Destroy()
                    for i, p in ipairs(Cfg.Points) do
                        if p == target then
                            table.remove(Cfg.Points, i)
                            break
                        end
                    end
                    Cfg.Selected = nil
                    redraw()
                    push()
                end
            end


            function Cfg.Set(points)
                if type(points) ~= "table" then return end
                -- Normalize after JSON load (ensure sequential {x,y} number pairs)
                local normalized = {}
                for i = 1, #points do
                    local pt = points[i]
                    if type(pt) == "table" then
                        local x = tonumber(pt[1] or pt["1"] or pt.x or pt.X)
                        local y = tonumber(pt[2] or pt["2"] or pt.y or pt.Y)
                        if x ~= nil and y ~= nil then
                            normalized[#normalized + 1] = {x, y}
                        end
                    end
                end
                if #normalized == 0 then
                    -- pairs fallback for non-sequential JSON tables
                    for _, pt in pairs(points) do
                        if type(pt) == "table" then
                            local x = tonumber(pt[1] or pt["1"] or pt.x or pt.X)
                            local y = tonumber(pt[2] or pt["2"] or pt.y or pt.Y)
                            if x ~= nil and y ~= nil then
                                normalized[#normalized + 1] = {x, y}
                            end
                        end
                    end
                    table.sort(normalized, function(a, b) return a[1] < b[1] end)
                end
                if #normalized < 2 then
                    normalized = Cfg.Default or { {-1, -1}, {1, 1} }
                end
                rebuild(normalized)
                Flags[Cfg.Flag] = normalized
                Cfg.Callback(normalized)
            end

            function Cfg.Get()
                return Flags[Cfg.Flag]
            end

            Items.Canvas.Instance:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                local size = Items.Canvas.Instance.AbsoluteSize
                if size.X < 4 then return end
                for _, p in ipairs(Cfg.Points) do
                    local sx, sy = toScreen(p.X, p.Y, size)
                    p.Instance.Position = UDim2.new(0, sx - 4, 0, sy - 4)
                end
                redraw()
            end)

            -- Build densely sampled path points for follow / follow 2
            -- Cached so we do not rebuild every frame (stable arc length)
            local pathCache = {
                key = "",
                samples = {},
                totalLen = 0,
                cum = {0},
            }

            local function pathCacheKey()
                local size = Items.Canvas.Instance.AbsoluteSize
                local parts = {
                    tostring(math.floor(size.X + 0.5)),
                    tostring(math.floor(size.Y + 0.5)),
                    tostring(Cfg.Interpolation or "Linear"),
                    tostring(#Cfg.Points),
                }
                for _, p in ipairs(Cfg.Points) do
                    parts[#parts + 1] = string.format("%.4f:%.4f", p.X, p.Y)
                end
                return table.concat(parts, "|")
            end

            local function buildPathSamples()
                local key = pathCacheKey()
                if pathCache.key == key and #pathCache.samples >= 2 then
                    return pathCache.samples, pathCache.totalLen, pathCache.cum
                end

                local size = Items.Canvas.Instance.AbsoluteSize
                local samples = {}
                if size.X < 4 or #Cfg.Points < 2 then
                    pathCache.key = key
                    pathCache.samples = samples
                    pathCache.totalLen = 0
                    pathCache.cum = {0}
                    return samples, 0, {0}
                end

                local pts = {}
                for _, p in ipairs(Cfg.Points) do
                    local sx, sy = toScreen(p.X, p.Y, size)
                    table.insert(pts, {sx, sy})
                end

                local style = Cfg.Interpolation or "Linear"
                -- denser samples → smoother constant-speed arc approximation
                local stepsPerSeg = 48
                for i = 1, #pts - 1 do
                    local a, b = pts[i], pts[i + 1]
                    for s = 0, stepsPerSeg do
                        local t = s / stepsPerSeg
                        local x, y
                        if style == "Cubic" then
                            local p0 = pts[math.max(i - 1, 1)]
                            local p3 = pts[math.min(i + 2, #pts)]
                            x, y = cubic(p0, a, b, p3, t)
                        elseif style == "Linear" then
                            x = a[1] + (b[1] - a[1]) * t
                            y = a[2] + (b[2] - a[2]) * t
                        else
                            local e = Ease(style, t)
                            x = a[1] + (b[1] - a[1]) * t
                            y = a[2] + (b[2] - a[2]) * e
                        end
                        if not (#samples > 0 and s == 0) then
                            table.insert(samples, {x, y})
                        elseif #samples == 0 then
                            table.insert(samples, {x, y})
                        end
                    end
                end

                local totalLen = 0
                local cum = {0}
                for i = 2, #samples do
                    local dx = samples[i][1] - samples[i - 1][1]
                    local dy = samples[i][2] - samples[i - 1][2]
                    totalLen = totalLen + math.sqrt(dx * dx + dy * dy)
                    cum[i] = totalLen
                end

                pathCache.key = key
                pathCache.samples = samples
                pathCache.totalLen = totalLen
                pathCache.cum = cum
                return samples, totalLen, cum
            end

            -- follow: parameter 0..1 along sample index (non-constant speed)
            local function samplePath(u)
                local samples = buildPathSamples()
                if #samples < 2 then return 0.5, 0.5 end
                u = math.clamp(u, 0, 1)
                local idx = u * (#samples - 1)
                local i = math.clamp(math.floor(idx) + 1, 1, #samples - 1)
                local t = idx - (i - 1)
                local a, b = samples[i], samples[i + 1]
                return a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t
            end

            -- follow 2: true arc-length sampling (constant linear speed along the curve)
            local function samplePathArc(dist)
                local samples, totalLen, cum = buildPathSamples()
                if #samples < 2 or totalLen < 1e-6 then
                    return 0.5, 0.5
                end

                -- wrap into [0, totalLen)
                dist = dist % totalLen
                if dist < 0 then
                    dist = dist + totalLen
                end

                -- binary search on cumulative length
                local lo, hi = 2, #samples
                while lo < hi do
                    local mid = math.floor((lo + hi) * 0.5)
                    if cum[mid] < dist then
                        lo = mid + 1
                    else
                        hi = mid
                    end
                end

                local i = lo
                local segLen = cum[i] - cum[i - 1]
                local t = (segLen > 1e-9) and ((dist - cum[i - 1]) / segLen) or 0
                t = math.clamp(t, 0, 1)
                local a, b = samples[i - 1], samples[i]
                return a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t
            end

            local function setPlayheadAt(px, py, size)
                Cfg.PlayheadX = px / math.max(size.X, 1)
                Items.Playhead.Instance.Position = UDim2.new(0, px, 0, 0)
                Items.PlayheadDot.Instance.Position = UDim2.new(0, px - 3, 0, py - 3)
                local _, val = fromScreen(px, py, size)
                Items.PlayheadValue.Instance.Text = string.format("%.5f", val)
                Items.PlayheadValue.Instance.Position = UDim2.new(0, math.clamp(px + 10, 0, size.X - 60), 0, 1)
            end

            -- scan = X sweep
            -- follow = along path by sample parameter (can slow on dense / curved regions)
            -- follow 2 = along path by arc length (constant linear speed)
            Cfg.PlayheadT = 0
            Cfg.PlayheadDist = 0
            Library:Connect(Services.RunService.RenderStepped, function(dt)
                if not Items.Object or not Items.Object.Instance or not Items.Object.Instance.Parent then
                    return
                end
                if Cfg.PlayheadPaused then
                    return
                end

                local speed = Cfg.PlayheadSpeed or 0.35
                local size = Items.Canvas.Instance.AbsoluteSize
                if size.X < 4 then return end

                local mode = Cfg.PlayheadMode or "scan"
                if mode == "follow" then
                    Cfg.PlayheadT = Cfg.PlayheadT + speed * dt
                    if Cfg.PlayheadT >= 1 then
                        Cfg.PlayheadT = Cfg.PlayheadT - math.floor(Cfg.PlayheadT)
                    end
                    local px, py = samplePath(Cfg.PlayheadT)
                    setPlayheadAt(px, py, size)
                elseif mode == "follow 2" then
                    local _, totalLen = buildPathSamples()
                    if totalLen < 1e-6 then return end
                    -- Fixed linear speed in screen pixels/sec along the curve.
                    -- NOT scaled by totalLen or point count — longer paths just take longer.
                    -- Matched to scan's horizontal pixel rate (speed * canvas width).
                    local pxPerSec = speed * size.X
                    Cfg.PlayheadDist = Cfg.PlayheadDist + pxPerSec * dt
                    if Cfg.PlayheadDist >= totalLen or Cfg.PlayheadDist < 0 then
                        Cfg.PlayheadDist = Cfg.PlayheadDist % totalLen
                        if Cfg.PlayheadDist < 0 then
                            Cfg.PlayheadDist = Cfg.PlayheadDist + totalLen
                        end
                    end
                    local px, py = samplePathArc(Cfg.PlayheadDist)
                    setPlayheadAt(px, py, size)
                else
                    Cfg.PlayheadX = Cfg.PlayheadX + speed * dt
                    if Cfg.PlayheadX >= 1 then
                        Cfg.PlayheadX = Cfg.PlayheadX - math.floor(Cfg.PlayheadX)
                    end
                    if updatePlayhead then updatePlayhead() end
                end
            end)

            task.delay(0.05, function()
                Cfg.Set(Cfg.Default)
            end)

            -- Must register ConfigFlags on the curve element itself (not the parent Section)
            setmetatable(Cfg, Library)
            Cfg:SetupElement(Cfg.Default)
            return Cfg
        end

