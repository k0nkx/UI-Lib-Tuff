        Library.GetAssetList = function(self)
            local List = {}
            local Folder = Library.Directory .. "/Assets"

            if not isfolder(Folder) then
                makefolder(Folder)
            end

            local Ok, Files = pcall(listfiles, Folder)
            if not Ok or not Files then
                return List
            end

            for _, File in Files do
                local Name = File
                    :gsub(Folder .. "\\", "")
                    :gsub(Folder .. "/", "")
                    :gsub(Library.Directory .. "/Assets\\", "")
                    :gsub(Library.Directory .. "\\Assets\\", "")
                    :gsub(Library.Directory .. "/Assets/", "")

                local Lower = string.lower(Name)
                for Ext in pairs(AssetExtensions) do
                    if string.sub(Lower, -#Ext) == Ext then
                        List[#List + 1] = Name
                        break
                    end
                end
            end

            table.sort(List)
            return List
        end

