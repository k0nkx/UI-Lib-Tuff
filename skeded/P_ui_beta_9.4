if getgenv().Library and getgenv().Library.Unload then
    getgenv().Library:Unload()
end

local Library; do
    Library = {
        Directory = "Atlanta",
        Folders = {
            "/Fonts",
            "/Configs",
            "/Themes",
            "/Assets",
            "/CachedModels",
        },

        Flags = {},
        ConfigFlags = {},
        FlagCount = 0;
        Connections = {},
        Threads = {},
        Blurs = {},
        Elements = {},
        Notifications = {},

        OpenElement = {},
        Moderators = {},
        Keybinds = {},
        Guis = {},
        Glows = {}, 

        EasingDirection = Enum.EasingDirection.InOut,
        EasingStyle = Enum.EasingStyle.Quint,
        TweeningSpeed = .3,
        DraggingSpeed = .05,
        Tweening = false,
    };  
    
    Library.__index = Library;
    getgenv().Library = Library

    for _, path in Library.Folders do
        makefolder(Library.Directory .. path)
    end

    if not isfile(Library.Directory .. "/Autoload.txt") then
        writefile(Library.Directory .. "/Autoload.txt", "")
    end

    -- =====================================================================
    -- Loading UI (shown immediately while the rest of the library boots)
    -- Watermark-style panel, ProggyClean font (same as main UI), 1s fade in/out
    -- =====================================================================
    do
        local ACCENT = Color3.fromRGB(222, 162, 193)
        local OUTLINE = Color3.fromRGB(1, 1, 1)
        local INLINE = Color3.fromRGB(54, 54, 54)
        local HIGH = Color3.fromRGB(38, 38, 38)
        local LOW = Color3.fromRGB(25, 25, 25)
        local TEXT_MAIN = Color3.fromRGB(160, 160, 160)
        local TEXT_MISC = Color3.fromRGB(134, 134, 134)

        local FADE_IN = 1
        local FADE_OUT = 1
        local HOLD_AFTER_READY = 2

        local function parentGui()
            local ok, core = pcall(function()
                return game:GetService("CoreGui")
            end)
            if ok and core then
                return core
            end
            local lp = game:GetService("Players").LocalPlayer
            return lp:WaitForChild("PlayerGui")
        end

        -- Load the same font the library uses (ProggyClean) so text is sharp
        local LoaderFont = Font.fromEnum(Enum.Font.Code) -- fallback until custom loads
        pcall(function()
            local dir = (Library.Directory or "Atlanta") .. "/Fonts"
            if not isfolder(dir) then
                makefolder(dir)
            end
            local ttf = dir .. "/ProggyClean"
            if not isfile(ttf) then
                writefile(ttf, game:HttpGet("https://github.com/i77lhm/storage/raw/refs/heads/main/fonts/ProggyClean.ttf"))
            end
            local fontJson = dir .. "/ProggyClean_Loader.font"
            local payload = {
                name = "ProggyClean",
                faces = {{
                    name = "ProggyClean",
                    weight = 400,
                    style = "Regular",
                    assetId = getcustomasset(ttf),
                }},
            }
            writefile(fontJson, game:GetService("HttpService"):JSONEncode(payload))
            LoaderFont = Font.new(getcustomasset(fontJson))
        end)

        local gui = Instance.new("ScreenGui")
        gui.Name = "\0"
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 10^9
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        gui.ResetOnSpawn = false
        pcall(function()
            gui.Parent = parentGui()
        end)

        -- Dim backdrop (starts fully transparent → fades in)
        local dim = Instance.new("Frame")
        dim.Name = "\0"
        dim.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        dim.BackgroundTransparency = 1
        dim.BorderSizePixel = 0
        dim.Size = UDim2.fromScale(1, 1)
        dim.Parent = gui

        -- CanvasGroup panel for clean GroupTransparency fades
        local panel = Instance.new("CanvasGroup")
        panel.Name = "\0"
        panel.AnchorPoint = Vector2.new(0.5, 0.5)
        panel.Position = UDim2.fromScale(0.5, 0.5)
        panel.Size = UDim2.fromOffset(260, 0)
        panel.AutomaticSize = Enum.AutomaticSize.Y
        panel.BackgroundColor3 = OUTLINE
        panel.BorderSizePixel = 0
        panel.GroupTransparency = 1
        panel.Parent = gui

        -- top accent line (watermark-style)
        local accentLine = Instance.new("Frame")
        accentLine.Name = "\0"
        accentLine.Position = UDim2.new(0, 2, 0, 2)
        accentLine.Size = UDim2.new(1, -4, 0, 1)
        accentLine.BackgroundColor3 = ACCENT
        accentLine.BorderSizePixel = 0
        accentLine.ZIndex = 2
        accentLine.Parent = panel

        local inline = Instance.new("Frame")
        inline.Name = "\0"
        inline.Position = UDim2.fromOffset(1, 1)
        inline.Size = UDim2.new(1, -2, 0, 0)
        inline.AutomaticSize = Enum.AutomaticSize.Y
        inline.BackgroundColor3 = INLINE
        inline.BorderSizePixel = 0
        inline.Parent = panel

        local inlinePad = Instance.new("UIPadding")
        inlinePad.PaddingBottom = UDim.new(0, 2)
        inlinePad.Parent = inline

        local bg = Instance.new("Frame")
        bg.Name = "\0"
        bg.Position = UDim2.fromOffset(1, 1)
        bg.Size = UDim2.new(1, -2, 0, 0)
        bg.AutomaticSize = Enum.AutomaticSize.Y
        bg.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        bg.BorderSizePixel = 0
        bg.Parent = inline

        local grad = Instance.new("UIGradient")
        grad.Rotation = 90
        grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, HIGH),
            ColorSequenceKeypoint.new(1, LOW),
        })
        grad.Parent = bg

        local bgPad = Instance.new("UIPadding")
        bgPad.PaddingTop = UDim.new(0, 8)
        bgPad.PaddingBottom = UDim.new(0, 8)
        bgPad.PaddingLeft = UDim.new(0, 8)
        bgPad.PaddingRight = UDim.new(0, 8)
        bgPad.Parent = bg

        local content = Instance.new("Frame")
        content.Name = "\0"
        content.BackgroundTransparency = 1
        content.Size = UDim2.new(1, 0, 0, 0)
        content.AutomaticSize = Enum.AutomaticSize.Y
        content.Parent = bg

        local list = Instance.new("UIListLayout")
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.Padding = UDim.new(0, 6)
        list.Parent = content

        local title = Instance.new("TextLabel")
        title.Name = "\0"
        title.BackgroundTransparency = 1
        title.Size = UDim2.new(1, 0, 0, 14)
        title.FontFace = LoaderFont
        title.TextSize = 12
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextColor3 = ACCENT
        title.RichText = true
        title.LayoutOrder = 1
        title.Text = string.format(
            'perona<font color="rgb(255, 255, 255)">hax</font> <font color="rgb(%d,%d,%d)">|</font> <font color="rgb(%d,%d,%d)">loading</font>',
            math.round(TEXT_MISC.R * 255), math.round(TEXT_MISC.G * 255), math.round(TEXT_MISC.B * 255),
            math.round(TEXT_MAIN.R * 255), math.round(TEXT_MAIN.G * 255), math.round(TEXT_MAIN.B * 255)
        )
        title.Parent = content

        local titleStroke = Instance.new("UIStroke")
        titleStroke.LineJoinMode = Enum.LineJoinMode.Miter
        titleStroke.Parent = title

        local status = Instance.new("TextLabel")
        status.Name = "\0"
        status.BackgroundTransparency = 1
        status.Size = UDim2.new(1, 0, 0, 14)
        status.FontFace = LoaderFont
        status.TextSize = 12
        status.TextXAlignment = Enum.TextXAlignment.Left
        status.TextColor3 = TEXT_MAIN
        status.Text = "Initializing..."
        status.LayoutOrder = 2
        status.Parent = content

        local track = Instance.new("Frame")
        track.Name = "\0"
        track.Size = UDim2.new(1, 0, 0, 4)
        track.BackgroundColor3 = OUTLINE
        track.BorderSizePixel = 0
        track.LayoutOrder = 3
        track.Parent = content

        local trackInline = Instance.new("Frame")
        trackInline.Name = "\0"
        trackInline.Position = UDim2.fromOffset(1, 1)
        trackInline.Size = UDim2.new(1, -2, 1, -2)
        trackInline.BackgroundColor3 = Color3.fromRGB(17, 17, 17)
        trackInline.BorderSizePixel = 0
        trackInline.Parent = track

        local fill = Instance.new("Frame")
        fill.Name = "\0"
        fill.Size = UDim2.new(0.08, 0, 1, 0)
        fill.BackgroundColor3 = ACCENT
        fill.BorderSizePixel = 0
        fill.Parent = trackInline

        local pct = Instance.new("TextLabel")
        pct.Name = "\0"
        pct.BackgroundTransparency = 1
        pct.Size = UDim2.new(1, 0, 0, 12)
        pct.FontFace = LoaderFont
        pct.TextSize = 12
        pct.TextXAlignment = Enum.TextXAlignment.Right
        pct.TextColor3 = TEXT_MISC
        pct.Text = "0%"
        pct.LayoutOrder = 4
        pct.Parent = content

        Library._Loading = {
            Gui = gui,
            Dim = dim,
            Panel = panel,
            Outline = panel, -- alias for older refs
            Status = status,
            Fill = fill,
            Percent = pct,
            Accent = ACCENT,
            Visible = true,
            Progress = 0.08,
            Hiding = false,
            ReadyAt = nil,
        }

        -- Fade in (1s)
        task.spawn(function()
            local TweenService = game:GetService("TweenService")
            local info = TweenInfo.new(FADE_IN, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
            pcall(function()
                TweenService:Create(dim, info, {BackgroundTransparency = 0.45}):Play()
                TweenService:Create(panel, info, {GroupTransparency = 0}):Play()
            end)
        end)

        Library.SetLoadingStatus = function(self, text)
            local L = self._Loading
            if not L or not L.Status then
                return
            end
            L.Status.Text = tostring(text or "")
        end

        Library.SetLoadingProgress = function(self, value)
            local L = self._Loading
            if not L or not L.Fill or L.Hiding then
                return
            end
            value = math.clamp(tonumber(value) or 0, 0, 1)
            -- Never let the indeterminate pulse pull progress backwards once real progress started
            if value < (L.Progress or 0) and value < 0.15 and (L.Progress or 0) >= 0.15 then
                return
            end
            L.Progress = value
            L.Fill.Size = UDim2.new(value, 0, 1, 0)
            if L.Percent then
                L.Percent.Text = string.format("%d%%", math.floor(value * 100 + 0.5))
            end
        end

        -- Reveal main UI after loader is fully gone
        Library._RevealUIAfterLoad = function(self)
            pcall(function()
                if Library.Items and Library.Items.Instance then
                    Library.Items.Instance.Enabled = true
                end
                if Library.HUD and Library.HUD.Instance then
                    Library.HUD.Instance.Enabled = true
                end
                if Library.Elements and Library.Elements.Instance then
                    Library.Elements.Instance.Enabled = true
                end
                if Library.Window and Library.Window.Items and Library.Window.Items.Menu then
                    local menu = Library.Window.Items.Menu.Instance
                    if menu then
                        menu.Visible = true
                    end
                end
            end)
        end

        Library.HideLoading = function(self, instant)
            local L = self._Loading
            if not L or not L.Visible or L.Hiding then
                return
            end
            L.Hiding = true
            L.Visible = false

            -- Force 100% so the bar never stays stuck at the pulse value while "Ready" is shown
            pcall(function()
                L.Progress = 1
                if L.Fill then
                    L.Fill.Size = UDim2.new(1, 0, 1, 0)
                end
                if L.Percent then
                    L.Percent.Text = "100%"
                end
            end)

            local function destroy()
                if L.Gui then
                    pcall(function()
                        L.Gui:Destroy()
                    end)
                end
                self._Loading = nil
                -- Main UI shows only after loader is fully destroyed
                pcall(function()
                    self:_RevealUIAfterLoad()
                end)
            end

            if instant then
                destroy()
                return
            end

            task.spawn(function()
                -- Hold on "Ready" so the user can read it
                task.wait(HOLD_AFTER_READY)

                local TweenService = game:GetService("TweenService")
                local info = TweenInfo.new(FADE_OUT, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
                pcall(function()
                    if L.Dim then
                        TweenService:Create(L.Dim, info, {BackgroundTransparency = 1}):Play()
                    end
                    if L.Panel then
                        TweenService:Create(L.Panel, info, {GroupTransparency = 1}):Play()
                    end
                end)
                task.wait(FADE_OUT + 0.05)
                destroy()
            end)
        end

        -- subtle indeterminate pulse until real progress arrives
        task.spawn(function()
            local t = 0
            while true do
                local L = Library._Loading
                if not L or not L.Visible or L.Hiding or (L.Progress or 0) >= 0.15 then
                    break
                end
                t = t + task.wait()
                -- Re-check after yield so we never overwrite a real progress / Ready value
                L = Library._Loading
                if not L or not L.Visible or L.Hiding or (L.Progress or 0) >= 0.15 then
                    break
                end
                local pulse = 0.08 + (math.sin(t * 3) * 0.5 + 0.5) * 0.07
                pcall(function()
                    Library:SetLoadingProgress(pulse)
                end)
            end
        end)
    end

    local Flags = Library.Flags
