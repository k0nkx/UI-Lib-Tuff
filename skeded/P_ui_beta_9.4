        -- Local texture overrides: Atlanta/CachedModels/texture_ids/<modelname>/*.webp
        -- Filename format: "TextureName -- 123456789.webp" (ID matched from rbxmx TextureIds)
        -- Also auto-downloaded from repo textures/<ModelName>/ during SyncPreviewModelsFromGitHub
        Library.GetTextureIdsFolder = function(self, ModelName)
            ModelName = tostring(ModelName or ""):gsub("%.rbxmx$", ""):gsub("%.RBXMX$", "")
            if ModelName == "" then
                return nil
            end
            local base = self:GetCachedModelsFolder()
            local candidates = {
                string.format("%s/texture_ids/%s", base, ModelName),
                string.format("%s\\texture_ids\\%s", base, ModelName),
                string.format("%s/texture_ids/%s", base, string.lower(ModelName)),
                string.format("%s\\texture_ids\\%s", base, string.lower(ModelName)),
            }
            for _, folder in ipairs(candidates) do
                if isfolder and isfolder(folder) then
                    return folder
                end
            end
            return candidates[1]
        end

        Library.ExtractTextureId = function(self, value)
            if value == nil then
                return nil
            end
            local s = tostring(value)
            -- rbxassetid://123, rbxasset://textures/..., plain number, http urls ending in id
            local id = s:match("rbxassetid://(%d+)")
                or s:match("id=(%d+)")
                or s:match("/(%d+)$")
                or s:match("^(%d+)$")
            return id
        end

        -- Returns map: [ "123456789" ] = getcustomasset(path)
        Library.BuildLocalTextureMap = function(self, ModelName)
            local map = {}
            local folder = self:GetTextureIdsFolder(ModelName)
            if not folder or not (isfolder and isfolder(folder)) then
                return map
            end
            if not listfiles then
                return map
            end
            local ok, files = pcall(listfiles, folder)
            if not ok or type(files) ~= "table" then
                return map
            end
            for _, file in ipairs(files) do
                local path = tostring(file)
                local name = path:gsub("\\", "/"):match("([^/]+)$") or ""
                -- "Anything -- 123456789.webp" (flexible spaces around --)
                local texId = name:match("%-%-%s*(%d+)%s*%.webp$")
                    or name:match("%-%-%s*(%d+)%s*%.WEBP$")
                    or name:match("%-%-%s*(%d+)%s*%.png$")
                    or name:match("%-%-%s*(%d+)%s*%.jpg$")
                    or name:match("%-%-%s*(%d+)%s*%.jpeg$")
                if texId and getcustomasset then
                    local okAsset, asset = pcall(getcustomasset, path)
                    if okAsset and asset and asset ~= "" then
                        map[texId] = asset
                    end
                end
            end
            return map
        end

        -- Walk model and replace texture properties whose asset id exists in the local map
        Library.ApplyLocalTexturesToModel = function(self, model, ModelName)
            if not model then
                return 0
            end
            ModelName = ModelName
                or (Library.PreviewModel and (Library.PreviewModel.Name or Library.PreviewModel.AssetId))
                or ""
            local map = self:BuildLocalTextureMap(ModelName)
            if not next(map) then
                return 0
            end

            local replaced = 0
            local function tryReplace(inst, prop)
                local ok, current = pcall(function()
                    return inst[prop]
                end)
                if not ok or current == nil or current == "" then
                    return
                end
                local id = self:ExtractTextureId(current)
                if id and map[id] then
                    local setOk = pcall(function()
                        inst[prop] = map[id]
                    end)
                    if setOk then
                        replaced = replaced + 1
                    end
                end
            end

            for _, desc in ipairs(model:GetDescendants()) do
                if desc:IsA("MeshPart") then
                    tryReplace(desc, "TextureID")
                elseif desc:IsA("SpecialMesh") then
                    tryReplace(desc, "TextureId")
                elseif desc:IsA("Decal") or desc:IsA("Texture") then
                    tryReplace(desc, "Texture")
                elseif desc:IsA("SurfaceAppearance") then
                    tryReplace(desc, "ColorMap")
                    tryReplace(desc, "MetalnessMap")
                    tryReplace(desc, "NormalMap")
                    tryReplace(desc, "RoughnessMap")
                elseif desc:IsA("Shirt") or desc:IsA("Pants") then
                    tryReplace(desc, "ShirtTemplate")
                    tryReplace(desc, "PantsTemplate")
                elseif desc:IsA("ShirtGraphic") then
                    tryReplace(desc, "Graphic")
                elseif desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
                    tryReplace(desc, "Image")
                end
            end
            -- also check the model root itself (rare)
            if model:IsA("MeshPart") then
                tryReplace(model, "TextureID")
            end
            return replaced
        end

        Library.GetCachedModelPath = function(self, AssetId)
            AssetId = tostring(AssetId or (Library.PreviewModel and Library.PreviewModel.AssetId) or "")
            -- strip extension if passed
            AssetId = AssetId:gsub("%.rbxmx$", ""):gsub("%.RBXMX$", "")
            local base = Library.Directory or "Atlanta"
            local pathFwd = string.format("%s/CachedModels/%s.rbxmx", base, AssetId)
            local pathBack = string.format("%s\\CachedModels\\%s.rbxmx", base, AssetId)
            if isfile and isfile(pathFwd) then
                return pathFwd
            end
            if isfile and isfile(pathBack) then
                return pathBack
            end
            return pathFwd
        end

        -- Resolve a real on-disk path for a model name/asset id (handles path separators & case)
        Library.ResolveCachedModelPath = function(self, NameOrAssetId)
            if not NameOrAssetId or NameOrAssetId == "" then
                return nil
            end
            local key = tostring(NameOrAssetId):gsub("%.rbxmx$", ""):gsub("%.RBXMX$", "")
            -- registry AssetId
            for _, entry in ipairs(Library.PreviewModels or {}) do
                if entry.Name == key or tostring(entry.AssetId) == key then
                    key = tostring(entry.AssetId)
                    break
                end
            end
            local direct = self:GetCachedModelPath(key)
            if isfile and isfile(direct) then
                return direct, key
            end
            -- scan folder for matching filename (case-insensitive)
            local files = self:ListCachedModelFiles()
            local keyLower = string.lower(key)
            for _, file in ipairs(files) do
                local base = self:CachedModelFileBaseName(file)
                if base and string.lower(base) == keyLower then
                    return file, base
                end
            end
            return direct, key
        end

        Library.CachedModelFileBaseName = function(self, filePath)
            if not filePath then
                return nil
            end
            local normalized = tostring(filePath):gsub("\\", "/")
            local name = normalized:match("([^/]+)%.[Rr][Bb][Xx][Mm][Xx]$")
            return name
        end

        Library.ListCachedModelFiles = function(self)
            self:EnsureCachedModelsFolder()
            local results = {}
            local seen = {}
            local base = Library.Directory or "Atlanta"
            local candidates = {
                base .. "/CachedModels",
                base .. "\\CachedModels",
                "Atlanta/CachedModels",
                "Atlanta\\CachedModels",
            }
            for _, folder in ipairs(candidates) do
                local ok, files = pcall(function()
                    if listfiles then
                        return listfiles(folder)
                    end
                    return nil
                end)
                if ok and type(files) == "table" then
                    for _, file in ipairs(files) do
                        local path = tostring(file)
                        local baseName = self:CachedModelFileBaseName(path)
                        if baseName then
                            local key = string.lower(baseName)
                            if not seen[key] then
                                seen[key] = true
                                results[#results + 1] = path
                            end
                        end
                    end
                end
            end
            return results
        end

        -- Per-file config stored as Lua-style comments at the top of the .rbxmx:
        -- origin_x:0
        -- origin_y:2.85
        -- origin_z:0
        -- display_size:9.3
        Library.DefaultPreviewMeta = function(self)
            return {
                OriginX = 0,
                OriginY = 2.85,
                OriginZ = 0,
                DisplaySize = 9.3,
            }
        end

        -- Sidecar meta file next to the .rbxmx (does not corrupt XML).
        -- Still supports reading/writing -- origin_x: lines inside the rbxmx for compatibility.
        Library.GetPreviewMetaSidecarPath = function(self, rbxmxPath)
            if not rbxmxPath then
                return nil
            end
            local p = tostring(rbxmxPath)
            if p:match("%.[Rr][Bb][Xx][Mm][Xx]$") then
                return p:gsub("%.[Rr][Bb][Xx][Mm][Xx]$", ".previewmeta")
            end
            return p .. ".previewmeta"
        end

        Library.ParseMetaString = function(self, data, meta)
            meta = meta or self:DefaultPreviewMeta()
            if type(data) ~= "string" then
                return meta
            end
            local function parseNum(key, default)
                local raw = data:match("%-%-%s*" .. key .. "%s*:%s*([^\r\n]+)")
                if not raw then
                    -- also accept key=value without dashes
                    raw = data:match(key .. "%s*[=:]%s*([^\r\n]+)")
                end
                if not raw then
                    return default
                end
                local trimmed = raw:match("^%s*(.-)%s*$") or raw
                local n = tonumber(trimmed)
                return n ~= nil and n or default
            end
            meta.OriginX = parseNum("origin_x", meta.OriginX)
            meta.OriginY = parseNum("origin_y", meta.OriginY)
            meta.OriginZ = parseNum("origin_z", meta.OriginZ)
            meta.DisplaySize = parseNum("display_size", meta.DisplaySize)
            if not meta.DisplaySize or meta.DisplaySize <= 0 then
                meta.DisplaySize = 9.3
            end
            return meta
        end

        Library.FormatMetaString = function(self, meta)
            meta = meta or self:DefaultPreviewMeta()
            return table.concat({
                string.format("-- origin_x:%s", tostring(meta.OriginX or 0)),
                string.format("-- origin_y:%s", tostring(meta.OriginY or 2.85)),
                string.format("-- origin_z:%s", tostring(meta.OriginZ or 0)),
                string.format("-- display_size:%s", tostring(meta.DisplaySize or 9.3)),
            }, "\n") .. "\n"
        end

        Library.ReadPreviewModelMeta = function(self, path)
            local meta = self:DefaultPreviewMeta()
            if not path then
                return meta
            end
            -- prefer sidecar
            local side = self:GetPreviewMetaSidecarPath(path)
            if side and isfile and isfile(side) then
                local ok, data = pcall(readfile, side)
                if ok and type(data) == "string" then
                    meta = self:ParseMetaString(data, meta)
                end
            end
            -- also merge from rbxmx comment lines if present
            if isfile and isfile(path) then
                local ok, data = pcall(readfile, path)
                if ok and type(data) == "string" then
                    meta = self:ParseMetaString(data, meta)
                end
            end
            return meta
        end

        -- Disabled: model file presets are read-only configs, never overwritten by the UI.
        Library.WritePreviewModelMeta = function(self, path, meta)
            return false
        end

        -- Read-only: never writes the file. fallback used only when no preset exists in file.
        Library.EnsurePreviewModelMeta = function(self, path, fallback)
            if not path then
                return fallback or self:DefaultPreviewMeta()
            end
            local meta = self:ReadPreviewModelMeta(path)
            -- If file had no preset values, ParseMetaString returns defaults already.
            -- Prefer explicit fallback from registry when file has no embedded/sidecar data.
            local side = self:GetPreviewMetaSidecarPath(path)
            local hasSide = side and isfile and isfile(side)
            local hasEmbedded = false
            if isfile and isfile(path) then
                local ok, data = pcall(readfile, path)
                hasEmbedded = ok and type(data) == "string" and (
                    data:find("%-%-%s*origin_x%s*:") ~= nil
                    or data:find("%-%-%s*display_size%s*:") ~= nil
                )
            end
            if not hasSide and not hasEmbedded and fallback then
                return {
                    OriginX = fallback.OriginX or meta.OriginX,
                    OriginY = fallback.OriginY or meta.OriginY,
                    OriginZ = fallback.OriginZ or meta.OriginZ,
                    DisplaySize = fallback.DisplaySize or meta.DisplaySize,
                }
            end
            return meta
        end

        Library.DownloadCachedModel = function(self, AssetId, Url)
            self:EnsureCachedModelsFolder()
            AssetId = tostring(AssetId or Library.PreviewModel.AssetId)
            Url = Url or Library.PreviewModel.Url
            local path = self:GetCachedModelPath(AssetId)

            if isfile and isfile(path) then
                return true, path
            end
            -- try resolve alternate path
            local resolved = self:ResolveCachedModelPath(AssetId)
            if resolved and isfile and isfile(resolved) then
                return true, resolved
            end
            if not Url or Url == "" then
                return false, path
            end
            if not (writefile and game and game.HttpGet) then
                return false, path
            end

            local ok, data = pcall(function()
                return game:HttpGet(Url)
            end)
            if not ok or type(data) ~= "string" or #data < 32 then
                return false, path
            end

            local writeOk = pcall(function()
                writefile(path, data)
            end)
            if writeOk and isfile(path) then
                -- seed per-file config from registry defaults if present
                local fallback = self:DefaultPreviewMeta()
                for _, entry in ipairs(Library.PreviewModels or {}) do
                    if tostring(entry.AssetId) == AssetId then
                        fallback.OriginX = entry.OriginX or fallback.OriginX
                        fallback.OriginY = entry.OriginY or fallback.OriginY
                        fallback.OriginZ = entry.OriginZ or fallback.OriginZ
                        fallback.DisplaySize = entry.DisplaySize or fallback.DisplaySize
                        break
                    end
                end
                self:EnsurePreviewModelMeta(path, fallback)
                return true, path
            end
            return false, path
        end

        -- Robust HTTP get (request() preferred for GitHub headers)
        Library.HttpGetRaw = function(self, Url)
            if not Url or Url == "" then
                return nil
            end
            local body = nil
            if request or http_request or (syn and syn.request) then
                local req = request or http_request or syn.request
                local ok, res = pcall(function()
                    return req({
                        Url = Url,
                        Method = "GET",
                        Headers = {
                            ["User-Agent"] = "Peronahax-ModelSync",
                            ["Accept"] = "application/vnd.github+json",
                        },
                    })
                end)
                if ok and type(res) == "table" then
                    body = res.Body or res.body
                end
            end
            if type(body) ~= "string" or #body < 1 then
                local ok2, res2 = pcall(function()
                    return game:HttpGet(Url)
                end)
                if ok2 and type(res2) == "string" then
                    body = res2
                end
            end
            if type(body) == "string" and #body > 0 then
                return body
            end
            return nil
        end

        Library.UrlEncodePath = function(self, Path)
            -- encode each segment but keep slashes
            local parts = {}
            for segment in string.gmatch(Path:gsub("\\", "/"), "[^/]+") do
                local enc = segment:gsub("([^%w%-%._~])", function(c)
                    return string.format("%%%02X", string.byte(c))
                end)
                parts[#parts + 1] = enc
            end
            return table.concat(parts, "/")
        end

        -- Sync .rbxmx models from GitHub → Atlanta/CachedModels (skips files that already exist)
        Library.SyncPreviewModelsFromGitHub = function(self, Force)
            if Library._PreviewModelsSynced and not Force then
                return Library.PreviewModels or {}
            end
            -- brief cooldown after a failed attempt (unless Force)
            if not Force and Library._PreviewModelsSyncFailAt then
                if (tick() - Library._PreviewModelsSyncFailAt) < 20 then
                    return Library.PreviewModels or {}
                end
            end

            self:EnsureCachedModelsFolder()
            local repo = Library.PreviewModelsRepo or {}
            local api = repo.Api or "https://api.github.com/repos/k0nkx/Custom-Models/git/trees/main?recursive=1"
            local rawBase = repo.Raw or "https://raw.githubusercontent.com/k0nkx/Custom-Models/main/"
            if not rawBase:match("/$") then
                rawBase = rawBase .. "/"
            end

            local response = self:HttpGetRaw(api)
            if type(response) ~= "string" or #response < 8 then
                Library._PreviewModelsSyncFailAt = tick()
                return Library.PreviewModels or {}
            end

            local okJson, decoded = pcall(function()
                return Services.HttpService:JSONDecode(response)
            end)
            if not okJson or type(decoded) ~= "table" then
                Library._PreviewModelsSyncFailAt = tick()
                return Library.PreviewModels or {}
            end

            -- Build list of .rbxmx blobs from tree API
            local blobs = {} -- { path, name }
            local seenPath = {}
            local function addBlob(pathName)
                if not pathName or seenPath[pathName] then
                    return
                end
                pathName = pathName:gsub("\\", "/")
                local fileName = pathName:match("([^/]+)%.[Rr][Bb][Xx][Mm][Xx]$")
                if not fileName then
                    return
                end
                seenPath[pathName] = true
                blobs[#blobs + 1] = { Path = pathName, Name = fileName }
            end

            for _, item in ipairs(decoded.tree or {}) do
                if item.type == "blob" and type(item.path) == "string" then
                    addBlob(item.path)
                end
            end

            -- Fallback: contents API if tree empty or truncated
            if #blobs == 0 or decoded.truncated == true then
                local contentsUrl = repo.Contents
                    or "https://api.github.com/repos/k0nkx/Custom-Models/contents/"
                local contentsBody = self:HttpGetRaw(contentsUrl)
                if type(contentsBody) == "string" then
                    local okC, contents = pcall(function()
                        return Services.HttpService:JSONDecode(contentsBody)
                    end)
                    if okC and type(contents) == "table" then
                        for _, item in ipairs(contents) do
                            if type(item) == "table" and item.type == "file" and type(item.path) == "string" then
                                addBlob(item.path)
                            elseif type(item) == "table" and item.type == "file" and type(item.name) == "string" then
                                addBlob(item.name)
                            end
                        end
                    end
                end
            end

            local registry = Library.PreviewModels or {}
            local byId = {}
            for _, entry in ipairs(registry) do
                if entry.AssetId then
                    byId[tostring(entry.AssetId)] = entry
                end
            end

            local downloaded, skipped, failed = 0, 0, 0

            for _, blob in ipairs(blobs) do
                local assetId = blob.Name
                local pathName = blob.Path
                local rawUrl = rawBase .. self:UrlEncodePath(pathName)
                -- also keep unencoded variant as fallback
                local rawUrlPlain = rawBase .. pathName
                local localPath = self:GetCachedModelPath(assetId)

                local exists = false
                if isfile then
                    exists = isfile(localPath)
                    if not exists then
                        local alt = localPath:gsub("/", "\\")
                        exists = isfile(alt)
                        if exists then
                            localPath = alt
                        end
                    end
                end

                if exists then
                    skipped += 1
                else
                    local content = self:HttpGetRaw(rawUrl)
                    if type(content) ~= "string" or #content < 32 then
                        content = self:HttpGetRaw(rawUrlPlain)
                    end
                    -- one retry
                    if type(content) ~= "string" or #content < 32 then
                        task.wait(0.15)
                        content = self:HttpGetRaw(rawUrlPlain) or self:HttpGetRaw(rawUrl)
                    end

                    if type(content) == "string" and #content > 32 then
                        local writeOk = pcall(writefile, localPath, content)
                        if writeOk and isfile and isfile(localPath) then
                            downloaded += 1
                        else
                            -- try backslash path
                            local alt = localPath:gsub("/", "\\")
                            writeOk = pcall(writefile, alt, content)
                            if writeOk and isfile and isfile(alt) then
                                localPath = alt
                                downloaded += 1
                            else
                                failed += 1
                            end
                        end
                    else
                        failed += 1
                    end
                end

                if not byId[assetId] then
                    local entry = {
                        Name = assetId,
                        AssetId = assetId,
                        Url = rawUrlPlain,
                        DisplaySize = 9.3,
                        OriginX = 0,
                        OriginY = 2.85,
                        OriginZ = 0,
                    }
                    if isfile and isfile(localPath) then
                        local meta = self:ReadPreviewModelMeta(localPath)
                        entry.DisplaySize = meta.DisplaySize
                        entry.OriginX = meta.OriginX
                        entry.OriginY = meta.OriginY
                        entry.OriginZ = meta.OriginZ
                    end
                    registry[#registry + 1] = entry
                    byId[assetId] = entry
                else
                    byId[assetId].Url = byId[assetId].Url or rawUrlPlain
                end
            end

            Library.PreviewModels = registry

            -- ========== TEXTURE SYNC ==========
            -- Repo: textures/<ModelName>/Name -- 123.webp  →  Atlanta/CachedModels/texture_ids/<ModelName>/
            local textureBlobs = {} -- { Path, ModelName, FileName }
            for _, item in ipairs(decoded.tree or {}) do
                if item.type == "blob" and type(item.path) == "string" then
                    local tpath = item.path:gsub("\\", "/")
                    local modelName, fileName = tpath:match("^textures/([^/]+)/(.+)$")
                    if modelName and fileName and fileName:match("%-%-%s*%d+%s*%.(webp|WEBP|png|PNG|jpg|JPG|jpeg|JPEG)$") then
                        textureBlobs[#textureBlobs + 1] = {
                            Path = tpath,
                            ModelName = modelName,
                            FileName = fileName,
                        }
                    end
                end
            end

            local texDownloaded, texSkipped, texFailed = 0, 0, 0
            for _, blob in ipairs(textureBlobs) do
                local localFolder = self:EnsureTextureIdsFolder(blob.ModelName)
                if not localFolder then
                    texFailed += 1
                else
                    local localPath = localFolder .. "/" .. blob.FileName
                    local localPathAlt = localFolder:gsub("/", "\\") .. "\\" .. blob.FileName
                    local exists = false
                    if isfile then
                        exists = isfile(localPath) or isfile(localPathAlt)
                    end
                    if exists then
                        texSkipped += 1
                    else
                        local rawUrl = rawBase .. self:UrlEncodePath(blob.Path)
                        local rawUrlPlain = rawBase .. blob.Path
                        local content = self:HttpGetRaw(rawUrl)
                        if type(content) ~= "string" or #content < 32 then
                            content = self:HttpGetRaw(rawUrlPlain)
                        end
                        if type(content) ~= "string" or #content < 32 then
                            task.wait(0.1)
                            content = self:HttpGetRaw(rawUrlPlain) or self:HttpGetRaw(rawUrl)
                        end
                        if type(content) == "string" and #content > 32 then
                            local writeOk = pcall(writefile, localPath, content)
                            if not writeOk or not (isfile and isfile(localPath)) then
                                writeOk = pcall(writefile, localPathAlt, content)
                            end
                            if writeOk then
                                texDownloaded += 1
                            else
                                texFailed += 1
                            end
                        else
                            texFailed += 1
                        end
                    end
                end
            end

            -- only mark fully synced if we got a tree/list and no total failure on empty
            if #blobs > 0 or #textureBlobs > 0 then
                Library._PreviewModelsSynced = true
                Library._PreviewModelsSyncFailAt = nil
            else
                Library._PreviewModelsSyncFailAt = tick()
            end

            Library._PreviewModelsLastSync = {
                Total = #blobs,
                Downloaded = downloaded,
                Skipped = skipped,
                Failed = failed,
                TexturesTotal = #textureBlobs,
                TexturesDownloaded = texDownloaded,
                TexturesSkipped = texSkipped,
                TexturesFailed = texFailed,
            }
            Library._PreviewTexturesLastSync = {
                Total = #textureBlobs,
                Downloaded = texDownloaded,
                Skipped = texSkipped,
                Failed = texFailed,
            }
            return registry
        end

        -- Returns list of model Names (from GitHub sync + CachedModels on disk)
        Library.GetPreviewModelList = function(self)
            -- auto-sync once (or when forced via Refresh)
            pcall(function()
                self:SyncPreviewModelsFromGitHub(false)
            end)

            local list = {}
            local seen = {}
            for _, entry in ipairs(Library.PreviewModels or {}) do
                if entry.Name and not seen[string.lower(entry.Name)] then
                    seen[string.lower(entry.Name)] = true
                    list[#list + 1] = entry.Name
                end
            end
            local files = self:ListCachedModelFiles()
            for _, file in ipairs(files) do
                local baseName = self:CachedModelFileBaseName(file)
                if baseName then
                    local display = baseName
                    for _, entry in ipairs(Library.PreviewModels or {}) do
                        if tostring(entry.AssetId) == baseName or string.lower(tostring(entry.AssetId)) == string.lower(baseName) then
                            display = entry.Name
                            break
                        end
                    end
                    if not seen[string.lower(display)] then
                        seen[string.lower(display)] = true
                        list[#list + 1] = display
                    end
                end
            end
            table.sort(list)
            return list
        end

        Library.FindPreviewModelEntry = function(self, NameOrAssetId)
            if not NameOrAssetId or NameOrAssetId == "" then
                return nil
            end
            local key = tostring(NameOrAssetId)
            for _, entry in ipairs(Library.PreviewModels or {}) do
                if entry.Name == key or tostring(entry.AssetId) == key then
                    local path = self:GetCachedModelPath(entry.AssetId)
                    local meta = self:ReadPreviewModelMeta(path)
                    return {
                        Name = entry.Name,
                        AssetId = tostring(entry.AssetId),
                        Url = entry.Url,
                        DisplaySize = meta.DisplaySize,
                        OriginX = meta.OriginX,
                        OriginY = meta.OriginY,
                        OriginZ = meta.OriginZ,
                        Path = path,
                    }
                end
            end
            -- disk-only model (any .rbxmx in CachedModels)
            local path, base = self:ResolveCachedModelPath(key)
            if path and isfile and isfile(path) then
                local meta = self:ReadPreviewModelMeta(path)
                return {
                    Name = base or key,
                    AssetId = base or key,
                    Url = nil,
                    DisplaySize = meta.DisplaySize,
                    OriginX = meta.OriginX,
                    OriginY = meta.OriginY,
                    OriginZ = meta.OriginZ,
                    Path = path,
                }
            end
            return nil
        end

        -- Switch active model by Name (or AssetId). Loads per-file origin/display config.
        Library.SetPreviewModel = function(self, NameOrAssetId, ReloadPreviews)
            local entry = self:FindPreviewModelEntry(NameOrAssetId)
            if not entry then
                Library:Notify({ Text = "Preview model not found: " .. tostring(NameOrAssetId), Lifetime = 3 })
                return false
            end

            -- ensure file exists (download registry models if needed)
            if entry.Url then
                self:DownloadCachedModel(entry.AssetId, entry.Url)
            end
            local path = entry.Path or self:GetCachedModelPath(entry.AssetId)
            local meta = self:EnsurePreviewModelMeta(path, {
                OriginX = entry.OriginX,
                OriginY = entry.OriginY,
                OriginZ = entry.OriginZ,
                DisplaySize = entry.DisplaySize,
            })

            local pm = Library.PreviewModel
            pm.Name = entry.Name
            pm.AssetId = tostring(entry.AssetId)
            pm.Url = entry.Url
            pm.Path = path
            -- always use this model's own file config
            pm.OriginX = meta.OriginX
            pm.OriginY = meta.OriginY
            pm.OriginZ = meta.OriginZ
            pm.DisplaySize = meta.DisplaySize
            pm._cached = nil -- force re-load

            Flags["Preview Model"] = pm.Name
            Flags["Preview Origin X"] = pm.OriginX
            Flags["Preview Origin Y"] = pm.OriginY
            Flags["Preview Origin Z"] = pm.OriginZ
            Flags["Preview Display Size"] = pm.DisplaySize

            if ReloadPreviews ~= false then
                self:ReloadActivePreviews()
            end
            return true
        end

        -- Intentionally does NOT write files — presets in .rbxmx / .previewmeta are read-only.
        Library.PersistCurrentPreviewMeta = function(self)
            return false
        end
        Library.PersistCurrentPreviewMetaDebounced = function(self)
        end

        Library.SetPreviewOrigins = function(self, X, Y, Z, Reload)
            local pm = Library.PreviewModel
            if not pm then
                return
            end
            if X ~= nil then pm.OriginX = tonumber(X) or pm.OriginX end
            if Y ~= nil then pm.OriginY = tonumber(Y) or pm.OriginY end
            if Z ~= nil then pm.OriginZ = tonumber(Z) or pm.OriginZ end
            Flags["Preview Origin X"] = pm.OriginX
            Flags["Preview Origin Y"] = pm.OriginY
            Flags["Preview Origin Z"] = pm.OriginZ
            -- live preview only — never writes the model file
            if Reload ~= false then
                self:ApplyOriginsToActivePreviews()
            end
        end

        Library.SetPreviewDisplaySize = function(self, Size, Reload)
            local pm = Library.PreviewModel
            if type(Size) == "number" and Size > 0 then
                pm.DisplaySize = Size
                Flags["Preview Display Size"] = Size
                -- live preview only — never writes the model file
                pm._cached = nil
                if Reload ~= false then
                    self:ReloadActivePreviews()
                end
            end
        end

        Library.ReloadActivePreviews = function(self)
            local model, isCustom = self:GetPreviewModel()
            for i = #Library.ActivePreviews, 1, -1 do
                local cfg = Library.ActivePreviews[i]
                if not cfg or not cfg.ViewModel then
                    table.remove(Library.ActivePreviews, i)
                else
                    pcall(function()
                        if model then
                            cfg.ViewModel(model)
                            if isCustom then
                                cfg._CustomPreviewApplied = true
                            end
                        end
                    end)
                end
            end
        end

        -- Origin only repositions HumanoidRootPart / PrimaryPart (mesh stays put).
        Library.ApplyOriginToModelInstance = function(self, model, originX, originY, originZ)
            if not model then
                return
            end
            local target = CFrame.new(originX or 0, originY or 2.85, originZ or 0)
            local root = model:FindFirstChild("HumanoidRootPart")
                or model.PrimaryPart
                or model:FindFirstChildWhichIsA("BasePart", true)
            if not root or not root:IsA("BasePart") then
                return
            end
            root.CFrame = target
            if model.PrimaryPart ~= root then
                model.PrimaryPart = root
            end
        end

        Library.ApplyOriginsToActivePreviews = function(self)
            local pm = Library.PreviewModel
            if not pm then
                return
            end
            local ox, oy, oz = pm.OriginX or 0, pm.OriginY or 2.85, pm.OriginZ or 0
            -- keep source cache in sync (ViewModel clones from it)
            if pm._cached then
                pcall(function()
                    self:ApplyOriginToModelInstance(pm._cached, ox, oy, oz)
                end)
            end
            for i = #Library.ActivePreviews, 1, -1 do
                local cfg = Library.ActivePreviews[i]
                if not cfg then
                    table.remove(Library.ActivePreviews, i)
                else
                    pcall(function()
                        local model = cfg._ViewModel
                        if not model or not model.Parent then
                            local vf = cfg.Items and cfg.Items.ViewportFrame and cfg.Items.ViewportFrame.Instance
                            if vf then
                                model = vf:FindFirstChild("PeronaPreviewCache")
                                    or vf:FindFirstChildOfClass("Model")
                            end
                        end
                        if model then
                            cfg._ViewModel = model
                            self:ApplyOriginToModelInstance(model, ox, oy, oz)
                        end
                    end)
                end
            end
        end

        Library.PreparePreviewModel = function(self, model)
            if not model then
                return nil
            end
            if not model:IsA("Model") then
                local wrap = Instance.new("Model")
                wrap.Name = "PreviewCustom"
                model.Parent = wrap
                model = wrap
            end

            for _, desc in ipairs(model:GetDescendants()) do
                if desc:IsA("BasePart") then
                    desc.Anchored = true
                    desc.CanCollide = false
                    desc.CanQuery = false
                    desc.CanTouch = false
                elseif desc:IsA("Script") or desc:IsA("LocalScript") then
                    pcall(function()
                        desc:Destroy()
                    end)
                end
            end

            local pm = Library.PreviewModel
            local okBB, cf, size = pcall(function()
                local c, s = model:GetBoundingBox()
                return c, s
            end)
            if okBB and cf and size then
                local center = cf.Position
                local span = math.max(size.X, size.Y, size.Z, 0.001)
                pcall(function()
                    model:PivotTo(CFrame.new(-center))
                end)
                local scale = (pm.DisplaySize or 9.2) / span
                local scaled = pcall(function()
                    model:ScaleTo(scale)
                end)
                if not scaled then
                    for _, desc in ipairs(model:GetDescendants()) do
                        if desc:IsA("BasePart") then
                            desc.Size = desc.Size * scale
                            desc.CFrame = CFrame.new(desc.Position * scale) * (desc.CFrame - desc.Position)
                        end
                    end
                end
            end

            if not model.PrimaryPart then
                local root = model:FindFirstChild("HumanoidRootPart")
                    or model:FindFirstChild("Torso")
                    or model:FindFirstChild("UpperTorso")
                    or model:FindFirstChildWhichIsA("BasePart", true)
                if root and root:IsA("BasePart") then
                    model.PrimaryPart = root
                end
            end

            local hrp = model:FindFirstChild("HumanoidRootPart")
            if not hrp and model.PrimaryPart then
                hrp = Instance.new("Part")
                hrp.Name = "HumanoidRootPart"
                hrp.Transparency = 1
                hrp.CanCollide = false
                hrp.Anchored = true
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Parent = model
                model.PrimaryPart = hrp
            elseif hrp then
                model.PrimaryPart = hrp
            end

            -- place whole model at configured origin (not only PrimaryPart)
            self:ApplyOriginToModelInstance(model, pm.OriginX or 0, pm.OriginY or 2.85, pm.OriginZ or 0)

            -- Prefer local textures from CachedModels/texture_ids/<modelname>/
            -- Filename: "Name -- <TextureId>.webp"  (matched against rbxmx asset ids)
            local modelKey = pm.Name or pm.AssetId or ""
            pcall(function()
                self:ApplyLocalTexturesToModel(model, modelKey)
            end)

            model.Name = "PeronaPreviewCache"
            return model
        end

        -- Remove our -- origin_*/display_size lines so GetObjects gets valid rbxmx XML
        Library.StripPreviewMetaFromData = function(self, data)
            if type(data) ~= "string" then
                return data
            end
            data = data:gsub("%-%-%s*origin_x%s*:[^\r\n]*\r?\n?", "")
            data = data:gsub("%-%-%s*origin_y%s*:[^\r\n]*\r?\n?", "")
            data = data:gsub("%-%-%s*origin_z%s*:[^\r\n]*\r?\n?", "")
            data = data:gsub("%-%-%s*display_size%s*:[^\r\n]*\r?\n?", "")
            return data
        end

        Library.LoadModelObjectsFromPath = function(self, path)
            if not path or not (isfile and isfile(path)) then
                return nil
            end
            local okRead, data = pcall(readfile, path)
            if not okRead or type(data) ~= "string" or #data < 16 then
                return nil
            end

            local clean = self:StripPreviewMetaFromData(data)
            local loadPath = path
            -- if meta comments were present, write a temp clean rbxmx so GetObjects doesn't choke
            if clean ~= data then
                local base = Library.Directory or "Atlanta"
                local tempName = "_preview_load_tmp.rbxmx"
                loadPath = string.format("%s/CachedModels/%s", base, tempName)
                local alt = string.format("%s\\CachedModels\\%s", base, tempName)
                local wrote = pcall(writefile, loadPath, clean)
                if not wrote then
                    pcall(writefile, alt, clean)
                    loadPath = alt
                end
            end

            local result = nil
            local attempts = {
                function()
                    if getcustomasset then
                        return game:GetObjects(getcustomasset(loadPath))
                    end
                end,
                function()
                    return game:GetObjects(loadPath)
                end,
                function()
                    if getcustomasset and loadPath ~= path then
                        return game:GetObjects(getcustomasset(path))
                    end
                end,
                function()
                    if readfile and getsenv then
                        -- last resort: some executors accept rbxmx via GetObjects on asset id only
                        return nil
                    end
                end,
            }
            for _, fn in ipairs(attempts) do
                local ok, res = pcall(fn)
                if ok and type(res) == "table" and #res > 0 then
                    result = res
                    break
                end
            end

            -- cleanup temp
            if loadPath ~= path then
                pcall(function()
                    if delfile and isfile(loadPath) then
                        delfile(loadPath)
                    end
                end)
            end
            return result
        end

        Library.LoadCachedPreviewModel = function(self, AssetId, Url)
            local pm = Library.PreviewModel
            if pm._cached then
                return pm._cached
            end

            AssetId = tostring(AssetId or pm.AssetId or "")
            Url = Url or pm.Url
            if AssetId ~= "" then
                self:DownloadCachedModel(AssetId, Url)
            end

            local path = pm.Path
            if not path or not (isfile and isfile(path)) then
                path = select(1, self:ResolveCachedModelPath(AssetId)) or self:GetCachedModelPath(AssetId)
            end
            if not (isfile and isfile(path)) then
                -- last try: first file in CachedModels
                local files = self:ListCachedModelFiles()
                if files and files[1] then
                    path = files[1]
                    local base = self:CachedModelFileBaseName(path)
                    if base then
                        AssetId = base
                        pm.AssetId = base
                        pm.Name = base
                    end
                end
            end
            if not (isfile and isfile(path)) then
                return nil
            end
            pm.Path = path
            pm.AssetId = tostring(AssetId or pm.AssetId)
            if not pm.Name or pm.Name == "" then
                pm.Name = self:CachedModelFileBaseName(path) or pm.AssetId
            end

            -- file-specific config (does not break load — we strip on GetObjects)
            local meta = self:EnsurePreviewModelMeta(path)
            pm.OriginX = meta.OriginX
            pm.OriginY = meta.OriginY
            pm.OriginZ = meta.OriginZ
            pm.DisplaySize = meta.DisplaySize

            local result = self:LoadModelObjectsFromPath(path)
            -- if load failed and we have a Url, re-download a clean copy and retry once
            if (not result or not result[1]) and Url and Url ~= "" then
                pcall(function()
                    if delfile and isfile(path) then
                        delfile(path)
                    end
                end)
                pm.Path = nil
                local okDl = self:DownloadCachedModel(AssetId, Url)
                path = self:GetCachedModelPath(AssetId)
                if okDl and isfile and isfile(path) then
                    pm.Path = path
                    local meta2 = self:EnsurePreviewModelMeta(path)
                    pm.OriginX = meta2.OriginX
                    pm.OriginY = meta2.OriginY
                    pm.OriginZ = meta2.OriginZ
                    pm.DisplaySize = meta2.DisplaySize
                    result = self:LoadModelObjectsFromPath(path)
                end
            end
            if not result or not result[1] then
                return nil
            end

            local prepared = self:PreparePreviewModel(result[1])
            if prepared then
                pm._cached = prepared
            end
            return prepared
        end

        Library.GetPreviewModel = function(self, AssetId, Url)
            local custom = self:LoadCachedPreviewModel(AssetId, Url)
            if custom then
                return custom, true
            end
            -- only fall back to LocalPlayer if no custom file could be loaded
            local lp = Services.Players.LocalPlayer
            local char = lp and lp.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                return char, false
            end
            return nil, false
        end
    end Library.Themes = Themes

    local Fonts = {}; do
        pcall(function()
            Library:SetLoadingStatus("Loading fonts...")
            Library:SetLoadingProgress(0.2)
        end)
        function Fonts:New(Name, Weight, Style, Data)
            if not isfile(Library.Directory .. "/Fonts/" .. Data.Id) then
                writefile(Library.Directory .. "/Fonts/" .. Data.Id, game:HttpGet(Data.Url))
            end

            local Data = {
                name = Name,
                faces = {
                    {
                        name = Name,
                        weight = Weight,
                        style = Style,
                        assetId = getcustomasset(Library.Directory .. "/Fonts/" .. Data.Id)
                    }
                }
            }

            writefile(Library.Directory .. "/Fonts/" .. Name .. ".font", Services.HttpService:JSONEncode(Data))
            return Font.new(getcustomasset(Library.Directory .. "/Fonts/" .. Name .. ".font"))
        end

