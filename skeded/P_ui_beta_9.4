                        Callback = function(Value)
                            Library:SetPreviewOrigins(nil, Value, nil, true)
                        end
                    })
                    OriginZSlider = self:AddSlider({
                        Text = "Origin Z",
                        Flag = "Preview Origin Z",
                        Min = -20, Max = 20,
                        Default = (Library.PreviewModel and Library.PreviewModel.OriginZ) or 0,
                        Decimal = 0.05,
                        Callback = function(Value)
                            Library:SetPreviewOrigins(nil, nil, Value, true)
                        end
                    })
                    DisplaySizeSlider = self:AddSlider({
