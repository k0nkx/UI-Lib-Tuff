        Library.SetPageBackgroundEnabled = function(self, Enabled)
            Flags["Page Background Enabled"] = Enabled and true or false

            local Window = Library.Window
            if not Window or not Window.Items or not Window.Items.PageBackgroundImage then
                return
            end

            local Image = Window.Items.PageBackgroundImage.Instance
            Image.Visible = Enabled and true or false

            if Enabled and Flags["Page Background Asset"] then
                self:SetPageBackgroundAsset(Flags["Page Background Asset"])
            end
        end

        Library.SetPageBackgroundAsset = function(self, FileName)
            if not FileName or FileName == "" or string.find(FileName, "%(no assets") then
                return
            end

            Flags["Page Background Asset"] = FileName

            local Window = Library.Window
            if not Window or not Window.Items or not Window.Items.PageBackgroundImage then
                return
            end

            local Path = self:GetAssetPath(FileName)
            if not isfile(Path) then
                Library:Notify({ Text = "Asset not found: " .. tostring(FileName), Lifetime = 3 })
                return
            end

            local Ok, Asset = pcall(getcustomasset, Path)
            if not Ok or not Asset then
                Library:Notify({ Text = "Failed to load asset: " .. tostring(FileName), Lifetime = 3 })
                return
            end

            local Image = Window.Items.PageBackgroundImage.Instance
            Image.Image = Asset

            if Flags["Page Background Enabled"] then
                Image.Visible = true
            end
        end

