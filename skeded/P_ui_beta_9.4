                Config[Idx] = { Transparency = 1, Color = Value:ToHex() }
            end

            for Idx, Value in { "Blur Intensity", "Misc Transparency", "Main Transparency" } do
                Config[Value] = Library.Flags[Value]
            end

            return Services.HttpService:JSONEncode(Config)
        end

