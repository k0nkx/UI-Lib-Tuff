            local Frames = 0
            local FPS = 0
            local LastTick = tick()
            local SessionStart = tick()
            local GameName = Services.MarketplaceService:GetProductInfo(game.PlaceId).Name

            local function getExecutorName()
                local ok, name = pcall(function()
                    if typeof(identifyexecutor) == "function" then
                        return identifyexecutor()
                    end
                    if typeof(getexecutorname) == "function" then
                        return getexecutorname()
                    end
                    return nil
                end)
                if ok and type(name) == "string" and name ~= "" then
                    -- identifyexecutor can return name, version — take the name part
                    local short = string.match(name, "^([^,\n]+)")
                    return short or name
                end
                return "Unknown"
            end

            local function formatSessionTime(seconds)
                seconds = math.max(0, math.floor(seconds))
                local h = math.floor(seconds / 3600)
                local m = math.floor((seconds % 3600) / 60)
                local s = seconds % 60
                if h > 0 then
                    return string.format("%dh %02dm %02ds", h, m, s)
                end
                if m > 0 then
                    return string.format("%dm %02ds", m, s)
                end
                return string.format("%ds", s)
            end

            local CachedExecutorName = getExecutorName()

            Services.RunService.RenderStepped:Connect(function(Delta)
                if not Flags["Refresh Rate"] then return end 
                
                Tick = tick()
                if not (Tick - LastTick >= Flags["Refresh Rate"]) then
                    return
                end

                LastTick = Tick
                FPS = math.floor(1 / Delta)

                local Strings = Flags["WatermarkSettings"] or {}

                local Parts = {}

                if table.find(Strings, "Title") then
                    table.insert(Parts, Cfg.Suffix)
                end

                if table.find(Strings, "Fps") then
                    table.insert(Parts, FPS .. " fps")
                end

                if table.find(Strings, "Ping") then
                    local dataPing = 0
                    local ok, value = pcall(function()
                        local network = Services.Stats:FindFirstChild("Network")
                        local serverStats = network and network:FindFirstChild("ServerStatsItem")
                        local dataPingItem = serverStats and serverStats:FindFirstChild("Data Ping")
                        if dataPingItem then
                            return dataPingItem:GetValue()
                        end
                        return nil
                    end)
                    if ok and type(value) == "number" then
                        dataPing = value
                    else
                        -- Fallback: parse "Data Ping" string if GetValue is unavailable
                        pcall(function()
                            local item = Services.Stats.Network.ServerStatsItem:FindFirstChild("Data Ping")
                            if item then
                                local str = item:GetValueString()
                                dataPing = tonumber(string.match(str or "", "%d+")) or 0
                            end
                        end)
                    end
                    table.insert(Parts, math.floor(dataPing) .. " ping")
                end

                if table.find(Strings, "Session Time") then
                    table.insert(Parts, formatSessionTime(tick() - SessionStart))
                end

                if table.find(Strings, "Executor") then
                    table.insert(Parts, CachedExecutorName)
                end

                if table.find(Strings, "Players") then
                    local current = #Services.Players:GetPlayers()
                    local maxPlayers = Services.Players.MaxPlayers or current
                    table.insert(Parts, string.format("%d/%d", current, maxPlayers))
                end

                if table.find(Strings, "Game Name") then
                    table.insert(Parts, GameName)
                end

                if table.find(Strings, "User ID") then
                    table.insert(Parts, tostring(Services.Players.LocalPlayer.UserId))
                end

                if table.find(Strings, "LocalPlayer Name") then
                    table.insert(Parts, Services.Players.LocalPlayer.Name)
                end

                if table.find(Strings, "Date") then
                    table.insert(Parts, os.date("%b %d, %Y"))
                end

                if table.find(Strings, "Time") then
                    -- e.g. 9:10 PM (strip leading zero on hour)
                    local t = os.date("%I:%M %p")
                    t = t:gsub("^0", "")
                    table.insert(Parts, t)
                end

                local FinalText = table.concat(Parts, " | ")

                Items.WatermarkTitle.Instance.Text = string.format(
                    '%s<font color = "rgb(%s, %s, %s)">%s</font>', 
                    table.find(Strings, "Title") and Cfg.Prefix or "", 
                    math.floor(Themes.Preset.TextMain.R * 255),
                    math.floor(Themes.Preset.TextMain.G * 255), 
                    math.floor(Themes.Preset.TextMain.B * 255), 
                    FinalText
                )

                Items.Title.Instance.Text = string.format(
                    '%s<font color = "rgb(%s, %s, %s)">%s ~ %s</font>', 
                    Cfg.Prefix, 
                    math.floor(Themes.Preset.TextMain.R * 255),
                    math.floor(Themes.Preset.TextMain.G * 255), 
                    math.floor(Themes.Preset.TextMain.B * 255), 
                    Cfg.Suffix,
                    os.date("%b %d, %Y")
                )
            end)

            return Library.Window
        end

