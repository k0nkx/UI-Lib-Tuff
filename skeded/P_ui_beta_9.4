            Section:AddToggle({Text = "Watermark", Default = true, Callback = self.SetWatermarkVisibility})
            Section:AddDropdown({
                Text = "Options",
                Flag = "WatermarkSettings",
                Options = {
                    "Title",
                    "Fps",
                    "Ping",
                    "Session Time",
                    "Executor",
                    "Players",
                    "Game Name",
                    "User ID",
                    "LocalPlayer Name",
                    "Date",
                    "Time",
                },
                Multi = true,
                Default = {"Title", "Fps", "Ping"},
            })
            Section:AddSlider({Text = "Refresh Rate", Flag = "Refresh Rate", Min = 0, Max = 2, Default = 0.1, Suffix = "s", Decimal = 0.01})
            Section:AddToggle({Text = "Keybind List", Default = true, Callback = self.SetKeybindListVisibility})

            local function RefreshAllKeybindListEntries()
                for _, Object in Library.Keybinds do
                    if Object.RefreshListVisibility then
                        Object.RefreshListVisibility()
                    elseif Object.UpdateHighlight then
                        Object:UpdateHighlight()
                    end
                end
            end

            Section:AddToggle({
                Text = "Always Show",
                Default = false,
                Flag = "Keybind Always Show",
                Callback = function()
                    RefreshAllKeybindListEntries()
                end
            })
            Section:AddToggle({
                Text = "Highlight When On",
                Default = true,
                Flag = "Keybind Highlight When On",
                Callback = function()
                    RefreshAllKeybindListEntries()
                end
            })

            local Section = Settings:AddSection({Title = "Theming", Side = 2})
                for Name,Value in Themes.Preset do 
                    Section:AddColorPicker({Text = Name:gsub("(%l)(%u)", "%1 %2"), Default = Value, Flag = Name, NoCallback = true, Callback = function(Color)
                        Library:Refresh(Name, Color)
                    end})
                end 

                -- Custom page background (images / gifs from Atlanta/Assets)
                Section:AddToggle({
                    Text = "Custom Page Background",
                    Default = false,
                    Flag = "Page Background Enabled",
                    Callback = function(Value)
                        Library:SetPageBackgroundEnabled(Value)
                    end
                })

                local AssetDropdown
                AssetDropdown = Section:AddDropdown({
                    Text = "Background Asset",
                    Flag = "Page Background Asset",
                    Values = Library:GetAssetList(),
                    Default = (Library:GetAssetList()[1]) or "(no assets — drop files in Atlanta/Assets)",
                    Callback = function(Option)
                        Library:SetPageBackgroundAsset(Option)
                    end
                })

                -- Hook RefreshDropdown so UpdateAssetList works on this dropdown
                function AssetDropdown:UpdateAssetList()
                    Library.UpdateAssetList(self)
                end

                Section:AddSlider({
                    Text = "Background Transparency",
                    Flag = "Page Background Transparency",
                    Min = 0,
                    Max = 1,
                    Default = 0.5,
                    Decimal = 0.01,
                    Callback = function(Value)
                        Library:SetPageBackgroundTransparency(Value)
                    end
                })

                Section:AddButton({
                    Text = "Refresh Assets",
                    Callback = function()
                        AssetDropdown:UpdateAssetList()
                        Library:Notify({ Text = "Assets refreshed (" .. #Library:GetAssetList() .. " files)", Lifetime = 2 })
                    end
                })
                :AddButton({
                    Text = "Open Assets Info",
                    Callback = function()
                        Library:Notify({
                            Text = "Put .png / .jpg / .gif / .webp in: " .. Library.Directory .. "/Assets",
                            Lifetime = 5
                        })
                    end
                })

                AssetDropdown:UpdateAssetList()

                local Input;
                ThemeHolder = Section:AddDropdown({Text = "Themes", Callback = function(Option) if Input then Input.Set(Option) end end})
                Input = Section:AddInput({Text = "Config Name:", Flag = "Theming_Text_Name", PlaceHolder = "Theme name here..."})
                Section:AddButton({Text = "Save", Callback = function() 
                    Library:SaveTheme(Flags["Theming_Text_Name"])
                    ThemeHolder:UpdateThemingList()
                end})
                :AddButton({Text = "Load", Callback = function()
                    if not Flags["Theming_Text_Name"] then 
                        return 
                    end 

                    if not isfile(Library.Directory .. "/Themes/" .. Flags["Theming_Text_Name"] .. ".Cfg") then 
                        return 
                    end 

                    Library:LoadConfig(readfile(Library.Directory .. "/Themes/" .. Flags["Theming_Text_Name"] .. ".Cfg"))
                    ThemeHolder:UpdateThemingList()
                end})

                Section:AddButton({Text = "Delete", Callback = function() 
                    if not Flags["Theming_Text_Name"] then 
                        return 
                    end 

                    Library:DeleteTheme(Flags["Theming_Text_Name"])
                    ThemeHolder:UpdateThemingList()
                end})
                :AddButton({Text = "Refresh", Callback = function() 
                    ThemeHolder:UpdateThemingList()
                end})

                ThemeHolder:UpdateThemingList()
            end

            pcall(function()
                Library:SetLoadingStatus("Ready")
                Library:SetLoadingProgress(1)
            end)
            -- HideLoading holds 2s on Ready, then 1s fade out, then reveals UI
            pcall(function()
                Library:HideLoading()
            end)
        end
    end 

    Library:Connect(Services.RunService.Heartbeat, function()
        if not (Library.LerpObjects) then 
            return 
        end     

        Library:LerpObjects()
        Library:LerpKeybinds()
    end)
end

-- Safety: hide loader if InitPanels was never called (e.g. custom setups)
task.delay(12, function()
    pcall(function()
        if Library and Library._Loading and Library._Loading.Visible and not Library._Loading.Hiding then
            Library:SetLoadingStatus("Ready")
            Library:SetLoadingProgress(1)
            Library:HideLoading()
        end
    end)
end)

return Library
