        -- Ensure Atlanta/CachedModels/texture_ids/<ModelName>/ exists
        Library.EnsureTextureIdsFolder = function(self, ModelName)
            self:EnsureCachedModelsFolder()
            ModelName = tostring(ModelName or ""):gsub("%.rbxmx$", ""):gsub("%.RBXMX$", "")
            if ModelName == "" then
                return nil
            end
            local base = self:GetCachedModelsFolder()
            local folder = string.format("%s/texture_ids/%s", base, ModelName)
            if not isfolder(folder) then
                pcall(makefolder, base .. "/texture_ids")
                pcall(makefolder, folder)
            end
            local folderAlt = string.format("%s\\texture_ids\\%s", base, ModelName)
            if not isfolder(folderAlt) then
