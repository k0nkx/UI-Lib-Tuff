            Library.GetConfig = function(self)
                local Config = {}

                local function isPointArray(t)
                    if type(t) ~= "table" or t.Key or t.Color or t.Transparency then
                        return false
                    end
                    local n = #t
                    if n < 1 then
                        return false
                    end
                    local sample = t[1]
                    if type(sample) ~= "table" then
                        return false
                    end
                    -- curve points look like {x, y} numeric pairs
                    local x = sample[1] or sample["1"] or sample.x or sample.X
                    local y = sample[2] or sample["2"] or sample.y or sample.Y
                    return type(x) == "number" and type(y) == "number"
                end

                local function serializePointArray(t)
                    local out = {}
                    for i = 1, #t do
                        local pt = t[i]
                        local x = tonumber(pt[1] or pt["1"] or pt.x or pt.X)
                        local y = tonumber(pt[2] or pt["2"] or pt.y or pt.Y)
                        if x ~= nil and y ~= nil then
                            out[#out + 1] = {x, y}
                        end
                    end
                    return out
                end

                for Idx, Value in Flags do
                    if type(Value) == "table" and Value.Key then
                        Config[Idx] = {Active = Value.Active, Mode = Value.Mode, Key = tostring(Value.Key)}
                    elseif type(Value) == "table" and Value["Transparency"] and Value["Color"] then
                        local okHex, hex = pcall(function()
                            return Value["Color"]:ToHex()
                        end)
                        if okHex then
                            Config[Idx] = {Transparency = Value["Transparency"], Color = hex}
                        end
                    elseif isPointArray(Value) then
                        Config[Idx] = serializePointArray(Value)
                    else
                        Config[Idx] = Value
                    end
                end 

                local ok, encoded = pcall(function()
                    return Services.HttpService:JSONEncode(Config)
                end)
                if ok and encoded then
                    return encoded
                end
                warn("[Library] GetConfig: JSONEncode failed")
                return "{}"
            end

            Library.GetConfigPath = function(self, Name)
                if not Name or Name == "" then
                    return nil
                end
                local base = string.format("%s/%s/%s", self.Directory, "Configs", Name)
                if isfile(base .. ".Cfg") then
                    return base .. ".Cfg"
                end
                if isfile(base .. ".cfg") then
                    return base .. ".cfg"
                end
                return base .. ".Cfg"
            end

            Library.LoadConfig = function(self, JSONOrName) 
                local JSON = JSONOrName

                -- Allow passing a config name instead of raw JSON
                if type(JSONOrName) == "string" and not string.find(JSONOrName, "{", 1, true) then
                    local path = self:GetConfigPath(JSONOrName)
                    if path and isfile(path) then
                        JSON = readfile(path)
                    else
                        warn("[Library] LoadConfig: config not found: " .. tostring(JSONOrName))
                        return false
                    end
                end

                local ok, Config = pcall(function()
                    return Services.HttpService:JSONDecode(JSON)
                end)
                if not ok or type(Config) ~= "table" then
                    warn("[Library] LoadConfig: invalid JSON")
                    return false
                end

                for Idx, Value in Config do  
                    local Function = ConfigFlags[Idx]

                    if type(Idx) == "string" and (string.find(Idx, "_RGB") or string.find(Idx, "_ALPHA")) then 
                        continue 
                    end 

                    if Function then 
                        if type(Value) == "table" and Value["Transparency"] and Value["Color"] then
                            pcall(Function, Color3.fromHex(Value["Color"]), Value["Transparency"])
                        else 
                            pcall(Function, Value)
                        end
                    end 
                end 
                return true
            end 

            Library.DeleteConfig = function(self, Config)
                local Path = self:GetConfigPath(Config)
                if Path and isfile(Path) then 
                    delfile(Path)
                end
            end

            Library.SaveConfig = function(self, Config)
                if Config == "" then 
                    return 
                end 

                local Path = string.format("%s/%s/%s.Cfg", Library.Directory, "Configs", Config)
                writefile(Path, self:GetConfig())
            end

            Library.AutoLoad = function(self)
                self.Window.Tweening = true 
                local Name = readfile(self.Directory.."/Autoload.txt")
                
                if Name ~= "" then 
                    local path = self:GetConfigPath(Name)
                    if path and isfile(path) then
                        local data = readfile(path)
                        for _ = 1, 2 do 
                            self:LoadConfig(data)
                        end 
                    end
                end 
                self.Window.Tweening = false 
            end 

            Library.UpdateConfigList = function(self) 
                local List = {}
                
                for _, File in listfiles(Library.Directory .. "/Configs") do
                    local Name = File:gsub(Library.Directory .. "/Configs\\", ""):gsub(".Cfg", ""):gsub(Library.Directory .. "\\Configs\\", "")
                    List[#List + 1] = Name
                end

                self:RefreshList(List)
            end 

            Library.NextFlag = function(self)
                self.FlagCount += 1
                local String = "Flag "..tostring(self.FlagCount)
                
                return String
            end 
        end

        -- // Connections / Utility Library
        do
            Library.Thread = function(self, Function)
                local Thread = coroutine.create(Function)

                coroutine.wrap(function()
                    coroutine.resume(Thread)
                end)()

                table.insert(self.Threads, Thread)

                return Thread
            end

            Library.SafeCall = function(self, Function, ...)
                local Arguments = { ... }
                local Success, Result = pcall(Function, table.unpack(Arguments))

                if not Success then
                    warn(Result)
                    return false
                end

                return Success
            end

            Library.Connect = function(self, Signal, Callback)
                local ConnectionInfo = {
                    Event = Signal,
                    Callback = Callback,
                    Connection,
                }

                Library:Thread(function()
                    ConnectionInfo.Connection = Signal:Connect(Callback)
                end)

                table.insert(self.Connections, ConnectionInfo)

                return ConnectionInfo
            end

            Library.Delay = function(self)
                task.spawn(function()
                    self.Tweening = true
                    task.wait()
                    self.Tweening = false
                end)

                return self
            end

            Library.Unload = function(self)
                pcall(function()
                    if self.HideLoading then
                        self:HideLoading(true)
                    end
                end)

                repeat task.wait() until #self.Notifications == 0

                for Index, Value in self.Connections do
                    if Value.Connection then
                        Value.Connection:Disconnect()
                    end
                end

                for Index, Value in self.Threads do
                    coroutine.close(Value)
                end

                for _, Item in self.Guis do
                    if Item then
                        Item:Destroy()
                        Item = nil
                    end
                end

                for _,Instance in self.Blurs do 
                    Instance:Destroy()
                end         

                Library = nil
                getgenv().Library = nil
            end
        end
    end

