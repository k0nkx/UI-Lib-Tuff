                Items.UIGradient = Library:Create("UIGradient",{Parent = Items.Gradient.Instance; Transparency = NumSeq{NumKey(0, 0), NumKey(0.25, 0.75), NumKey(0.5, 1), NumKey(0.75, 0.75), NumKey(1, 0)}})
                Items.UIGradient = Library:Create("UIGradient",{Rotation = 90; Parent = Items.Top.Instance; Color = ColorSeq{ColorKey(0, Color3.fromRGB(38, 38, 38)), ColorKey(1, Color3.fromRGB(25, 25, 25))}})
                Items.UIPadding = Library:Create("UIPadding",{PaddingBottom = UDim.new(0, 2); Parent = Items.Inline.Instance})
                Items.UIPadding = Library:Create("UIPadding",{PaddingBottom = UDim.new(0, 2); Parent = Items.Settings.Instance})
                local Elements = Items.Background:CreateElements({Size = UDim2.new(1, -8, 0, 0), Position = UDim2.new(0, 4, 0, 25)})

                Elements:AddToggle({Text = "Show in list", Default = Cfg.ShowInList, Flag = Cfg.Flag .. "_SHOW_IN_LIST", Callback = function()
                    RefreshListVisibility()
                end})

                Elements:AddToggle({Text = "Always Show", Default = Cfg.AlwaysShow, Flag = Cfg.Flag .. "_ALWAYS_SHOW", Callback = function(Bool)
                    Cfg.AlwaysShow = Bool
                    KeybindListElement:SetAlwaysShow(Bool)
                    RefreshListVisibility()
                end})

                Elements:AddToggle({Text = "Highlight When On", Default = Cfg.HighlightActive, Flag = Cfg.Flag .. "_HIGHLIGHT_ACTIVE", Callback = function(Bool)
                    Cfg.HighlightActive = Bool
                    KeybindListElement:SetHighlightActive(Bool)
                end})

                Elements:AddDropdown({Text = "Mode", Options = {"Hold", "Toggle", "Always"}, Default = Cfg.Mode, Flag = Cfg.Flag .. "_MODE", Callback = function(Option)
                    if Cfg.Set then 
                        Cfg.Set(Option)
                    end 
                end})

                Items.Settings:OutsideClick(Cfg, Elements.DataElements)

                -- Initial list state
                RefreshListVisibility()
            end

            Cfg.Set = function(Input)
                if type(Input) == "boolean" then
                    Cfg.Active = Input

                    if Cfg.Mode == "Always" then
                        Cfg.Active = true
                    end
                elseif tostring(Input):find("Enum") then
                    Input = Input.Name == "Escape" and "None" or Input

                    Cfg.Key = Input or "None"
                elseif table.find({ "Toggle", "Hold", "Always" }, Input) then
                    if Input == "Always" then
                        Cfg.Active = true
                    end

                    Cfg.Mode = Input
                    Keypicker:SetMode(Cfg.Mode)
                elseif type(Input) == "table" then
                    Input.Key = type(Input.Key) == "string" and Input.Key ~= "None" and Library:ConvertEnum(Input.Key) or Input.Key
                    Input.Key = Input.Key == Enum.KeyCode.Escape and "None" or Input.Key

                    Cfg.Key = Input.Key or "None"
                    Cfg.Mode = Input.Mode or "Toggle"

                    -- Always apply Active when present (including false)
                    if Input.Active ~= nil then
                        Cfg.Active = Input.Active == true
                    end

                    Keypicker:SetMode(Cfg.Mode)

                    -- Sync linked toggle checkbox visual + state when loading config
                    if LinkedToggle and LinkedToggle.Set and LinkedToggle.Enabled ~= Cfg.Active then
                        LinkedToggle.Set(Cfg.Active)
                    end
                end

                Cfg.Callback(Cfg.Active)

                local text = (tostring(Cfg.Key) ~= "Enums" and (Keys[Cfg.Key] or tostring(Cfg.Key):gsub("Enum.", "")) or nil)
                local __text = text and tostring(text):gsub("KeyCode.", ""):gsub("UserInputType.", "") or ""
                
                Items.Value.Instance.Text = "["..__text.."]"

                KeybindListElement:ChangeText(__text, Cfg.Text, Cfg.Mode)
                KeybindListElement:SetActive(Cfg.Active)
                RefreshListVisibility()

                Flags[Cfg.Flag] = {
                    Mode = Cfg.Mode,
                    Key = Cfg.Key,
                    Active = Cfg.Active
                }
            end

            Cfg.SetVisible = function(Open, Debounce)
                if Cfg.Tweening then
                    return
                end

                Cfg.Open = Open
                
                Keypicker:UpdateKeyPickerPosition(Cfg.Open, Debounce)

                if Debounce and Cfg.Open then
                    return 
                end

                Items.Settings:TweenDescendants(Cfg.Open, Cfg)
                Items.Settings:ClampToScreen()
            end

            Cfg.IsHovering = function()
                return Items.Modepicker:Hovering()
            end

            Items.Value:OnClick(function()
                Keypicker:NewKey()
            end)

            local function hasBoundKey()
                local key = Cfg.Key
                return key ~= nil and key ~= "None" and key ~= Enum.KeyCode.Unknown and tostring(key) ~= "None"
            end

            local function keyMatches(SelectedKey)
                if not hasBoundKey() then
                    return false
                end
                return SelectedKey == Cfg.Key or tostring(SelectedKey) == tostring(Cfg.Key)
            end

            -- When linked to a Toggle: key press flips/holds that toggle.
            -- If no key is bound (None / unbound), key does nothing — only the toggle button works.
            local function applyLinkedToggle(state)
                local toggle = Cfg.LinkedToggle
                if not toggle or not toggle.Set then
                    return
                end
                if type(state) == "boolean" then
                    toggle.Set(state)
                else
                    toggle.Set(not toggle.Enabled)
                end
            end

            local function setHoldActive(active)
                Cfg.Active = active == true
                if Flags[Cfg.Flag] and type(Flags[Cfg.Flag]) == "table" then
                    Flags[Cfg.Flag].Active = Cfg.Active
                end
                KeybindListElement:SetActive(Cfg.Active)
                -- Ensure the keybind list shows the entry while held (Status driven by Active)
                RefreshListVisibility()
            end

            Library:Connect(Services.UserInputService.InputBegan, function(Input, GameProcessedEvent)
                -- Still allow activation while GameProcessedEvent is true (e.g. LeftShift)
                -- so Hold mode works for modifier keys. Skip only while rebinding.
                if Cfg.Binding then
                    return
                end
                if not hasBoundKey() then
                    return
                end

                local SelectedKey = Input.UserInputType == Enum.UserInputType.Keyboard and Input.KeyCode or Input.UserInputType
                if not keyMatches(SelectedKey) then
                    return
                end

                if Cfg.LinkedToggle then
                    if Cfg.Mode == "Toggle" then
                        if GameProcessedEvent then return end
                        applyLinkedToggle()
                        setHoldActive(Cfg.LinkedToggle.Enabled)
                    elseif Cfg.Mode == "Hold" then
                        applyLinkedToggle(true)
                        setHoldActive(true)
                    elseif Cfg.Mode == "Always" then
                        applyLinkedToggle(true)
                        setHoldActive(true)
                    end
                else
                    if GameProcessedEvent and Cfg.Mode ~= "Hold" then
                        return
                    end
                    if Cfg.Mode == "Toggle" then
                        Cfg.Active = not Cfg.Active
                        Cfg.Set(Cfg.Active)
                    elseif Cfg.Mode == "Hold" then
                        Cfg.Set(true)
                        setHoldActive(true)
                    end
                end
            end)
                
            Items.Value:OnRightClick(function()
                Cfg.Open = not Cfg.Open
                Cfg.SetVisible(Cfg.Open)
            end)

            Library:Connect(Services.UserInputService.InputEnded, function(Input, GameProcessedEvent)
                -- Don't require !GameProcessedEvent on release so Hold ends reliably
                if not hasBoundKey() then
                    return
                end

                local SelectedKey = Input.UserInputType == Enum.UserInputType.Keyboard and Input.KeyCode or Input.UserInputType
                if not keyMatches(SelectedKey) then
                    return
                end

                if Cfg.Mode == "Hold" then
                    if Cfg.LinkedToggle then
                        applyLinkedToggle(false)
                        setHoldActive(false)
                    else
                        Cfg.Set(false)
                        setHoldActive(false)
                    end
                end
            end)

            Keypicker:SetupElement({ Mode = Cfg.Mode, Active = Cfg.Active, Key = Cfg.Key })
            
            Cfg.Old = Flags[Cfg.Flag]

            return Keypicker
        end

        Library.AddButton = function(self, Data)
            Data = Data or {}

            local Cfg = {
                Text = Data.Text or Data.Title or Data.Name or "Button",
                Callback = Data.Callback or function() end,
                Seperator = Data.Seperator,
                Confirmation = Data.Confirmation or false; 

                Items = {}, 

                Elements = self.Elements,
                Names = self.Names,
                DataElements = self.DataElements,
            }

            local Items = Cfg.Items; do
                Items.Object = self.Items.Object
                
                if not Items.Object then
                    Items.Object = Library:Create("TextButton",{Parent = self.Items.Elements.Instance; BackgroundTransparency = 1; Size = UDim2.new(1, 0, 0, 21); BorderSizePixel = 0; AutomaticSize = Enum.AutomaticSize.Y; BackgroundColor3 = Color3.fromRGB(255, 255, 255)})
                    Items.UIListLayout = Library:Create("UIListLayout",{FillDirection = Enum.FillDirection.Horizontal; HorizontalFlex = Enum.UIFlexAlignment.Fill; Parent = Items.Object.Instance; Padding = UDim.new(0, 4); SortOrder = Enum.SortOrder.LayoutOrder; VerticalFlex = Enum.UIFlexAlignment.Fill}) 
                end

