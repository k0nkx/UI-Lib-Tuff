-- self: the container the button gets parented to (needs self.Container)
function Library.Elements:Button(config: {})
	local Element = Library:DeepMerge({
		Text = "Text",
		Icon = "rbxassetid://0",
		Callback = print,
	}, config or {})

	local Button = Create("TextButton", {
		Parent = self.Container,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderColor3 = Color3.fromRGB(0, 0, 0),
		BorderSizePixel = 0,
		FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
		Size = UDim2.new(1, 0, 0, 16),
		Text = "",
		TextColor3 = Color3.fromRGB(0, 0, 0),
		TextSize = 14,
	}) :: TextButton

	Create("UIGradient", {
		Parent = Button,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(24, 24, 24)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(18, 18, 18)),
		}),
		Rotation = 90,
	})

	Create("UIStroke", {
		Parent = Button,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})

	Create("TextLabel", {
		Parent = Button,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
		Size = UDim2.fromScale(1, 1),
		Text = Element.Text,
		TextColor3 = Color3.fromRGB(200, 200, 200),
		TextSize = 14,
	})

	Element.Instance = Button
	Button.Activated:Connect(Element.Callback)

	return Element
end

