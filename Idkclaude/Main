	UI Library (cleaned up)
	- Same core functionality as the original, but with real names,
	  consistent structure, and no joke/troll identifiers.
	- Organized into clear sections: Core setup / Utilities / Elements / Subelements
--]]

local UserInputService = game:GetService("UserInputService")
