-- self: the container the section gets parented to (needs self.Container)
function Library.Elements:Section(config: {})
	local Element = Library:DeepMerge({
		Text = "Section",
		Container = nil, -- gets set below
	}, config or {})

	local Base = Create("Frame", {
		Parent = self.Container,
		Name = "Section",
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.fromRGB(20, 20, 20),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 6),
	}) :: Frame

	local Header = Create("Frame", {
		Parent = Base,
		Name = "Header",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = -1,
		Size = UDim2.new(1, 0, 0, 8),
	}) :: Frame

	local LeftGroup = Create("Frame", {
		Parent = Header,
		Name = "LeftGroup",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(-16, 0),
		Size = UDim2.new(0, 20, 1, 0),
	}) :: Frame

	local TitleLabel = Create("TextLabel", {
		Parent = LeftGroup,
		Name = "Title",
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
		Size = UDim2.fromScale(0, 1),
		Text = Element.Text,
		TextColor3 = Color3.fromRGB(200, 200, 200),
		TextSize = 14,
	}) :: TextLabel

	local RightGroup = Create("Frame", {
		Parent = Header,
		Name = "RightGroup",
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Color3.fromRGB(18, 18, 18),
		BorderSizePixel = 0,
		Position = UDim2.new(1, 22, 0, 0),
		Size = UDim2.fromScale(0, 1),
	}) :: Frame

	Create("UIListLayout", {
		Parent = LeftGroup,
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	Create("UIPadding", {
		Parent = TitleLabel,
		PaddingBottom = UDim.new(0, 2),
	})

	Create("UIListLayout", {
		Parent = RightGroup,
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Padding = UDim.new(0, 24),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	Create("UIListLayout", {
		Parent = Base,
		Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	-- Placeholder keeps the header height correct until a subelement is added.
	local Placeholder = Create("Frame", {
		Parent = LeftGroup,
		Name = "Placeholder",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = -1,
		Size = UDim2.fromScale(1, 1),
	}) :: Frame

	Create("UIAspectRatioConstraint", { Parent = Placeholder })

	Element.LeftContainer = LeftGroup
	Element.RightContainer = RightGroup
	Element.Instance = Base
	Element.Placeholder = Placeholder

	setmetatable(Element, Library.Subelements)
	return Element
end

----------------------------------------------------------------
-- Subelements: Toggle
----------------------------------------------------------------

-- self: a Section element (needs self.LeftContainer, self.Placeholder)
function Library.Subelements:Toggle(config: {})
	local Element = Library:DeepMerge({
		Text = "Toggle",
		Value = false,
		Callback = function() end,
	}, config or {})

	if self.Placeholder then
		self.Placeholder:Destroy()
		self.Placeholder = nil
	end

	local ToggleButton = Create("TextButton", {
		Parent = self.LeftContainer,
		Name = "ToggleButton",
		LayoutOrder = -999,
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(18, 18, 18),
		BorderSizePixel = 0,
		FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextSize = 14,
	}) :: TextButton

	Create("UIAspectRatioConstraint", { Parent = ToggleButton })
	Create("UIStroke", { Parent = ToggleButton, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })

	function Element:Set(value: boolean)
		ToggleButton.BackgroundColor3 = value and Library.Theme.Accent or Color3.fromRGB(18, 18, 18)
		self.Value = value
		self.Callback(value)
	end

	ToggleButton.Activated:Connect(function()
		Element:Set(not Element.Value)
	end)

	Element.Instance = ToggleButton
	Element:Set(Element.Value)

	setmetatable(Element, Library.Subelements)
	return Element
end

----------------------------------------------------------------
-- Subelements: Keybind
----------------------------------------------------------------

local KEYBIND_BLACKLIST = {
	"RightSuper",
	"LeftSuper",
	"BackSlash",
	"Backspace",
	"Unknown",
	"Return",
	"Escape",
}

-- Converts an Enum (KeyCode/UserInputType) into a short, readable string,
-- e.g. Enum.UserInputType.MouseButton1 -> "MB1"
local function FormatInputName(input): string
	return tostring(input)
		:gsub("Enum%.KeyCode%.", "")
		:gsub("Enum%.UserInputType%.", "")
		:gsub("ouse", "")
		:gsub("utton", "")
end

-- self: a Section element (needs self.RightContainer)
function Library.Subelements:Keybind(config: {})
	local Element = Library:DeepMerge({
		Text = "Keybind",
		Mode = "Click", -- "Click" | "Hold" | "Toggle"
		Value = nil,
		Active = false,
		Editing = false,
		Pressed = false,

		Changed = function() end,
		Callback = function() end,
	}, config or {})

	local KeybindButton = Create("TextButton", {
		Parent = self.RightContainer,
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Color3.fromRGB(18, 18, 18),
		BorderSizePixel = 0,
		FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
		Size = UDim2.fromScale(1, 1),
		Text = "",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextSize = 14,
		TextTransparency = 1,
	}) :: TextButton

	local KeybindLabel = Create("TextLabel", {
		Parent = KeybindButton,
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
		Size = UDim2.fromScale(0, 1),
		Text = "...",
		TextColor3 = Color3.fromRGB(152, 152, 152),
		TextSize = 14,
	})

	Create("UIStroke", { Parent = KeybindButton, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
	Create("UIStroke", {
		Parent = KeybindButton,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		BorderStrokePosition = Enum.BorderStrokePosition.Inner,
		Color = Color3.fromRGB(28, 28, 28),
	})
	Create("UIPadding", {
		Parent = KeybindButton,
		PaddingLeft = UDim.new(0, 5),
		PaddingRight = UDim.new(0, 5),
	})

	function Element:Set(input)
		if input == nil then
			KeybindLabel.Text = "?"
			self.Value = nil
			return
		end

		local formatted = FormatInputName(input)

		if table.find(KEYBIND_BLACKLIST, formatted) then
			KeybindLabel.Text = "?"
			self.Value = nil
			return
		end

		KeybindLabel.Text = formatted
		self.Value = formatted
	end

	KeybindButton.Activated:Connect(function()
		Element.Editing = true
		KeybindLabel.Text = "..."
	end)

	-- Runs Element.Callback repeatedly while `condition()` returns true.
	local function RunWhileHeld(condition: () -> boolean)
		while condition() do
			local ok, err = pcall(Element.Callback, Element.Value)
			if not ok then
				warn(err)
			end
			task.wait()
		end
	end

	local InputBeganConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed and not Element.Editing then
			return
		end

		if Element.Editing then
			local newInput = input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode or input.UserInputType
			Element:Set(newInput)
			Element.Editing = false
			return
		end

		local matches = FormatInputName(input.KeyCode) == Element.Value
			or FormatInputName(input.UserInputType) == Element.Value

		if not matches then
			return
		end

		if Element.Mode == "Hold" then
			Element.Pressed = true
			Element.Active = true
			RunWhileHeld(function() return Element.Pressed end)

		elseif Element.Mode == "Toggle" then
			Element.Pressed = not Element.Pressed
			Element.Active = Element.Pressed
			RunWhileHeld(function() return Element.Pressed end)

		elseif Element.Mode == "Click" then
			Element.Active = true
			local ok, err = pcall(Element.Callback, Element.Value)
			if not ok then
				warn(err)
			end
		end
	end)

	local InputEndedConnection = UserInputService.InputEnded:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end

		local matches = FormatInputName(input.KeyCode) == Element.Value
			or FormatInputName(input.UserInputType) == Element.Value

		if not matches then
			return
		end

		if Element.Mode == "Hold" then
			Element.Pressed = false
			Element.Active = false
		elseif Element.Mode == "Click" then
			Element.Active = false
		end
	end)

	Element.Instance = KeybindButton
	Element.Connections = { InputBeganConnection, InputEndedConnection }
	Element:Set(Element.Value)

	setmetatable(Element, Library.Subelements)
	return Element
end

