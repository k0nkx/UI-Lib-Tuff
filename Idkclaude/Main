	UI Library (cleaned up)
	- Same core functionality as the original, but with real names,
	  consistent structure, and no joke/troll identifiers.
	- Organized into clear sections: Core setup / Utilities / Elements / Subelements
--]]

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Client = Players.LocalPlayer
local Mouse = Client:GetMouse()

----------------------------------------------------------------
-- Core library table
----------------------------------------------------------------

local Library = {
	ScreenGui = nil,
	Theme = nil,
	Hotkey = Enum.KeyCode.Tab,

	Elements = {},     -- top-level elements (buttons, sections, etc.)
	Subelements = {},  -- elements that live inside a section (toggles, keybinds, etc.)

	Presets = {
		Default = {
			Accent = Color3.fromRGB(255, 0, 245),

			Background = Color3.fromRGB(255, 255, 255),
			Foreground = Color3.fromRGB(245, 245, 245),

			InnerLine = Color3.fromRGB(30, 30, 30),
			OuterLine = Color3.fromRGB(10, 10, 10),

			Text = Color3.fromRGB(255, 255, 255),
			SubText = Color3.fromRGB(200, 200, 200),
		},
	},
}

Library.Theme = Library.Presets.Default

Library.Elements.__index = Library.Elements
Library.Subelements.__index = Library.Subelements
Library.__index = Library

----------------------------------------------------------------
-- Utilities
----------------------------------------------------------------

-- Creates an Instance safely, applies properties + attributes.
-- Returns the instance, or false/nil on failure.
local function Create(className: string, properties: {}?, attributes: {}?): Instance | boolean
	local ok, instance = pcall(Instance.new, className)
	if not ok then
		warn(("Failed to create instance of class '%s'"):format(className))
		return false
	end

	if properties then
		for key, value in next, properties do
			local success, err = pcall(function()
				(instance :: any)[key] = value
			end)
			if not success then
				warn(("Failed to set property '%s': %s"):format(tostring(key), tostring(err)))
				return nil
			end
		end
	end

	if attributes then
		for key, value in next, attributes do
			instance:SetAttribute(key, value)
		end
	end

	return instance
end

-- Deep-merges T2 into T1 (T2 values take priority). Returns T1.
function Library:DeepMerge(target: {}, source: {}): {}
	for key, value in next, source do
		if type(value) == "table" then
			target[key] = self:DeepMerge(target[key] or {}, value)
		else
			target[key] = value
		end
	end
	return target
end

-- Disconnects RBXScriptConnections and cancels threads in a list.
function Library:CleanupTasks(tasks: {})
	for _, item in next, tasks do
		if typeof(item) == "RBXScriptConnection" then
			item:Disconnect()
		else
			pcall(task.cancel, item)
		end
	end
end

-- Adjusts the brightness (V in HSV) of a color by `amount` (-255 to 255).
function Library:AdjustBrightness(color: Color3, amount: number): Color3
	local h, s, v = color:ToHSV()
	v = math.clamp(v + (amount / 255), 0, 1)
	return Color3.fromHSV(h, s, v)
end

-- Returns true if the given InputObject came from a pointing device.
function Library:IsPointerInput(input: InputObject): boolean
	return table.find({
		Enum.UserInputType.MouseMovement,
		Enum.UserInputType.MouseButton1,
		Enum.UserInputType.Touch,
	}, input.UserInputType) ~= nil
end

