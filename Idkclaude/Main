-- self: a Section element (needs self.RightContainer)
function Library.Subelements:ColorPicker(config: {})
	local Element = Library:DeepMerge({
		Text = "Color Picker",
		Value = Color3.fromRGB(255, 255, 255),
		Alpha = 1,
		Callback = function() end,
	}, config or {})

	-- current HSV state, kept separate from Element.Value so hue/sat/val
	-- don't get lost when the color is pure red/white/black etc.
	local Hue, Sat, Val = Element.Value:ToHSV()
	local Dragging = nil -- "Map" | "Hue" | "Alpha" | nil

	local PreviewButton = Create("TextButton", {
		Parent = self.RightContainer,
		BackgroundColor3 = Element.Value,
		BorderSizePixel = 0,
		FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
		Size = UDim2.new(0, 19, 1, 0),
		Text = "",
		TextTransparency = 1,
	}) :: TextButton

	Create("UIStroke", { Parent = PreviewButton, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })

	local PickerFrame = Create("Frame", {
		Parent = Library.ScreenGui,
		Visible = false,
		Name = "ColorPickerFrame",
		BackgroundColor3 = Color3.fromRGB(13, 13, 13),
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(180, 180),
		ZIndex = 1000,
	}) :: Frame

	Create("UIStroke", { Parent = PickerFrame, BorderStrokePosition = Enum.BorderStrokePosition.Inner })
	Create("UIPadding", {
		Parent = PickerFrame,
		PaddingBottom = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 6),
	})

	-- Saturation/Value map -------------------------------------------------

	local ColorMap = Create("Frame", {
		Parent = PickerFrame,
		Name = "Map",
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(150, 150),
		ZIndex = 1000,
	}) :: Frame
	Create("UIStroke", { Parent = ColorMap, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })

	local SatMap = Create("Frame", {
		Parent = ColorMap,
		Name = "SatMap",
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1000,
	}) :: Frame
	Create("UIGradient", {
		Parent = SatMap,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
	})

	local ValMap = Create("Frame", {
		Parent = ColorMap,
		Name = "ValMap",
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1000,
	}) :: Frame
	Create("UIGradient", {
		Parent = ValMap,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0)),
		}),
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
	})

	local ColorMarker = Create("Frame", {
		Parent = ColorMap,
		Name = "MapMarker",
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(4, 4),
		ZIndex = 1001,
	}) :: Frame
	Create("UIStroke", {
		Parent = ColorMarker,
		BorderStrokePosition = Enum.BorderStrokePosition.Center,
		LineJoinMode = Enum.LineJoinMode.Miter,
		Thickness = 1.25,
	})

	-- Hue bar ---------------------------------------------------------------

	local HueBar = Create("Frame", {
		Parent = PickerFrame,
		Name = "Hue",
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(1, -155, 1, -18),
		ZIndex = 1000,
	}) :: Frame
	Create("UIStroke", { Parent = HueBar, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
	Create("UIGradient", {
		Parent = HueBar,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		}),
		Rotation = 90,
	})

	local HueMarker = Create("Frame", {
		Parent = HueBar,
		Name = "HueMarker",
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.new(1, 0, 0, 7),
		ZIndex = 1001,
	}) :: Frame
	Create("UIStroke", { Parent = HueMarker, LineJoinMode = Enum.LineJoinMode.Miter, Thickness = 2 })
	Create("UIStroke", {
		Parent = HueMarker,
		BorderStrokePosition = Enum.BorderStrokePosition.Inner,
		Color = Color3.fromRGB(255, 255, 255),
		LineJoinMode = Enum.LineJoinMode.Miter,
		Thickness = 1.9,
	})

	-- Alpha bar ---------------------------------------------------------------

	local AlphaBar = Create("Frame", {
		Parent = PickerFrame,
		Name = "Alpha",
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = Color3.fromRGB(18, 18, 18),
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, -18, 1, -155),
		ZIndex = 1000,
	}) :: Frame
	Create("UIStroke", { Parent = AlphaBar, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })

	local AlphaFill = Create("Frame", {
		Parent = AlphaBar,
		Name = "Fill",
		BackgroundColor3 = Element.Value,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 1000,
	}) :: Frame
	Create("UIGradient", {
		Parent = AlphaFill,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0),
		}),
	})

	local AlphaMarker = Create("Frame", {
		Parent = AlphaBar,
		Name = "AlphaMarker",
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 7, 1, 0),
		ZIndex = 1001,
	}) :: Frame
	Create("UIStroke", { Parent = AlphaMarker, LineJoinMode = Enum.LineJoinMode.Miter, Thickness = 2 })
	Create("UIStroke", {
		Parent = AlphaMarker,
		BorderStrokePosition = Enum.BorderStrokePosition.Inner,
		Color = Color3.fromRGB(255, 255, 255),
		LineJoinMode = Enum.LineJoinMode.Miter,
		Thickness = 1.9,
	})

	-- Copy-hex button -----------------------------------------------------

	local CopyButton = Create("TextButton", {
		Parent = PickerFrame,
		AnchorPoint = Vector2.new(1, 1),
		BackgroundColor3 = Color3.fromRGB(18, 18, 18),
		BorderSizePixel = 0,
		FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(13, 13),
		Text = "C",
		TextColor3 = Color3.fromRGB(200, 200, 200),
		TextSize = 14,
		ZIndex = 1001,
	}) :: TextButton
	Create("UIStroke", { Parent = CopyButton, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
	Create("UIPadding", { Parent = CopyButton, PaddingBottom = UDim.new(0, 1), PaddingRight = UDim.new(0, 1) })

	-- Logic -----------------------------------------------------------------

	-- Recomputes Element.Value from Hue/Sat/Val, updates visuals, fires callback.
	local function Update()
		local color = Color3.fromHSV(Hue, Sat, Val)
		Element.Value = color

		PreviewButton.BackgroundColor3 = color
		AlphaFill.BackgroundColor3 = color
		SatMap.BackgroundColor3 = Color3.fromHSV(Hue, 1, 1)

		ColorMarker.Position = UDim2.fromScale(Sat, 1 - Val)
		HueMarker.Position = UDim2.fromScale(0, Hue)
		AlphaMarker.Position = UDim2.fromScale(1 - Element.Alpha, 0)

		local ok, err = pcall(Element.Callback, color, Element.Alpha)
		if not ok then
			warn(err)
		end
	end

	-- Clamps a point to a GuiObject's bounds and returns 0-1 scale (x, y).
	local function GetRelativeScale(guiObject: GuiObject, x: number, y: number)
		local abs = guiObject.AbsolutePosition
		local size = guiObject.AbsoluteSize
		local relX = math.clamp((x - abs.X) / size.X, 0, 1)
		local relY = math.clamp((y - abs.Y) / size.Y, 0, 1)
		return relX, relY
	end

	local function HandleDrag(x: number, y: number)
		if Dragging == "Map" then
			local relX, relY = GetRelativeScale(ColorMap, x, y)
			Sat = relX
			Val = 1 - relY
			Update()
		elseif Dragging == "Hue" then
			local _, relY = GetRelativeScale(HueBar, x, y)
			Hue = relY
			Update()
		elseif Dragging == "Alpha" then
			local relX = GetRelativeScale(AlphaBar, x, y)
			Element.Alpha = 1 - relX
			Update()
		end
	end

	ColorMap.InputBegan:Connect(function(input)
		if Library:IsPointerInput(input) then
			Dragging = "Map"
			HandleDrag(input.Position.X, input.Position.Y)
		end
	end)

	HueBar.InputBegan:Connect(function(input)
		if Library:IsPointerInput(input) then
			Dragging = "Hue"
			HandleDrag(input.Position.X, input.Position.Y)
		end
	end)

	AlphaBar.InputBegan:Connect(function(input)
		if Library:IsPointerInput(input) then
			Dragging = "Alpha"
			HandleDrag(input.Position.X, input.Position.Y)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			HandleDrag(input.Position.X, input.Position.Y)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Dragging = nil
		end
	end)

	PreviewButton.Activated:Connect(function()
		PickerFrame.Visible = not PickerFrame.Visible
	end)

	CopyButton.Activated:Connect(function()
		local hex = Element.Value:ToHex()
		if setclipboard then
			pcall(setclipboard, "#" .. hex)
		end
	end)

	-- Close the picker when clicking outside it.
	local OutsideClickConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not PickerFrame.Visible then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local pos = input.Position
		local abs = PickerFrame.AbsolutePosition
		local size = PickerFrame.AbsoluteSize
		local inside = pos.X >= abs.X and pos.X <= abs.X + size.X and pos.Y >= abs.Y and pos.Y <= abs.Y + size.Y

		if not inside and pos.X < PreviewButton.AbsolutePosition.X or pos.X > PreviewButton.AbsolutePosition.X + PreviewButton.AbsoluteSize.X then
			if not inside then
				PickerFrame.Visible = false
			end
		end
	end)

	function Element:Set(color: Color3, alpha: number?)
		Hue, Sat, Val = color:ToHSV()
		if alpha then
			self.Alpha = alpha
		end
		Update()
	end

	Element.Instance = PreviewButton
	Element.PickerFrame = PickerFrame
	Element.Connections = { OutsideClickConnection }
	Update()

	setmetatable(Element, Library.Subelements)
	return Element
end

----------------------------------------------------------------

return Library
